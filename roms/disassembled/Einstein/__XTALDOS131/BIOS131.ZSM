;**********************************************************************
;*******			BIOS				*******
;*******	R H0HNE				26-JAN-87	*******
;******* DEC-2006   MINOR CORRECTIONS                           *******
;**********************************************************************
CCPC	EQU	0E300H
CCPW	EQU	0E303H
LBDOS	EQU	0EC00H		;START ADDRESS OF BDOS
DDP	EQU	0F9C0H

BIOS	EQU	0FA00H

	ORG	BIOS
BCOLD:	JP	LFA5C		;JUMP TO COLD START
BWARM:	JP	LFAC9		;JUMP TO WARM START
BCONS:	JP	LFA80		;CONSOLE STATUS
BCONI:	JP	LFA34		;CONSOLE INPUT
BCONO:	JP	LFA37		;CONSOLE OUTPUT
BLSTO:	JP	LFA3B		;PRINTER OUTPUT
BPUNO:	JP	LFA3F		;SERIAL OUTPUT
BPUNI:	JP	LFA43		;SERIAL INPUT
BHOME:	JP	LFA49		;RESET DRIVE TO 0,0,0
BSELD:	JP	LFA46		;SELECT DRIVE
BSETT:	JP	LFA50		;SET TRACK
BSETS:	JP	LFA4D		;SET SECTOR
BSETM:	JP	LFA53		;SET BUFFER
BREAD:	JP	LFA56		;READ 128-BYTE SECTOR
BWRIT:	JP	LFA59		;WRITE 128-BYTE SECTOR

LFA2D:	XOR	A
	NOP
	RET

LFA30:	INC	B
BINIT:	DEFB	MCAL,ZINIT	;INITIALISE SYSTEM
	RET

LFA34:	DEFB	MCAL,ZKEYIN	;GET KEY VALUE
	RET

LFA37:	LD	A,C
	DEFB	MCAL,ZOUTC	;SCREEN O/P 
	RET

LFA3B:	LD	A,C
	DEFB	MCAL,ZPOUT	;PRINTER O/P
	RET

LFA3F:	LD	A,C
	DEFB	MCAL,ZSLOUT	;SERIAL O/P
	RET

LFA43:	DEFB	MCAL,ZSRLIN	;SERIAL INPUT
	RET

LFA46:	DEFB	MCAL,ZSLDSC	;SELECT DRIVE
	RET

LFA49:	LD	C,00H
	DEFB	MCAL,ZSETRK	;SET TRACK
LFA4D:	DEFB	MCAL,ZSETSC	;SET SECTOR
	RET

LFA50:	DEFB	MCAL,ZSETRK	;SET TRACK
	RET

LFA53:	DEFB	MCAL,ZSETBF	;SET BUFFER
	RET

LFA56:	DEFB	MCAL,ZRD128	;READ A RECORD
	RET

LFA59:	DEFB	MCAL,ZWR128	;WRITE A RECORD
	RET

; THIS IS THE COLD BOOT (RE-) ENTRY POINT. 
; If MOS finds a disc in D0 after reset or <ctrl-BREAK> it reads in 
; a boot sector from track 0, sector0. MOS then gets DOS start and 
; end addresses from this along with default single/double side flag 
; (0 for Single). Finally the jump address is stacked and a RETURN 
; sends us to DOS cold start and thence here. 
;
; System data:  START OF DOS = 0E100H
;               END OF DOS   = 0FB00H
;		BOOT JUMP    = 0FA00H 
;
LFA5C:	LD	SP,TPA		;SET SP UNDER TPA
	LD	HL,0000H
	LD	(LFB86),HL	;CLEAR HOST ACTIVE FLAG
	DEFB	MCAL,ZLOGO	;PRINT 'EINSTEIN' LOGO
	JP	LE11E		;PRINT 'DOS' MESSAGE AND COLD BOOT

LFA6A:	LD	A,(LE108)
	CP	04H
	LD	HL,DEFDRV	;POINT TO DEFAULT DRIVE
	RET	Z
	LD	A,01H
	LD	SP,0FCFFH
	OR	A
	OUT	(DRVSEL),A
	OUT	(RAMROM),A
	JP	L00E1

LFA80:	LD	A,(PCFLGS)
	RRCA
	JR	NC,LFA8E
	LD	A,0AH
	OUT	(RG6845),A
	LD	A,60H
	OUT	(DT6845),A
LFA8E:	DEFB	MCAL,ZSCURS
	DEFB	MCAL,ZRSCAN
	RET	Z
	XOR	A
	DEC	A
	RET

LFA96:	XOR	A
	LD	HL,CCPC		;SET UP START OF CCP FOR RETURN
RCCP:	PUSH	HL
	LD	DE,0000H
	LD	HL,LFAE6
	LD	BC,0008H
	LDIR
	LD	C,A
	LD	A,(WIDTH)
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	LD	(LE306),A
	LD	HL,DDP		;SET UP POINTER FOR DPB @ F9C0H
	LD	(DBPPTR),HL
	LD	HL,RAMSEC	;SET SECTOR BUFFER = FE00H
	LD	(HSTDMA),HL
	LD	HL,0000H	;SET THE 'BREAK' VECTOR TO 0
	LD	(BRKVCT),HL
	LD	(LFB88),HL
	RET
;
; THIS IS THE WARM START RE-ENTRY POINT:
;
LFAC9:	LD	SP,TPA
	LD	HL,LE100
	LD	DE,LBDOS
	XOR	A
	LD	B,A
	LD	C,A
	DEFB	MCAL,ZRBLK	;READ A BLOCK INTO E100
	CALL	LFA6A
	LD	A,(HL)
	CP	04H		;TEST FOR 04
	JR	C,LFAE1		;LESS IS OK?
	XOR	A		;ELSE CLEAR
	LD	(HL),A		;DEFAULT TO DRV0 (ONLY 4 STATES)
LFAE1:	LD	HL,CCPW		;POINT TO WARM CCP ENTRY
	JR	RCCP		;AND JUMP TO CCP RESTART

;LOAD 0000 TO 0007
LFAE6:	JP	BWARM		;DEFB	0C3H,003H,0FAH
	DEFB	0,0
	JP	LBDOS		;DEFB	0C3H,000H,0ECH

;TABLE
LFAEE:	DEFB	028H,000H,004H,00FH
LFAF2:	DEFB	000H,05EH,000H,03FH
LFAF6:	DEFB	000H,080H,000H,010H
LFAFA:	DEFB	000H,002H,000H

;TABLE
LFAFD:	DEFB	057H,009H,00AH

