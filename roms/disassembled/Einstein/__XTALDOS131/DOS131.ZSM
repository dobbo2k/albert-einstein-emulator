;**********************************************************************
;*******			XDOS 131			*******
;*******	R H0HNE				26-JAN-87	*******
;******* DEC-2006   MINOR CORRECTIONS                           *******
;**********************************************************************
;
LFFEC	EQU	0FFECH
;
;	OTHER EQUATES
DERAS	EQU	0E5H		;VALUE OF ERASED BYTE

	ORG	0EC00H
;
;	MAJOR ENTRY POINT FOR INTERFACE
IEXENT:	JP	IEXENT1		;J ROUND ERROR POINTERS
;
;	POINTERS TO DRIVE ERROR ROUTINES
PTRBD:	DEFW	DSKBD		;BAD DATA
PTRND:	DEFW	DSKND		;NO DRIVE
PTRDL:	DEFW	DSKDL		;DRIVE LOCKED
PTRFL:	DEFW	DSKFL		;FILE LOCKED
PTRWP:	DEFW	DSKWP		;WRITE PROTECTED
PTRNS:	DEFW	DSKNS		;NO SECTOR
PTRNR:	DEFW	DSKNR		;DRIVE NOT READY
;
IEXENT1:LD	(HLSAVE),HL	;SAVE USER HL
	LD	(SPSAVE),SP	;SAVE USER STACK
	LD	SP,OWNSTK	;SWITCH TO OWN STACK
	LD	HL,IEXIT	;PT TO RETURN ADDRESS
	PUSH	HL		;SAVE AS RETURN ADDRESS
	PUSH	AF
	LD	A,C		;GET FUNCTION
	LD	(IPWORD),DE	;SAVE INPUT WORD
	LD	(IXSAVE),IX
	PUSH	AF		;SAVE FUNCTION
	LD	A,E		;SAVE BYTE PARAM
	LD	(IPBYTE),A
	LD	HL,0		;CLEAR REPLY
	LD	(IREPLY),HL
	XOR	A
	LD	(DEFFLG),A
	LD	(LF973),A
	LD	(LF976),A
	POP	AF		;GET FUNCTION
	LD	HL,XPOINT
	EX	(SP),HL
	CP	29H		;IN RANGE?
	RET	NC
	PUSH	HL		;SET UP RETURN ADDRESS
	LD	C,E
	LD	HL,FJTAB	;PT TO FUNCTION ADDRESS
	ADD	A,A
	ADD	A,L
	LD	L,A
	JR	NC,IEXENT2
	INC	H
IEXENT2:LD	A,(HL)		;GET LOW ORDER ADDRESS
	INC	HL
	LD	H,(HL)		;GET HIGH ORDER ADDRESS
	LD	L,A
	POP	AF
	PUSH	HL		;SET UP FUNCTION ADDRESS
	LD	HL,(HLSAVE)
	RET			;GO TO ROUTINE
;
;	RETURN MADE TO HERE AFTER ROUTINE
IEXIT:	LD	SP,(SPSAVE)	;RESET TO USER STACK
	RET
;
;LOOK UP TABLE FOR ITP'S
FJTAB:	DEFW	BWARM		;0- WARM BOOT
	DEFW	ICONIE		;1- CONSOLE INPUT
	DEFW	ICONOP		;2- CONSOLE OUTPUT
	DEFW	IAUXIN		;3- AUX INPUT
	DEFW	BPUNO   	;4- AUX OUTPUT
	DEFW	BLSTO		;5- PRINTER OUTPUT
	DEFW	IDIRIO		;6- DIRECT CONSOLE I/O
	DEFW	IGETIO		;7- GET I/O BYTE VALUE
	DEFW	ISETIO		;8- SET I/O BYTE VALUE
	DEFW	IPUTST		;9- OUTPUT STRING TO CONSOLE
	DEFW	IGETLI		;10-GET BUFFERED CONSOLE INPUT
	DEFW	ICONST		;11-GET CONSOLE STATUS/INPUT
	DEFW	IGVERS		;12-GET VERSION NUMBER
	DEFW	IRESET		;13-RESET DISK SYSTEM
	DEFW	ISELDS		;14-SELECT DISK
	DEFW	IOPENF		;15-OPEN FILE FOR I/O
	DEFW	ICLOSF		;16-CLOSE FILE
	DEFW	ISFIRS		;17-SEARCH FOR FIRST
	DEFW	ISNEXT		;18-SEARCH FOR NEXT
	DEFW	IDELEF		;19-DELETE FILE
	DEFW	IRDSQN		;20-READ SEQUENTIAL
	DEFW	IWRSQN		;21-WRITE SEQUENTIAL
	DEFW	IMAKEF		;22-MAKE (CREATE) FILE
	DEFW	IRENAF		;23-RENAME FILE
	DEFW	IGLONV		;24-GET LOGGED ON DISK VECTOR
	DEFW	IGCDSK		;25-GET CURRENT DISK
	DEFW	ISETDM		;26-SET DMA ADDRESS
	DEFW	IGALOV		;27-GET ALLOCATION VECTOR
	DEFW	ISETRO		;28-SET DISK READ ONLY
	DEFW	IGRODV		;29-GET READ ONLY DISK VECTOR
	DEFW	ISETAT		;30-SET FILE ATTRIBUTES
	DEFW	IGDPAD		;31-GET DISK PARAM BLOCK ADDRESS
	DEFW	IGSUSR		;32-GET/SET CURRENT USER
	DEFW	IRDRAN		;33-READ RANDOM
	DEFW	IWRRAN		;34-WRITE RANDOM
	DEFW	IFILSZ		;35-CALCULATE FILE SIZE
	DEFW	ISETRA		;36-SET RANDOM RECORD
	DEFW	IRESDS		;37-RESET DISK
	DEFW	BINIT		;38-RETURN TO MOS
	DEFW	ISETPW		;39-SET PASSWORD
	DEFW	IWRRAZ		;40-WRITE RANDOM WITH ZERO FILL
FJE:
;
;	SORT OUT DISK ERRORS
DRVERR:	DEC	A		;BAD DATA?
	LD	HL,PTRBD
	JR	Z,ERMESS
	DEC	A		;WRITE PROTECTED?
	LD	HL,PTRWP
	JR	Z,ERMESS
	DEC	A		;NO SECTOR?
	LD	HL,PTRNS
	JR	Z,ERMESS
	DEC	A		;DRIVE NOT READY?
	LD	HL,PTRNR
	JR	Z,ERMESS
ERMND:	LD	HL,PTRND
ERMESS:	LD	E,(HL)		;GET LOW ORDER ADDRESS
	INC	HL
	LD	D,(HL)		;GET HIGH ORDER ADDRESS
	EX	DE,HL
	JP	(HL)		;JUMP TO ERROR ROUTINE
;
;	DISC NOT READY ERROR MESSAGE
DSKNR:	LD	B,04H		;PT TO NOT READY ERROR
	JR	LECE0		;TRY AGAIN
;
;	DISC NO SECTOR ERROR MESSAGE
DSKNS:	LD	B,03H		;PT TO NO SECTOR ERROR
	JR	LECE0		;TRY AGAIN
;
;	DISC WRITE PROTECTED ERROR MESSAGE
DSKWP:	LD	B,02H		;PT TO WRITE PROTECT ERROR
	JR	LECE0		;TRY AGAIN
;
DSKBD:	LD	B,01H		;PT TO BAD DATA ERROR
LECE0:	CALL	LED34		;PRINT ERROR MESSAGE
	LD	HL,DOIT		;PTR TO RETRY MESSAGE
LECE6:	CALL	PUTSTR
LECE9:	CALL	GNCHAR
	CP	03H		;CONTROL-C?
	JR	Z,LECFA
	AND	5FH		;ONLY ALLOW ASCII
	CP	'N'	
	JR	Z,LECFA		;J IF NOT TO TRY AGAIN
	CP	'Y'
	JR	NZ,LECE9	;LOOP UNTIL VALID RESPONSE
LECFA:	CALL	OPCH		;ECHO RESPONSE
	CP	'Y'
	RET	Z		;RETURN IF TO TRY AGAIN
	XOR	A
	LD	(DEFDRV),A
	RST	00H
;
;	DISC DRIVE LOCKED ERROR
DSKDL:	LD	B,07H		;PT TO DRIVE LOCK ERROR
	CALL	LED34		;PRINT ERROR
	LD	HL,ABORT	;PTR TO ABORT MESSAGE
	CALL	PUTSTR
	CALL	LEDF4
	RST	00H
;
;	DISC DRIVE SELECT ERROR
DSKND:	LD	B,05H		;PT TO NO DRIVE ERROR
	CALL	LED34		;PRINT ERROR
	LD	HL,DRVNUM	;PTR TO GET NEW DRIVE MESSAGE
	CALL	PUTSTR
	CALL	LEDF4
	SUB	30H		;CONVERT TO ABSOLUTE DRIVE
	LD	(CURDRV),A	;AND SAVE
	JP	LOGOND
;
;	DISC FILE LOCKED ERROR
DSKFL:	LD	B,06H		;PT TO FILE LOCK ERROR
	CALL	LED34		;PRINT ERROR
	LD	HL,UNLCK	;PTR TO UNLOCK MESSAGE
	JR	LECE6		;TRY AGAIN
;
LED34:	PUSH	HL
	CALL	OPCRLF		;NEW LINE
	LD	A,(CURDRV)	;GET CURRENT DRIVE
	ADD	A,30H		;CONVERT DRIVE INTO RANGE 0-3
	LD	(DISK),A	;PLACE INTO MESSAGE
	LD	HL,BADDAT	;PT TO START OF DISC ERROR MESSAGES
LED43:	LD	A,(HL)		;GET PT TO START OF REQUIED MESSAGE
	INC	HL
	BIT	07,A
	JR	Z,LED43		;LOOP UNTIL TOP BIT SET
	DJNZ	LED43		;REQUIRED MESSAGE
LED4B:	RES	7,A		;RESET TOP BIT OF FIRST LETTER
	CALL	OPCH		;OUPUT BYTE
	LD	A,(HL)		;GET NEXT BYTE
	INC	HL		;BUMP PTR
	BIT	7,A		
	JR	Z,LED4B		;LOOP UNTIL END OF MESSAGE
	LD	HL,SDRIVE	;PTR TO WHICH DISC FAULT IS ON
	CALL	PUTSTR		;PRINT FAULTY DISC
	POP	HL
	RET
;
DISK	EQU	$+1
SDRIVE:	DEFB	'  : $'
BADDAT:	DEFB	80H+'B','ad Data'		;B=1
WPERR:	DEFB	80H+'W','rite Protect'		;B=2
SECERR:	DEFB	80H+'N','o Sector'		;B=3
RDYERR:	DEFB	80H+'N','ot Ready'		;B=4
SELERR:	DEFB	80H+'N','o Drive'		;B=5
FLCKER:	DEFB	80H+'F','ile Lock'		;B=6
DLCKER:	DEFB	80H+'D','rive Lock'		;B=7
	DEFB	80H
;
DOIT:	DEFB	CR,LF,'Try Again(Y/N)?$'
UNLCK:	DEFB	CR,LF,'Unlock(Y/N)?$'
DRVNUM:	DEFB	CR,LF,'No.(0-3)?$'
ABORT:	DEFB	CR,LF,'Press key to abort:$'
;
;	GET NEXT CHAR FROM CONSOLE
GNCHAR:	LD	HL,CHSAVE	;PT TO PREVIOUS CHAR IF ANY
	LD	A,(HL)		;GET IT
	LD	(HL),00H	;CLEAR PREV
	OR	A		;ANY PREVIOUS CHAR
	RET	NZ		;RET IF THERE WAS
	JP	BCONI		;ELSE GET THE NEXT ONE
;
;	GET CHAR AND ECHO ON CONSOLE
LEDF4:	CALL	GNCHAR		;GET A CHAR
	CALL	CMPCHC		;TEST IF KNOWN CONTROL CHAR
	RET	C		;RETURN IF UNKNOWN
	PUSH	AF		;SAVE CHAR
	CALL	CONOP1		;OUTPUT IT
	POP	AF		;RESTORE
	RET			;AND EXIT
;
;	TEST IF KNOWN CONTROL CHARACTER
CMPCHC:	CP	0DH
	RET	Z
	CP	0AH
	RET	Z
	CP	09H
	RET	Z
	CP	08H
	RET	Z
	CP	20H
	RET
;
;	TEST IF CONSOLE READY
TCIRDY:	LD	A,(CHSAVE)	;GET SAVED CHAR IF ANY
	OR	A		;TEST IT
	JR	NZ,CIRDY	;J IF ONE SAVED
	CALL	BCONS		;TEST STATUS OF CONSOLE
	AND	01H		;ONE THERE?
	RET	Z		;RET IF NOT
	CALL	BCONI		;GET THE CHAR
	CP	13H		;IS IT CTRL/S?
	JR	NZ,SAVNXC	;J IF NOT TO SAVE IT
	CALL	BCONI		;WAIT FOR NEXT CHAR
	CP	03H		;ABORT?
	JP	Z,REBOOT	;J IF SO
	XOR	A		;PRETEND NONE THERE
	RET			;AND EXIT
;
SAVNXC:	LD	(CHSAVE),A	;SAVE THE CHAR FOR LATER
CIRDY:	LD	A,01H		;SET READY REPLY
	RET			;AND EXIT
;
;	OUTPUT CR/LF TO CONSOLE
OPCRLF:	LD	A,CR
	CALL	PUTCH
	LD	A,LF
;
;	PUT CHAR ON CONSOLE
PUTCH:	LD	C,A
	LD	A,(FLDEOP)	;DIRECT O/P
	OR	A
	LD	A,C
	JR	NZ,UPLPOS	;J IF NOT SO
	PUSH	AF
	PUSH	BC		;SAVE CURRENT BC
	CALL	TCIRDY		;TEST IF ANY KEY PRESSED
	POP	BC		;RESTORE
	POP	AF
	CALL	BCONO		;OUTPUT IT
;
;	WORK OUT POSITION OF CURSOR
UPLPOS:	LD	HL,LCUPOS	;PT TO CURRENT POSITION
	CP	7FH		;RUB?
	RET	Z		;OUT IF SO
	INC	(HL)		;UP BY ONE CHAR
	CP	20H		;CONTROL CHAR?
	RET	NC		;RET IF NOT
	DEC	(HL)		;BACK OFF POS
	RET	Z		;RET IF START OF LINE
	CP	08H		;BACKSPACE?
	JR	NZ,TIFLF	;J IF NOT
	DEC	(HL)		;BACK OFF 1
	RET			;AND EXIT 
;
TIFLF:	CP	0AH		;LINE FEED?
	RET	NZ		;RET IF NOT
	LD	(HL),00H	;RESET TO START OF LINE
	RET			;AND EXIT
;
;	OUTPUT CHAR ALLOWING FOR TABS
OPCH:	PUSH	BC
	PUSH	HL
	CALL	CMPCHC		;TEST IF A CONTROL
	JR	NC,CONOP	;J IF NOT TO O/P IT
	PUSH	AF		;SAVE IT
	LD	A,5EH		;GET AN ARROW
	CALL	PUTCH		;AND OUTPUT IT
	POP	AF		;RESTORE CHAR
	OR	40H		;MAKE LETTER
CONOP:	CALL	CONOP1		;OUTPUT CHAR
	POP	HL
	POP	BC
	RET
;
;	OUTPUT CHAR TO CONSOLE
ICONOP:	LD	A,(PCFLGS)	;NEED TO CHANGE CURSOR POSITION?
	BIT	3,A
	JR	NZ,JPBCONO
	LD	A,C
	NOP
CONOP1:	CP	09H		;TAB?
	JR	NZ,PUTCH	;J IF NOT
TABOP:	LD	A,20H		;LD	A,' '		;GET A SPACE
	CALL	PUTCH		;AND O/P IT
	LD	A,(LCUPOS)	;GET CURRENT POSITION
	AND	07H		;TEST LS 3 BITS
	JR	NZ,TABOP	;CONTINUE UNTIL ZERO
	RET
;
;	REMOVE PREV CHAR BY BACKSPACING
BSSPBS:	CALL	OPBSP		;OUTPUT BACKSPACE
	LD	C,' '		;FOLLOWED BY SPACE
	CALL	BCONO
OPBSP:	LD	C,08H		;AND ANOTHER BACKSPACE
JPBCONO:JP	BCONO
;
;	CANCEL INPUT
KILLIN:	LD	A,23H		;LD	A,'#'		;PUT OUT # TO INDICATE CANCEL
	CALL	PUTCH
	CALL	OPCRLF		;GOTO NEW LINE

;
;	REPOSITION CURSOR AT START OF OLD LINE
POSCUR:	LD	A,(LCUPOS)	;GET CURRENT POSITION
	LD	HL,LSTPOS	;PTR TO LAST POSITION
	CP	(HL)		;MATCH?
	RET	NC		;EXIT IF BEYOND START
	LD	A,20H		;LD	A,' '		;SPACEFILL UP TO POS
	CALL	PUTCH
	JR	POSCUR
;
;	TYPE STRING TERMINATED WITH '$'
IPUTST:	EX	DE,HL		;GET PTR
;
;	OUTPUT STRING TERMINATED BY '$'
PUTSTR:	LD	A,(HL)		;GET CHAR
	CP	24H		;END?
	RET	Z		;EXIT IF SO
	INC	HL		;INC PTR
	CALL	OPCH		;OUTPUT CHAR TO CONSOLE
	JR	PUTSTR		;AND REPEAT
;
;	GET BUFFER LINE FROM CONSOLE WITH EDITING
IGETLI:	LD	A,(LCUPOS)	;GET CURRENT LINE POSITION
	LD	(LSTPOS),A	;AND SAVE AS PART OF POS
	LD	HL,(IPWORD)	;GET PARAM (PTR TO BUFFER AREA)
	LD	C,(HL)		;GET MAX LENGTH
	INC	HL		;PT TO REPLY LENGTH
	PUSH	HL		;SAVE PTR
	LD	B,00H		;START AT ZERO CHARS
GLIREP:	PUSH	BC		;SAVE CURRET/MAX LENGTHS
	PUSH	HL		;AND LINE PTR
GLICH:	CALL	GNCHAR		;GET A CHAR FROM CONSOLE
	POP	HL		;RESTORE PTR
	POP	BC		;AND LENGTHS
	CP	0DH		;IS IT A RETURN?
	JP	Z,GLIFIN	;FINISH IF SO
	CP	0AH		;IS IT A LINE FEED?
	JP	Z,GLIFIN	;SAME..FINISH IF SO
	CP	08H		;IS IT A BACKSPACE?
	JR	NZ,TRYRUB	;J IF NOT
LEEE6:	LD	A,B		;GET CURRENT LENGTH
	OR	A		;TEST IT
	JR	Z,GLIREP	;IGNORE IF ZERO LENGTH
	DEC	B		;BACK OFF ONE CHAR
	LD	A,(LCUPOS)	;GET CURRENT POSITION
	LD	(FLDEOP),A	;MARK NO PRINTER ECHO/STOP TEST
	PUSH	BC		;SAVE LENGTHS
	CALL	KILLIN		;KILL CURRENT LINE
	POP	BC		;RESTORE
	POP	HL		;BACK TO ORIG PTR
	PUSH	HL		;SAVE AGAIN
	PUSH	BC		;AND SAVE LENGTHS
PUTLIC:	LD	A,B		;GET CURRENT LENGTH
	OR	A		;TEST IT
	JR	Z,GLIBAK	;J IF EMPTY
	INC	HL		;PT TO CAR
	LD	A,(HL)		;GET OT
	DEC	B		;ONE LESS CHAR TO GO
	CALL	OPCH		;RE-OUTPUT CHAR
	JR	PUTLIC		;AND REPEAT
;
GLIBAK:	PUSH	HL		;SAVE PTR
	LD	A,(FLDEOP)	;GET FLAG
	OR	A		;TEST IT
LEF0A:	JR	Z,GLICH		;J IF ZERO
	LD	HL,LCUPOS	;PT TO CURRENT POS
	SUB	(HL)
	LD	(FLDEOP),A	;PUT BACK
GLIBSB:	CALL	BSSPBS		;REMOVE PREVIOUS CHAR
	LD	HL,FLDEOP
	DEC	(HL)		;BACK OFF ONE
	JR	NZ,GLIBSB	;REPEAT UNTIL DONE
	JR	LEF0A		;THEN CONTINUE
;
TRYRUB:	CP	19H		;IS IT DEL
	JR	Z,LEEE6
	CP	18H		;IS IT CTRL/X
	JR	NZ,TRYU		;J IF NOT
	POP	HL		;RESTORE PTR
CLRLIN:	LD	A,(LSTPOS)	;GET THE START POSITION
	LD	HL,LCUPOS
	CP	(HL)		;SAME?
	JR	NC,IGETLI	;J IF BEFORE START
	DEC	(HL)		;BACK OFF CURRENT
	CALL	BSSPBS		;STEP BACK CONSOLE TO CLEAR
	JR	CLRLIN		;AND REPEAT
;
TRYU:	CP	11H		;IS IT CTRL/O
	JR	C,GLISTO
	CP	15H		;IS IT CTRL/U
	JR	NC,GLISTO
	PUSH	HL
	PUSH	BC
	CALL	CONOP1
	POP	BC
	POP	HL
	JP	GLIREP
;
GLISTO:	INC	HL		;PT TO NEXT BUFFER POS
	LD	(HL),A		;SAVE THE POS
	INC	B		;UP CURRENT LENGTH
	PUSH	AF
	CALL	OPCH
	POP	AF
	CP	03H		;WAS IT CTRL/C (ABORT)
	LD	A,B		;GET LENGTH
	JR	NZ,GLINAB	;J IF NOT ABORT
	CP	01H		;IS IT THE ONLY CHAR?
	JP	Z,REBOOT	;REBOOT IF SO
GLINAB:	CP	C		;TEST MAX LENGTH
	JP	C,GLIREP	;J IF NOT EXCEEDED
GLIFIN:	POP	HL		;RESTORE I/P PTR
	LD	(HL),B		;SAVE ACTUAL LENGTH
	LD	A,0DH		;INDICATE ACCEPTED
	JP	PUTCH		;AND EXIT
;
;	CONSOLE INPUT WITH ECHO
ICONIE:	CALL	LEDF4		;GET AND ECHO CHAR
	JR	IREPEX		;AND EXIT
;
IAUXIN:	CALL	LBIOS+15H	;BAUXI		;GET RS232 I/P
	JR	IREPEX		;AND EXIT
;
;	DIRECT CONSOLE I/O
IDIRIO:	LD	A,C		;GET THE PARAMETER
	CP	0FFH		;TEST IT
	JR	Z,ICONIQ	;J IF TO I/P
	CP	0FEH		;TEST AGAIN
	JP	NZ,BCONO	;O/P CHAR IF REQUIRED
	JP	BCONS		;ELSE GET STATUS
;
ICONIQ:	CALL	BCONS		;TEST CONSOLE STATUS
	OR	A
	JP	Z,NDSKOP	;J IF NOT READY
	CALL	BCONI		;GET THE CHAR
	JR	IREPEX		;AND REPLY WITH IT
;
;	GET IOBYTE CONTENTS
IGETIO:	LD	A,(IOBYTE)
	JR	IREPEX
;
;	SET IOBYTE CONTENTS
ISETIO:	LD	HL,IOBYTE
	LD	(HL),C
	RET
;
ICONST:	CALL	TCIRDY		;TEST IF CONSOLE READY
	JR	IREPEX		;AND REPLY WITH IT
;
;	GET VERSION NUMBER
IGVERS:	LD	A,20H		;SET TO 2.0
IREPEX:	LD	(IREPLY),A	;SAVE REPLY
	RET			;AND EXIT
;
;	SET PASWORD
ISETPW:	LD	HL,(IPWORD)
	LD	A,(HL)
	OR	A
	JR	Z,PSW3
	PUSH	HL
	LD	B,08H
PSW1:	LD	A,(HL)
	CP	21H
	INC	HL
	JR	C,PSW4
	DJNZ	PSW1
	POP	HL
	LD	DE,PSWORD
	PUSH	DE
	LD	C,08H
	LDIR
	POP	HL
PSW2:	CALL	PSW5
	DEC	C
	JR	NZ,PSW2
	LD	A,01H
PSW3:	LD	(LF93D),A
	XOR	A
	JR	IREPEX
;
PSW4:	POP	HL
	LD	A,0FFH
	JR	IREPEX
;
PSW5:	PUSH	HL
	PUSH	BC
	LD	B,08H
	OR	A
PSW6:	RR	(HL)
	INC	HL
	DJNZ	PSW6
	POP	BC
	DEC	HL
	LD	A,(HL)
	RRA
	RRA
	XOR	(HL)
	RRCA
	AND	80H
	POP	HL
	OR	(HL)
	LD	(HL),A
	RET
;
;	SELECT DISK FOR NEXT OPERATION
SELECD:	LD	A,(CURDRV)	;GET DRIVE
	LD	C,A
	CALL	BSELD		;SELECT VIA BIOS
	LD	A,H		;TEST REPLY (DPE ADDRES)
	OR	L
	RET	Z		;BAD SELECT IF ZERO REPLY
	LD	E,(HL)		;GET XLTAD
	INC	HL
	LD	D,(HL)
	LD	(XLTAD),DE	;SAVE IT
	INC	HL
	LD	(NOOADB),HL
	INC	HL
	INC	HL
	LD	(LF94E),HL
	INC	HL
	INC	HL
	LD	(LF950),HL
	INC	HL
	INC	HL
	LD	DE,DIRBUF
	LD	BC,0008H
	LDIR
	LD	HL,(DPBAD)	;GET PTR TO DISK PARAM BLOCK
	LD	C,0FH
	LDIR
	LD	A,0FFH		;MARK SELECT OK
	OR	A
	RET			;AND EXIT
;
LF017:	XOR	A
	LD	HL,(LF94E)
	LD	(HL),A
	INC	HL
	LD	(HL),A
	LD	HL,(LF950)
	LD	(HL),A
	INC	HL
	LD	(HL),A
	INC	A
	LD	(LF96D),A
;
;	RESTART DIRECTORY ENTRY NUMBER
STRTDI:	LD	HL,-1		;STARTS AT -1 DUE TO PRE-INCREMENT
	LD	(DIRENO),HL	;SAVE
	RET
;
;	GET THE NEXT DIRECTORY ENTRY IN THE BUFFER
NXTDIE:	LD	HL,(DIRENO)	;GET CURRENT ENTRY NUMBER
	INC	HL		;UP TO NEXT
	LD	(DIRENO),HL
	EX	DE,HL
	LD	HL,(DPDIR)	;No OF DIRECTORY ENTRIES
	OR	A
	SBC	HL,DE
	JR	NC,NXTDIE1
	CALL	STRTDI
	JR	TSTEDI
;
NXTDIE1:LD	A,(DIRENO)	;GET CURRENT ENTRY No
	AND	03H		;IS IT FIRST IN RECORD
	RRCA
	RRCA
	RRCA
	LD	(DIROFF),A	;SAVE OFFSET
	JR	NZ,TSTEDI	;IS IT FIRST ONE IN BUFFER
	PUSH	BC		;SAVE TYPE
	CALL	CVENTIN		;SET UP PARAM FOR READ
	CALL	SETM
	LD	A,(LF96D)
	LD	C,A
	CALL	RDSECT		;READ THE RECORD
	XOR	A
	LD	(LF96D),A
	CALL	RESDMA
	POP	BC
	CALL	SUMDIR
;
;	TEST IF END DIRECTORY REACHED
TSTEDI:	LD	HL,DIRENO
	LD	A,(HL)
	INC	HL
	CP	(HL)
	RET	NZ		;RETURN IF NOT END
	INC	A		;SET ZERO IF END
	RET
;
LF073:	CALL	LF0CF
	CALL	LF07C
	CALL	WRSECT
LF07C:	PUSH	AF
	LD	A,(LF93D)
	OR	A
	JR	Z,LF0A0
	LD	DE,LF93E
	PUSH	DE
	LD	HL,PSWORD
	LD	BC,0008H
	LDIR
	LD	DE,(USRDMA)
	POP	HL
	LD	B,80H
LF096:	CALL	PSW5
	EX	DE,HL
	XOR	(HL)
	EX	DE,HL
	LD	(DE),A
	INC	DE
	DJNZ	LF096
LF0A0:	POP	AF
	RET
;
;	READ A SECTOR
LF0A2:	LD	C,00H
RDSECT:	CALL	BREAD		;DO THE READ USING PARAMS SET UP ALREADY
	OR	A
	RET	Z		;EXIT IF SO
	CALL	DRVERR
	JR	Z,LF0A2
	RET
;
;	WRITE A SECTOR
WRSECT:	PUSH	BC
	CALL	BWRIT		;DO THE WRITE
	POP	BC
	OR	A		;WRITE OK?
	RET	Z		;EXIT IF SO
	PUSH	BC
	CALL	DRVERR
	POP	BC
	JR	Z,WRSECT
	RET
;
;	CONVERT DIRECTORY ENTRY No TO TRK/SECT
CVENTIN:LD	HL,(DIRENO)	;GET CURRENT ENTRY NUMBER
	SRL	H
	RR	L
	SRL	H
	RR	L
	LD	(REQSEC),HL	;SAVE AS REQUIRED INTERNAL SECTOR
	LD	(DIRSEC),HL	;AND LAST DIRECTORY ENTRY
LF0CF:	PUSH	BC
	LD	HL,REQSEC
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	LD	HL,(LF950)
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	HL,(LF94E)
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
LF0E3:	LD	A,C
	SUB	E
	LD	A,B
	SBC	D
	JR	NC,LF0F6
	PUSH	HL
	LD	HL,(DPSEC)
	EX	DE,HL
	OR	A
	SBC	HL,DE
	EX	DE,HL
	POP	HL
	DEC	HL
	JR	LF0E3
;
LF0F6:	PUSH	HL
	LD	HL,(DPSEC)
	ADD	HL,DE
	JR	C,LF108
	LD	A,C
	SUB	L
	LD	A,B
	SBC	H
	JR	C,LF108
	EX	DE,HL
	POP	HL
	INC	HL
	JR	LF0F6
;
LF108:	POP	HL
	PUSH	BC
	PUSH	DE
	PUSH	HL
	EX	DE,HL
	LD	HL,(DPSYS)	;FORM TRACK No
	ADD	HL,DE
	LD	(REQTRK),HL
	LD	B,H
	LD	C,L
	CALL	BSETT		;SELECT TRACK
	POP	DE
	LD	HL,(LF94E)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	POP	DE
	LD	HL,(LF950)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	POP	HL
	OR	A
	SBC	HL,DE
	LD	(LF92D),HL
	LD	B,H
	LD	C,L
	LD	DE,(XLTAD)	;PTR TO TRANSLATE TABLE
	LD	A,D
	OR	E
	JR	Z,LF13A		;J IF NONE
	ADD	HL,DE
	LD	C,(HL)		;GET MODIFIED SECTOR
LF13A:	CALL	BSETS		;SET SECTOR
	POP	BC
	RET			;AND EXIT
;
;	CALCULATE OFFSET IN FCB OF REQD RECORD
CVRTOS:	LD	HL,DPBSH
	LD	C,(HL)		;GET SHIFT FACTOR
	LD	A,(CURCR)	;GET CURRENT RECORD NUMBER
SRREC:	OR	A
	RRA
	DEC	C
	JR	NZ,SRREC
	LD	B,A		;SAVE IN B
	LD	A,08H		;CALC 8 - SHIFT FACTOR
	SUB	(HL)
	LD	C,A		;TO C
	LD	A,(CUREXT)	;GET THE CURRENT EXTENT
LF153:	DEC	C
	JR	Z,LF15A
	OR	A
	RLA
	JR	LF153
;
LF15A:	ADD	A,B
	LD	B,00H
	LD	C,A
	RET			;AND EXIT
;
;	EXTRACT THE REQUIRED BLOCK No FROM THE FCB
GETBLK:	LD	HL,FCBBLK	;PT TO FCB
	ADD	HL,BC		;ADD OFFSET IN AREA
	ADD	HL,BC
	LD	E,(HL)		;GET BLOCK No
	INC	HL
	LD	D,(HL)
	EX	DE,HL		;IN HL
	RET			;AND RETURN
;
;	GET THE CURRENT BLOCK No FROM THE FCB
GCURBL:	CALL	CVRTOS		;CONVERT RECORD NUM TO OFFSET
	CALL	GETBLK		;GET BLOCK No FROM FCB
	LD	(REQSEC),HL	;SAVE AS REQUIRED BLOCK
	LD	A,H
	OR	L		;SET Z IF UNALLOCATED
	RET			;AND EXIT
;
;	CONVERT BLOCK No TO INTERNAL SECTOR No
CALCSN:	LD	A,(DPBSH)	;GET THE SHIFT FACTOR
	LD	HL,(REQSEC)	;GET THE REQUIRED BLOCK
MKISEC:	ADD	HL,HL		;SHIFT LEFT
	DEC	A
	JR	NZ,MKISEC	;ADJUSTED?
	LD	(BLSEC),HL	;SAVE INTERNAL SECTOR No
	LD	A,(DPMSK)
	LD	C,A
	LD	A,(CURCR)	;GET CURRENT RECORD No
	AND	C		;MASK FOR OFFSET
	OR	L		;PUT IN ADJUSTED VALUE
	LD	L,A
	LD	(REQSEC),HL	;AND SAVE INT SECTOR No REQD
	RET
;
LF190:	LD	HL,FCBEXT
	LD	A,(DPEXM)
	AND	(HL)
	LD	(CUREXT),A
	LD	A,(FCBRC)
	LD	(CURRC),A
	LD	A,(FCBCR)
	LD	(CURCR),A
	RET
;
LF1A7:	LD	A,(FLAGS2)
	CP	02H
	JR	NZ,LF1AF
	XOR	A
LF1AF:	LD	C,A
	LD	A,(CURCR)
	ADD	A,C
	LD	(FCBCR),A
	LD	A,(CURRC)
	LD	(FCBRC),A
	RET
;
;	SHIFT HL RIGHT(A) TIMES
HLSRB:	LD	A,(CURDRV)
	INC	A
HLSR:	DEC	A
	RET	Z
	SRL	H
	RR	L
	JR	HLSR
;
;	SET BIT (CURRENT DISK) IN A VECTOR
SVECTA:	LD	BC,0001H	;BIT 0 SET TO START
	LD	A,(CURDRV)	;GET CURRENT DRIVE No
	INC	A
SVECT1:	DEC	A
	RET	Z
	SLA	C
	RL	B
	JR	SVECT1
;
;	TEST IF CURRENT DRIVE IS READ-ONLY
TSTROV:	LD	HL,(ROVEC)	;GET THE CURRENT READ ONLY VECTOR
	CALL	HLSRB		;GET BIT 0
	LD	A,L
	AND	01H
	RET			;AND EXIT
;
;	SET DISK READ ONLY
ISETRO:	LD	HL,ROVEC	;ALLOCATION VECTOR
	CALL	SVECTB		;SET THE VECTOR BIT
	LD	HL,(DPDIR)	;SET No OF ENTIES IN DIR
	INC	HL		;TO MAXIMUM VALUE
	EX	DE,HL
	LD	HL,(NOOADB)	;SAVE IN STORAGE AREA
	LD	(HL),E
	INC	HL
	LD	(HL),D
	RET
;
;	TEST IF FILE IS READ ONLY
TSTROB:	LD	DE,FTYP		;OFFSET OF R/O ATTRIBUTE
	ADD	HL,DE		;PT TO IT IN ENTRY
	BIT	7,(HL)		;TEST IF B7 SET
	RET	Z		;RETURN IF NOT SET
	PUSH	HL
	LD	HL,PTRFL
	CALL	ERMESS
	POP	HL
	JP	NZ,REBOOT
	RES	7,(HL)
	RET
;
;	RESET DISC
DOC1:	CALL	TSTROV
	RET	Z
	CALL	SVECTA
	LD	H,B
	LD	L,C
	CALL	RESDSK
	JP	LOGOND
;
;	TEST IF DRIVE IS READ ONLY
CHKWOK:	CALL	TSTROV		;TEST R/O VECTOR
	RET	Z		;RETURN IF NOT R/O
	LD	HL,PTRDL
	CALL	ERMESS
	JP	REBOOT
;
;	CALCULATE ADDRESS OF CURRENT DIRECTORY ENTRY
PTOENT:	LD	HL,(DIRBUF)	;PT TO DIRECTORY BUFFER
	LD	A,(DIROFF)	;GET OFFSET OF ENTRY
	ADD	A,L		;ADD A TO HL SINGLE LENGTH
	LD	L,A
	RET	NC		;RETURN IF NO CARRY TO H
	INC	H		;UP H
	RET
;
LF231:	XOR	A
	LD	(FCBS2),A
	RET
;
;	TEST IF DIRECTORY ENTRY OUTSIDE No OF ENTRIES ON DISK
TENTNO:	LD	DE,(DIRENO)
	LD	HL,(NOOADB)
	LD	A,E
	SUB	(HL)
	INC	HL
	LD	A,D
	SBC	(HL)
	RET
;
;	INCREASE IF NECESSARY MAXIMUM No OF ENTRIES ON DISK
UPMAXE:	CALL	TENTNO
	RET	C
	INC	DE
	LD	(HL),D
	DEC	HL
	LD	(HL),E
	RET
;
;	CALCULATE NEW SUM FOR DIRECTORY RECORD
NEWSUM:	LD	C,0FFH		;SET UPDATING FLAG
SUMDIR:	LD	HL,(DIRSEC)	;GET SECTOR No OF DIRECTORY
	LD	DE,(DPCHK)
	OR	A
	SBC	HL,DE
	RET	NC
	PUSH	BC
	LD	B,128
	LD	HL,(DIRBUF)
	XOR	A
SUMD1:	ADD	A,(HL)
	INC	HL
	DJNZ	SUMD1
	LD	DE,(CSVAD)	;PT TO CHECK SUM VECTOR
	LD	HL,(DIRSEC)	;ADD SECTOR No
	ADD	HL,DE
	POP	BC
	INC	C		;TEST IF UPDATING
	JR	Z,SETSUM		;J IF WE ARE
	CP	(HL)		;IS SUM SAME
	RET	Z
	CALL	TENTNO
	RET	NC
	JP	ISETRO
;
SETSUM:	LD	(HL),A		;SAVE NEW SUM IN VECTOR
	RET
;
;	RESET ALL OF ENTRY AND WRITE OUT
WRDIRE:	LD	C,00H		;START OFFSET
	LD	E,20H		;AND LENGTH
UPDENT:	PUSH	DE		;SAVE LENGTH
	LD	B,00H		;FROM START POSITION
	LD	HL,FCB		;IN FCB
	ADD	HL,BC
	EX	DE,HL		;TO DE
	CALL	PTOENT		;PT TO ENTRY
	POP	BC		;RESTORE LENGTH
	LD	B,00H		;SET MAX OF 256
	EX	DE,HL
	LDIR
WRDIBL:	CALL	CVENTIN		;SET UP FOR WRITE
;
;	WRITE DIRECTORY REORD AWAY
WRTDIR:	CALL	NEWSUM
	CALL	SETM
	LD	C,01H		;SET DIRECTORY WRITE
	CALL	WRSECT		;AND WRITE IT AWAY
	JR	RESDMA
;
;	SET DMA ADDESS
ISETDM:	LD	(USRDMA),DE
RESDMA:	LD	BC,(USRDMA)
	JR	JPSETM
;
SETM:	LD	BC,(DIRBUF)
JPSETM:	JP	BSETM
;
;	GET THE ALLOCATION VECTOR BIT FOR BLOCK <BC>
GALBIT:	LD	A,C
	AND	07H
	INC	A
	LD	E,A
	LD	D,A
	SRL	B
	RR	C
	SRL	B
	RR	C
	SRL	B
	RR	C
	LD	HL,(ALVAD)
	ADD	HL,BC
	LD	A,(HL)		;GET BYTE
SLALBY:	RLCA			;PUT SHIFT INTO POSITION
	DEC	E
	JR	NZ,SLALBY
	RET
;
;	SET/RESET ALLOCATION BIT FROM B0 OF E
CALBIT:	PUSH	DE		;SAVE SET/RESET
	CALL	GALBIT		;GET THE BIT
	AND	0FEH		;SET TO ZERO
	POP	BC		;RESTORE SET/RESET
	OR	C		;OR IN NEW BIT
SRALBY:	RRCA			;PUT BACK INTO POSITION
	DEC	D
	JR	NZ,SRALBY
	LD	(HL),A		;AND SET NEW BYTE
	RET
;
;	SET ALLOCATION BITS FOR A DIRECTORY ENTRY
SENTAL:	CALL	PTOENT		;POINT TO ENTRY
	LD	DE,0010H	;PT TO BLOCKS AREA
	ADD	HL,DE
	PUSH	BC
	LD	C,11H		;NO OF BLOCKS TO DO +1
NXEALB:	POP	DE
	DEC	C
	RET	Z		;RETURN IF FINISHED
	PUSH	DE
	DEC	C
	PUSH	BC
	LD	C,(HL)		;GET THE BLOCK NUMBER
	INC	HL
	LD	B,(HL)
	PUSH	HL
	LD	A,C		;IS IT UNALLOCATED
	OR	B
	JR	Z,FALBN		;J IF SO
	LD	HL,(DPSIZ)	;TEST IF BLOCK IN SIZE
	SBC	HL,BC
	CALL	NC,CALBIT	;SET BIT IF IN RANGE
FALBN:	POP	HL		;SET TO NEXT BLOCK
	INC	HL
	POP	BC
	JR	NXEALB
;
;	RESET DISC SYSTEM
IRESET:	XOR	A		;CLEAR
	LD	(CURDRV),A	;CURRENT DRIVE
	LD	H,A
	LD	L,A
	LD	(ROVEC),HL	;READ ONLY VECTOR
	LD	(LOVEC),HL	;AND LOGGED ON VECTOR
	LD	DE,TBUFF	;RESET DMA ADDRESS
	CALL	ISETDM
	JR	LOGOND
;
;	select disc
SELDS:	LD	A,(IPBYTE)	;GET THE DRIVE REQUIRED
	LD	HL,CURDRV
	CP	(HL)		;IS IT THE SAME AS CURRENT DRIVE
	RET	Z		;RETURN IF SO
;
;	SELECT DISC
ISELDS:	LD	A,(IPBYTE)	;GET THE DRIVE REQUIRED
	LD	(CURDRV),A	;SET NEW DRIVE
;
;	LOG ON A DISC IF REQUIRED
LOGOND:	LD	HL,(LOVEC)	;GET VECTOR
	CALL	HLSRB		;GET THE RIGHT BIT
	PUSH	HL		;SAVE IT
	EX	DE,HL		;GET IN DE
	CALL	SELECD		;SELECT THE DISC
	POP	HL		;RESTORE THE VECTOR
	JP	Z,ERMND		;J IF DRIVE SELECT ERROR
	BIT	0,L
	RET	NZ
	PUSH	AF
	LD	BC,(DPSIZ)
	SRL	B
	RR	C
	SRL	B
	RR	C
	SRL	B
	RR	C
	INC	BC
	LD	HL,(ALVAD)	;PT TO ALLOC VECTOR
LOGON1:	LD	(HL),00H
	INC	HL
	DEC	BC
	LD	A,B
	OR	C
	JR	NZ,LOGON1
	LD	DE,(DPALL)	;GET DIRECTORY ALLOCATION BITS
	LD	HL,(ALVAD)	;PRESET ALLOCATION OF DIRECTORY
	LD	(HL),E
	INC	HL
	LD	(HL),D
	CALL	LF017		;RESET DISC TO TRK ZERO ETC
	LD	HL,(NOOADB)	;RESET No OF DIRECTORY ENTRIES TO MIN
	LD	(HL),03H
	INC	HL
	LD	(HL),00H
NDNXTD:	LD	C,0FFH		;MARK UPDATE
	CALL	NXTDIE		;GET ENTRY
	JR	Z,SVECT
	CALL	PTOENT		;PT TO ENTRY
	LD	A,0E5H		;ERASED VALUE
	CP	(HL)		;EMPTY ENTRY?
	JR	Z,NDNXTD	;J IF IT IS
	LD	A,(CURUSR)	;SAME USER?
	CP	(HL)
	JR	NZ,NDSETE
	INC	HL		;PT TO 1ST BYTE IN NAME
	LD	A,(HL)		;GET THE VALUE
	SUB	'$'		;IS IT '$'
	JR	NZ,NDSETE	;J IF NOT
	DEC	A		;SET REPLY
	LD	(IREPLY),A	;TO FF
NDSETE:	LD	C,01H		;SET ALLOCATION BITS FOR ENTRY
	CALL	SENTAL
	CALL	UPMAXE		;UPDATE MAX ENTRIES IF REQUIRED
	JR	NDNXTD
;
SVECT:	POP	AF
	LD	HL,LOVEC
SVECTB:	CALL	SVECTA
	LD	A,C
	OR	(HL)
	LD	(HL),A
	INC	HL
	LD	A,B
	OR	(HL)
	LD	(HL),A
	RET
;
;	testing extent
LF39E:	PUSH	BC		;SAVE OFFSET/LENGTH
	PUSH	AF		;AND CONVERT TO REAL ONE
	LD	A,(DPEXM)	;GET THE EXTENT MASK
	CPL			;FORM MASK FOR ACT No
	LD	B,A		;TO B
	LD	A,C		;GET EXTENT
	AND	B		;FIND REAL ONE
	LD	C,A		;AND SAVE
	POP	AF		;RESTORE OTHER EXTENT
	AND	B		;MASK IT
	SUB	C		;TEST AGAINST STORED
	AND	1FH		;MAKE MAX VALUE
	POP	BC		;RESTORE LENGTH/OFFSET
	RET
;
;	FIND A FILE/EXTENT
FNDFI:	LD	C,0CH
FINDFI:	LD	A,0FFH
	LD	(LF96E),A
	LD	HL,LF972
	LD	(HL),C
	CALL	LF017		;RESET TO START OF DIRECTORY
GETFIE:	LD	C,00H		;MARK READ ACCESS
	CALL	NXTDIE		;AND GET ENTRY
	JR	Z,FFFAIL	;J IF NOT TO NOT-FOUND (what?)
	LD	DE,FCB		;SET FCB PTR
	LD	A,(DE)		;GET THE DISC NO/USER
	CP	0E5H		;LOOKING FOR ERASED
	JR	Z,NORNGC	;J IF WE ARE
	PUSH	DE		;SAVE FCB ADRESS
	CALL	TENTNO		;TEST IF PAST DIR END
	POP	DE		;RESTORE FCB
	JR	NC,FFFAIL	;J IF SO TO FAIL
NORNGC:	CALL	PTOENT		;PT TO ENTRY FOUND
	LD	A,(LF972)
	LD	C,A
	LD	B,00H		;INIT POSITION CONTER
TENTCH:	LD	A,C
	OR	A
	JR	Z,ENTFND
	LD	A,(DE)		;GET THE FCB BYTE
	CP	'?'		;IS IT '?'
	JR	Z,FFNXEN	;J IF SO SINCE ALL MATCH
	LD	A,B		;GET OFFSET REACHED IN ENTRY
	CP	0DH		;IS IT S1
	JR	Z,FFNXEN	;J IF SO TO IGNORE S1
	CP	0CH		;IS IT EXTENT
	LD	A,(DE)		;RESTORE FCB VALUE
	JR	Z,EXTTST	;J IF SO TO DO TEST OF EXTENT
	SUB	(HL)		;TEST AGAINST ENTRY VALUE
	AND	7FH		;IGNORE ATTRIBUTE BIT
	JR	NZ,GETFIE	;J IF NOT SAME
	JR	FFNXEN		;ELSE CARRY ON TESTING
;
;	TEST IF SAME EXTENT
EXTTST:	PUSH	BC		;SAVE OFFSET AND LENGTH
	LD	C,(HL)		;GET ENTRY EXTENT
	CALL	LF39E
	POP	BC		;RESTORE LENGTH/OFFSET
	JR	NZ,GETFIE	;J IF NOT THE SAME
FFNXEN:	INC	DE		;BUMP FCB PTR
	INC	HL		;AND ENTRY PTR
	INC	B		;UP OFFSET
	DEC	C
	JR	TENTCH
;
;	FOUND MATCHING ENTRY
ENTFND:	LD	A,(DIRENO)	;GET THE ENTRY NUMBER
	AND	03H		;GET THE OFFSET
	LD	(IREPLY),A	;AS REPLY
	LD	HL,LF96E
	LD	A,(HL)
	RLA
	JR	NC,JTSTEDI
	XOR	A
	LD	(HL),A
	JR	JTSTEDI
;
;	FAILED TO FIND ENTRY REQUIRED
FFFAIL:	CALL	STRTDI		;RESET ENTRY No
	LD	A,H
	LD	(IREPLY),A
JTSTEDI:JP	TSTEDI
;
;	DELETE A SPECIFIED FILE
IDELEF:	CALL	TCBDRV		;SET UP DRIVE
	CALL	DOC1
	CALL	FNDFI
DELEXT:	JP	Z,RNEXIT
	CALL	PTOENT
	PUSH	HL
	CALL	TSTROB
	POP	HL
	LD	(HL),0E5H	;SET ERASED
	LD	C,00H		;MARK DELETING
	CALL	SENTAL		;AND RSET ALLOCATION VECTOR
	CALL	WRTDIR		;WRITE AWAY RECORD
	CALL	GETFIE		;GET THE NEXT FILE IF ANY
	JR	DELEXT		;AND REPEAT
;
;	FIND A FREE BLOCK FROM THE ALLOCATION VECTOR
FIFREB:	LD	D,B		;SAVE LAST POSITION REACHED
	LD	E,C
TSCBLN:	LD	A,C		;TEST IF FIRST TIME
	OR	B
	JR	Z,NXFRAL	;J IF SO
	DEC	BC		;BACK OFF
	PUSH	DE		;SAVE OLD VALUE
	PUSH	BC
	CALL	GALBIT		;GET THE BLOCK BIT
	RRA			;IS IT FREE
	JR	NC,FRALBL	;J IF IT IS TO USE IT
	POP	BC		;RESTORE VALUES
	POP	DE
NXFRAL:	LD	HL,(DPSIZ)	;GET SIZE IN BLOCKS
	LD	A,E		;LAST BLOCK No
	SUB	L
	LD	A,D
	SBC	H
	JR	NC,TIFULL	;J IF REACHED END OF VECTOR
	INC	DE		;PT TO NEXT BLOCK
	PUSH	BC
	PUSH	DE
	LD	B,D
	LD	C,E
	CALL	GALBIT
	RRA			;TEST IF USED
	JR	NC,FRALBL	;J IF NOT
	POP	DE		;RESTORE LAST
	POP	BC
	JR	TSCBLN		;AND TEST NEXT
;
;	FOUND FREE BLOCK IN VECTOR
FRALBL:	RLA			;RESTORE BYTE
	INC	A		;SET USED
	CALL	SRALBY		;RESTORE TO VECTOR
	POP	HL
	POP	DE
	RET
;
;	TEST WHETHER DISK IS FULL
TIFULL:	LD	A,C		;TRIED ALL VECTOR?
	OR	B
	JR	NZ,TSCBLN	;J IF NO TO RESTART
	LD	HL,0		;INDICATE FAILED
	RET
;
;	SET ATTRIBUTES OF FILE
ISETAT:	CALL	TCBDRV		;SET UP DRIVE
	CALL	FNDFI
STBEXT:	JP	Z,RNEXIT
	LD	C,0		;OFFSET
	LD	E,0CH		;AND LENGTH
	CALL	UPDENT		;UPDATE ENTRY
	CALL	GETFIE		;GET THE EXT ONE
	JR	STBEXT		;AND REPEAT
;
;	OPEN REQUESTED FILE
IOPENF:	CALL	TCBDRV		;SET UP DRIVE
	CALL	LF231
OPFILE:	LD	C,0FH
	CALL	FINDFI		;FIND THE FIRST ONE
	RET	Z		;RETURN IF NOT FOUND
OPFEXT:	LD	HL,FCBEXT
	LD	A,(HL)		;GET EXTENT
	PUSH	AF		;SAVE IT
	PUSH	HL
	CALL	PTOENT		;PT TO ENTRY
	LD	DE,FCB		;GET FCB ADDRESS
	LD	BC,0020H	;LENGTH OF ENTRY
	PUSH	HL
	LDIR
	CALL	MAKE1
	POP	IX
	LD	C,(IX+0CH)
	LD	B,(IX+0FH)
	POP	HL
	POP	AF
	LD	(HL),A
	CP	C
	LD	A,B
	JR	Z,FULEXT
	LD	A,00H
	JR	NC,FULEXT
	LD	A,128		;SET MAXIMUM COUNT
FULEXT:	LD	(FCBRC),A
	RET
;
RSTDFE:	LD	A,(HL)
	INC	HL
	OR	(HL)
	DEC	HL
	RET	NZ
	LD	A,(DE)
	LD	(HL),A
	INC	DE
	INC	HL
	LD	A,(DE)
	LD	(HL),A
	DEC	DE
	DEC	HL
	RET
;
;	CLOSE FILE
ICLOSF: CALL	TCBDRV		;SET UP DRIVE
;
;	CLOSE FILE
CLFILE:	XOR	A
	LD	(IREPLY),A
	LD	(DIRENO),A	;CLEAR ENTRY NUMBER
	LD	(DIRENO+1),A
	CALL	TSTROV		;FAIL IF READ ONLY DISK
	RET	NZ
	LD	A,(FCBS2)
	AND	80H
	RET	NZ
	LD	C,0FH
	CALL	FINDFI
	RET	Z
	LD	BC,FBLKS	;PT TO BLOCKS IN ENTRY
	CALL	PTOENT
	ADD	HL,BC
	EX	DE,HL
       	LD	HL,FCBBLK
;
;	CHECK WORD BLOCK NOS.
	LD	C,10H		;NO OF BLOCKS DEFINED
CLTSEQ:	CALL	RSTDFE		;DO SHUFFLE
	EX	DE,HL
       	CALL	RSTDFE		;AND AGAIN IN REVERSE
        EX	DE,HL
        LD	A,(DE)		;GET ENTRY VALUE
        CP	(HL)		;SAME?
        JR	NZ,CLFAIL	;J IF CORRUPT
        INC	DE		;NEXT BYTE
        INC	HL
        LD	A,(DE)		;TRY AGAIN
        CP	(HL)
        JR	NZ,CLFAIL
        DEC	C		;BACK OFF ONE WORD
	INC	DE
	INC	HL
	DEC	C
        JR	NZ,CLTSEQ	;J IF MORE
        LD	BC,LFFEC	;PT TO EXTENT
        ADD	HL,BC		;IN FCB
        EX	DE,HL
        ADD	HL,BC		;AND ENTRY
        LD	A,(DE)		;GET THE FCB EXTENT
	CP	(HL)		;SAME AS BEFORE?
	JR	C,CLFINI	;J IF NOT INCREASED IN SIZE
	LD	(HL),A		;SAVE NEW VALUE IN ENTRY
        LD	BC,0003H	;PR TO RECORD COUNT
        ADD	HL,BC
        EX	DE,HL
        ADD	HL,BC
        LD	A,(HL)		;GET IT FROM FCB
        LD	(DE),A		;PUT IN ENTRY
CLFINI:	LD	A,0FFH
	LD	(FLAGS),A
	JP	WRDIBL		;AND WRITE RECORD AWAY
;
CLFAIL:	LD	HL,IREPLY
	DEC	(HL)
	RET
;
;	MAKE FILE
IMAKEF:	CALL	TCBDRV		;SET UP DRIVE
	CALL	LF231
;
;	MAKE A FILE/EXTENT
MKFILE:	CALL	DOC1
	LD	HL,FCB		;PT TO EMPTY DUMMY FCB
	PUSH	HL
	LD	B,(HL)
	PUSH	BC
	LD	(HL),0E5H
	LD	C,01H		;LENGTH OF ONE FOR ERASED
	CALL	FINDFI		;FIND A FREE ENTRY
	POP	BC
	POP	HL
	LD	(HL),B
	RET	Z
	LD	HL,FCBRC	;PT TO RECORD COUNT
	LD	C,11H		;LENGTH OF CLEAR
       	XOR	A
MKCLRE:	LD	(HL),A		;CLEAR BYTES IN FCB
	INC	HL
	DEC	C
	JR	NZ,MKCLRE
	LD	(FCBS1),A
	CALL	UPMAXE		;UPDATE ALL ENTRY
	CALL	WRDIRE		;WRITE AWAY
MAKE1:	LD	HL,FCBS2
	SET	7,(HL)
	RET
;
;	OPEN NEXT EXTENT OF FILE
OPNXEX:	XOR	A
	LD	(FLAGS),A
	CALL	CLFILE		;CLOSE CURRENT EXTENT
	CALL	TSTEDI		;DID IT FAIL?
	RET	Z		;RETURN IF SO
	LD	HL,FCBEXT
	LD	A,(HL)		;GET EXTENT
	INC	A		;UP BY ONE
	AND	1FH		;MOD 32
	LD	(HL),A		;RESET IT
	JR	Z,MAKEXT		;J IF MAXIMUM REACHED
	LD	B,A
	LD	A,(DPEXM)
	AND	B
	LD	HL,FLAGS
	AND	(HL)
	JR	Z,FNXTEX	;J IF CANT BE IN SAME ONE
	JR	EXTFND		;FIND THE NEXT ONE
;
;	MAXIMUM REACHED
MAKEXT:  LD	HL,FCBS2
	INC	(HL)		;UP IT
	LD	A,(HL)		;AND GET RESULT
	AND	0FH		;GET ACTUAL EXTENT
	JR	Z,FNEXFL	;J IF MAX TO FAIL
FNXTEX:	LD	C,0FH		;SEARCH LENGTH
	CALL	FINDFI		;FND THE NEXT ONE
	JR	NZ,EXTFND	;J IF FOUND
	LD	A,(LF96C)
	INC	A
	JR	Z,FNEXFL
	CALL	MKFILE		;MAKE THE NEXT EXTENT
	CALL	TSTEDI		;ANY LUCK?
	JR	Z,FNEXFL	;J IF NOT TO FAIL
	JR	FINEXT		;FINISH OFF
;
;	FOUND REQUIRED EXTENT
EXTFND:	CALL	OPFEXT
FINEXT:	CALL	LF190
	XOR	A		;MARK OPERATION OK
	JP	IREPEX		;AND RETURN
;
;	FAILED TO OPEN EXTENT
FNEXFL:	CALL	MAXWR		;SET REPLY
	JP	MAKE1
;
;	READ RANDOM RECORD
IRDRAN:	CALL	TCBDRV		;SET UP DRIVE
	LD	C,0FFH		;MARK READ OPERATION
	XOR	A
	CALL	RANSET		;SET THE REQUIRED VALUES
	RET	NZ
	JR	RDSQRA		;READ THE RECORD
;
;	READ SEQUENTIAL
IRDSQN:	CALL	TCBDRV		;SET UP DRIVE
	LD	A,01H
	LD	(FLAGS2),A
RDSQRA:	LD	A,0FFH
	LD	(LF96C),A
	CALL	LF190		;GET CURRENT RECORD NUMBER
	LD	HL,CURRC
	CP	(HL)		;TEST IF EXCEEDED
	JR	C,RDEXSE		;J IF NOT TO CARRY OUT READ
	CP	80H		;IS IT MAXIMUM?
	JR	NZ,RDFAIL	;J IF NOT TO FAIL
	CALL	OPNXEX		;OPEN NEXT EXTENT IF ANY
	XOR	A
	LD	(CURCR),A
	LD	A,(IREPLY)	;GET REPLY
	OR	A
	JR	NZ,RDFAIL	;FAIL IF BAD EXENT OPEN
RDEXSE:	CALL	GCURBL		;GET THE CURRENT BLOCK
	JR	Z,RDFAIL	;FAIL IF IT IS
	CALL	CALCSN		;CALC PARAM FOR READ
	CALL	LF0CF
	CALL	LF0A2
	CALL	LF07C
	JP	LF1A7
;
;	FAILED TO READ
RDFAIL:
;
;	FAILED TO WRITE
MAXWR:	LD	A,01H
	JP	IREPEX
;
;	WRITE RANDOM RECORD
IWRRAN:	CALL	TCBDRV		;SET UP DRIVE
	XOR	A
	JR	WRRAND
;
;	WRITE RANDOM WITH ZERO FILL
IWRRAZ: CALL	TCBDRV		;SET UP DRIVE
	LD	A,02H
WRRAND:	LD	C,00H		;MARK WRITE
LF61B:  CALL	RANSET
	RET	NZ
	JR	WRSQRA
;
;	WRITE SEQUENTIAL
IWRSQN:	CALL	TCBDRV		;SET UP DRIVE
	LD	A,01H
	LD	(FLAGS2),A
WRSQRA:	XOR	A
	LD	(LF96C),A
	CALL	CHKWOK		;FAIL IF READ ONLY
	LD	HL,FCB		;PT TO FCB
	CALL	TSTROB		;FAIL IF READ ONLY FILE
	CALL	LF190		;GET CURRENT RECORD
	CP	80H		;MAXIMUM REACHED?
	JR	NC,MAXWR	;J IF OVER LIMIT
	CALL	GCURBL		;GET THE CURRENT BLOCK
	LD	C,00H		;SET ALLOCATED IN CASE
	JR	NZ,WRREC	;J IF NOT REQUIRED
	CALL	CVRTOS		;CONVERT THE BLOCK No
	LD	(LASTDN),A	;SAE LAST ONE
	OR	A
	JR	Z,FINDNW		;J IF LAST RECRD NULL
	DEC	BC
	CALL	GETBLK		;GET NEXT BLOCK IF POSS
	LD	B,H
	LD	C,L
FINDNW:	CALL	FIFREB		;FIND A FREE BLOCK
	LD	A,H		;ANY FREE
	OR	L
	JR	NZ,SETNW	;J IF THERE IS
	LD	A,02H		;SET REPLY TO TRANSIENT PROGRAM
	LD	HL,LFB88
	LD	(HL),00H
	JP	IREPEX
;
SETNW:	LD	(REQSEC),HL	;SAVE THE NEW BLOCK No
	EX	DE,HL		;PUT IN DE
	LD	HL,FCBBLK	;PT TO BLOCK AREA
	LD	A,(LASTDN)	;GET OFFSET
	LD	C,A		;FORM OFFSET
	LD	B,00H
	ADD	HL,BC		;IN AREA
	ADD	HL,BC
	LD	(HL),E		;SAVE NEW BLOCK AREA
	INC	HL
	LD	(HL),D
	LD	C,02H		;MARK UNALLOCATED WRITE
WRREC:	LD	A,(IREPLY)	;GET REPLY
	OR	A
	RET	NZ		;RETURN IF PREVIOUSLY FAILED
	PUSH	BC		;SAVE ALLOC/UNALLOC
	CALL	CALCSN		;FIND INTERNAL SECTOR No
	LD	A,(FLAGS2)
	DEC	A		;TEST FLAG
	DEC	A
	JR	NZ,WROUTS	;J IF NOT WRITE WITH ZERO FILL
	POP	BC		;RESTORE UNALLOC FLAG
	PUSH	BC		;SAVE IT
	LD	A,C		;TEST THE FLAG
	DEC	A
	DEC	A
	JR	NZ,WROUTS	;J IF NOT ALLOCATED WRITE
	PUSH	HL		;SAVE BLOCKS AREA PTR
	LD	HL,(DIRBUF)	;PT TO DIRECTORY BUFFER
	LD	D,A
LF694:  LD      (HL),A
	INC	HL
	INC	D
	JP	P,LF694
	CALL	SETM
	LD	HL,(BLSEC)	;GET BLOCK SIZE IN SECTORS
	LD	C,02H		;SET UNALLOCATED WRITE
WRZERO:	LD	(REQSEC),HL	;SET REQUIRED SECTOR
	CALL	LF073
	LD	HL,(REQSEC)	;GET THE REQUIED SECTOR
	LD	C,00H		;SET ALLOCATED NOW
	LD	A,(DPMSK)	;MASK FOR BLOCKS
	LD	B,A		;TO B
	AND	L		;END OF BLOCK?
	CP	B
	INC	HL
	JR	NZ,WRZERO	;J IF NOT TO REPEAT OP
	POP	HL		;RESTORE REQUIRED BLOCK
	LD	(REQSEC),HL	;AND SAVE IT
	CALL	RESDMA		;RESET THE XFER ADDRESS
WROUTS:	POP	BC		;RESTORE ALLOC FLAG
	PUSH	BC		;SAVE IT
	CALL	LF073		;WRITE NEW ONE OUT
	POP	BC		;RESTORE ALLOC
	LD	A,(CURCR)	;GET CURRENT RECORD No
	LD	HL,CURRC
	CP	(HL)		;EXCEEDED?
	JR	C,TSETWR	;J IF NOT
	LD	(HL),A		;SET THE NEW VALUE
	INC	(HL)		;UP BY ONE
	LD	C,02H		;SET DUMMY UNALLOC
TSETWR:	LD	HL,FCBS2
	RES	7,(HL)
	CP	7FH		;WRITE LAST OF EXTENT
	JR	NZ,FINWR	;J IF NOT TO FINISH
	LD	A,(FLAGS2)
	CP	01H
	JR	NZ,FINWR
	CALL	LF1A7
	CALL	OPNXEX
	LD	HL,IREPLY
	LD	A,(HL)
	OR	A
	JR	NZ,LF6F1
	DEC	A
	LD	(CURCR),A
LF6F1:	LD	(HL),00H
FINWR:	JP	LF1A7
;
RANSET:	LD	(FLAGS2),A
	PUSH	BC		;SAVE PAR
	LD	HL,FCBRRC
	LD	A,(HL)		;GET FIRST BYTE
	AND	7FH		;CLEAR SIGN
	PUSH	AF		;SAVE IT
	LD	A,(HL)		;RESTORE VALUE		
	RLA			;GET BIT 7 VALUE
	INC	HL		;PT TO RRC+1
	LD	A,(HL)		;GET IT
	RLA			;CORRECT WITH CARRY
	AND	1FH		;MASK FOR MAX
	LD	C,A		;SAVE IT
	LD	A,(HL)		;RESTORE VALUE
	RRA			;OUST B0
	RRA			;B1
	RRA			;B2
	RRA			;B3
	AND	0FH		;AND GET RESIDUE
	LD	B,A		;IN B
	POP	AF		;RESTORE FIRST VALUE
	INC	HL		;PT TO RRC+2
	LD	L,(HL)		;GET IT
	INC	L		;UP BY ONE
	DEC	L		;DOWN ONE
	LD	L,06H		;SET FAILED CODE
	JR	NZ,RAFAIL	;J IF OVERFLOWED
	LD	(FCBCR),A	;SAVE NEW VALUE
	LD	HL,FCBEXT
	LD	A,C		;SAVE NEW EXTENT
	SUB	(HL)		;SAVE AS CURRENT?
	JR	NZ,RAXTOK	;J IF IT IS
	LD	HL,FCBS2
	LD	A,B		;GET THE CALCULATED VALUE
	SUB	(HL)		;SAME?
	AND	7FH		;OMMITING B7
	JR	Z,RAOPOK	;J IF IT IS
RAXTOK:	PUSH	BC		;SAVE VALS
	CALL	CLFILE		;CLOSE CURRENT EXTENT
	POP	BC		;RESTORE VALS
	LD	L,03H		;SET FAIL CODE
	LD	A,(IREPLY)	;DID CLOSE FAIL?
	INC	A
	JR	Z,RAEXTF	;J IF IT DID
	LD	HL,FCBEXT
	LD	(HL),C		;SET NEW VALUE
	INC	HL
	INC	HL
	LD	(HL),B		;SET NEW VALUE
	CALL	OPFILE		;OPEN THE RIGHT EXENT
	LD	A,(IREPLY)	;DID IT FAIL?
	INC	A
	JR	NZ,RAOPOK	;J IF IT DID NOT
	POP	BC		;RESTORE VALS
	PUSH	BC		;SAVE THEM
	LD	L,04H		;SET FAIL CODE
	INC	C		;UP EXTENT No
	JR	Z,RAEXTF	;J IF MAX REACHED
	CALL	MKFILE		;MAKE A NEW EXTENT
	LD	L,05H		;FAIL CODE
	LD	A,(IREPLY)	;DID THE MAKE FAIL
	INC	A
	JR	Z,RAEXTF	;J IF IT DID
RAOPOK:	POP	BC		;RESTORE VALS
	XOR	A		;MARK OK
	JP	IREPEX		;AND EXIT
;
;	FAILED RANDOM SET
RAEXTF:	LD	A,0C0H
	LD	(FCBS2),A
RAFAIL:	POP	BC		;RESTORE VALS
	LD 	A,L		;GET FAIL CODE
	LD	(IREPLY),A
	OR	A
	JP	MAKE1
;
;	CALCULATE RANDOM RECORD FROM EXT/RC/S2
CALCRA:	EX	DE,HL		;FCB PTR IN HL
	ADD	HL,DE		;GET PTR TO CURENT RECORD
	LD	C,(HL)		;GET IT IN C
	LD	B,00H		;SET UPPER BYTE ZERO
	LD	HL,FEXT		;PT TO EXTENT
	ADD	HL,DE
	LD	A,(HL)		;GET THE VALUE
	RRCA			;SHIFT
	AND	80H		;MASK BIT 7
	ADD	A,C		;ADD THE CURRENT RECORD
	LD	C,A		;SAVE IT
	LD	A,00H
	ADC	B
	LD	B,A
	LD	A,(HL)		;GET THE EXTENT AGAIN
	RRCA			;OUST B0
	AND	0FH		;GET CORRECT PART
	ADD	A,B		;ADD TO UPPER BYE OF RANDOM REC
	LD	B,A
	LD	HL,FS2		;PT TO S2
	ADD	HL,DE
	LD	A,(HL)		;GET IT
	ADD	A,A		;SHIFT TO POS
	ADD	A,A
	ADD	A,A
	ADD	A,A
	PUSH	AF		;SAVE IT
	ADD	A,B		;ADD TO TOP BYTE
	LD	B,A
	PUSH	AF		;SAVE VALUE
	POP	HL		;RESTORE IT IN HL
	LD	A,L		;TEST IF OUT OF RANGE
	POP	HL
	OR	L
	AND	01H		;SET REPLY
	LD	HL,FCBRRC
	RET			;AND EXIT
;
;	FIND SIZE OF FILE
IFILSZ:	CALL	TCBDRV		;SET UP DRIVE
	CALL	FNDFI
	LD	HL,FCBRRC	;PT TO RANDOM RECORD NUMBER
	LD	(HL),00H	;CLEAR IT
	INC	HL
	LD	(HL),00H
	INC	HL
	LD	(HL),00H
NXTSIZ:	RET	Z
	CALL	PTOENT		;GET PTR TO ENTRY
	LD	DE,FRC		;PT TO RECORD COUNT
	CALL	CALCRA		;FIND RANDOM RECORD COUNT
	LD	E,A		;TEST IF EXCEEDED
	LD	A,C
	SUB	(HL)
	INC	HL
	LD	A,B
	SBC	(HL)
	INC	HL
	LD	A,E
	SBC	(HL)
	JR	C,UPSIZ		;J IF IT ISNT
	LD	(HL),E		;SET THE NEW VALUE
	DEC	HL
	LD	(HL),B
	DEC	HL
	LD	(HL),C
UPSIZ:	CALL	GETFIE		;FIND THE NEW EXTENT
	JR	NXTSIZ		;AND REPEAT
;
;	SET RANDOM RECORD
ISETRA:	CALL	TCBDRV		;SELECT DRIVE
	LD	HL,FCB
	LD	DE,0020H
	CALL	CALCRA		;FIND THE VALUE
	LD	(HL),C
	INC	HL
	LD	(HL),B
	INC	HL
	LD	(HL),A
	RET			;AND EXIT
;
;	SET UP DRIVE
TCBDRV:	LD	DE,FCB		;PT TO FCB
	LD	HL,(IPWORD)	;PT TO USER FCB
	LD	BC,0024H	;XFER FCB INFO
	LDIR
	LD	A,01H
	LD	(LF976),A
LF7F1:	LD	A,0FFH
	LD	(LF973),A
	LD	HL,FCB
	LD	A,(HL)		;GET THE DRIVE/USER
	AND	1FH		;GET DRIVE No
	DEC	A		;BACK OFF (0=DEFAULT)
	LD	(IPBYTE),A	;RESTORE VALUE
	CP	1EH		;IS IT DEFAULT?
	JR	NC,SCBUSR	;J IF NOT
	LD	A,(CURDRV)	;GET THE CURRENT DRIVE No
	LD	(SAVDSK),A	;SAVE IT
	LD	A,(HL)		;GET REQUIRED ONE
	LD	(DEFFLG),A	;SET DEFAULT
	AND	0E0H		;GET USER
	LD	(HL),A		;PUT USER AWAY
	PUSH	HL
	CALL	SELDS		;SELECT DRIVE
	POP	HL
SCBUSR:	LD	A,(CURUSR)	;GET THE DEFAULT USER
	OR	(HL)		;GET THE DRIVE CODE
	LD	(HL),A		;EREPLACE
	RET			;AND EXIT
;
;	SEARCH FOR FIRST DIRECTORY ENTRY
ISFIRS:	LD	C,00H		;SET ANY MATCH
	EX	DE,HL
	LD	A,(HL)		;GET DRIVE REQUIRED
	CP	'?'		;IS IT '?'
	JR	Z,ANYUSR		;J IF IT IS TO MATCH ANY USER
	LD	A,(FCBEXT)	;GET IT
	CP	'?'		;IS IT '?'
	CALL	NZ,LF231
	CALL	TCBDRV		;SET UP ANY DRIVE
	LD	C,0FH
ANYUSR:	CALL	FINDFI		;FIND THE FILE
	JR	MOVDIR		;AND MOVE RECORD TO BUFFER
;
;	SEARCH FOR NEXT DIRECTORY ENTRY
ISNEXT:	CALL	LF7F1
	CALL	GETFIE
;
;	MOVE DIRECTORY ENTRY TO USER DMA BUFER
MOVDIR:	LD	HL,(DIRBUF)
	LD	DE,(USRDMA)
	LD	BC,0080H
	LDIR
	RET
;
;	RENAME FILE
IRENAF:	CALL	TCBDRV		;SET UP DRIVE
	CALL	DOC1
	CALL	FNDFI
	LD	A,(FCB)
	LD	(FCBBLK),A
	JR	Z,RNEXIT
RENEXT:	CALL	PTOENT
	CALL	TSTROB
	LD	C,FBLKS		;OFFSET OF NEW NAME
	LD	E,FEXT		;LENGTH EXCLUDING EXTENT
	CALL	UPDENT		;UPDATE ENTRY
	CALL	GETFIE		;GET THE NEXT ONE
	JR	NZ,RENEXT	;AND REPEAT?
RNEXIT:	LD	A,(LF96E)
	JP	IREPEX
;
;	GET LOGON VECTOR
IGLONV:	LD	HL,(LOVEC)	;GET VECTOR
	JR	IWDREP		;AND REPLY
;
;	GET CURRENT DISK
IGCDSK:	LD	A,(CURDRV)	;GET THE DRIVE No
	JP	IREPEX		;AND REPLY
;
;	GET ALLOC VECTOR ADDRESS
IGALOV:	LD	HL,(ALVAD)	;GET THE ADDRESS
	JR	IWDREP		;AND REPLY WITH IT
;
;	GET READ ONL VECTOR
IGRODV:	LD	HL,(ROVEC)	;GET THE VECTOR
	JR	IWDREP		;AND REPLY
;
;	GET DISC PARAMETER AREA ADDRESS
IGDPAD:	LD	HL,(DPBAD)
IWDREP:	LD	(IREPLY),HL	;SET REPLY WORD
	RET			;AND RETURN
;
;	GET/SET USER CODE
IGSUSR:	LD	A,(IPBYTE)	;GET THE PARAMETER
	CP	0FFH		;IS IT SET CODE?
	JR	NZ,STUSER	;J IF IT IS
	LD	A,(CURUSR)	;GET THE CURRENT VALUE
	JP	IREPEX		;AND REPLY
;
STUSER:	AND	1FH		;MASK THE USER NUMBER
	LD	(CURUSR),A
	RET
;
;	RESET DISC
IRESDS:	LD	HL,(IPWORD)	;GET THE PARAM
RESDSK:	LD	A,L		;MAKE MASK
	CPL
	LD	E,A
	LD	A,H
	CPL
	LD	HL,(LOVEC)	;CLEAR BITS IN LOG ON VECTOR
	AND	H
	LD	D,A
	LD	A,L
	AND	E
	LD	E,A
	LD	HL,(ROVEC)	;AND READ ONLY VECTOR
	EX	DE,HL
	LD	(LOVEC),HL
	LD	A,L
	AND	E
	LD	L,A
	LD	A,H
	AND	D
	LD	H,A
	LD	(ROVEC),HL
	RET			;AND EXIT
;
XPOINT:	LD	A,(LF973)
	OR	A
	JR	Z,NDSKOP
	LD	HL,FCB		;PT TO DRIVE/USER
	LD	(HL),00H	;CLEAR DRIVE AND USER
	LD	A,(DEFFLG)	;GET DEFAULT DRIVE
	OR	A
	JR	Z,NDSKOP
	LD	(HL),A		;RESTORE DRIVE
	LD	A,(SAVDSK)	;RESET DEFAULT DRIVE
	LD	(IPBYTE),A
	CALL	SELDS		;AND SELECT IT
NDSKOP:	LD	A,(LF976)
	OR	A
	JR	Z,LF8EF
	LD	DE,(IPWORD)
	LD	HL,FCB
	LD	BC,0024H
	LDIR
LF8EF:	LD	IX,(IXSAVE)
	LD	HL,(IREPLY)	;GET REPLY
	LD	A,L		;AND IN AB
	LD	B,H
	RET
;
;	INTERNAL STACK AREA
LF8F9:	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
LF925:	DEFB	000H,000H,000H,000H
;	OUR OWN NTERNAL STACK
OWNSTK	EQU	$
CURUSR:	DEFB	00H	;CURRENT USER
CURDRV:	DEFB	00H	;CURRENT DRIVE NUMBER
REQTRK:	DEFW	0000H	;REQUIRED HEAD POSITION
LF92D:	DEFB	000H,000H
LSTPOS:	DEFB	00H	;START POSITION OF CURRENT BUFFERED I/P LINE
LCUPOS:	DEFB	00H	;CURRENT POSITION OF CURSOR
FLDEOP:	DEFB	00H
CHSAVE:	DEFB	00H	;PLACE TO SAVE CHAR IF TYPED AHEAD
SPSAVE:	DEFW	0000H	;USER'S STACK POINTER SAVE AREA
IPWORD:	DEFW	0000H	;INPUT PARAMETER SAVE AREA
IREPLY:	DEFW	0000H	;REPLY SAVE AREA (BYTE)
HLSAVE:	DEFW	0000H
IXSAVE:	DEFW	0000H
LF93D:	DEFB	000H
LF93E:	DEFB	000H,000H,000H
LF941:	DEFB	000H,000H,000H,000H
LF945:	DEFB	000H
ROVEC:	DEFW	0000H	;READ ONLY VECTOR...B<N> SET IF DRIVE N IS READ ONLY
LOVEC:	DEFW	0000H	;LOG ON VECTOR...B<N> SET IF DRIVE HAS BEEN ACCESSED
USRDMA:	DEFW	0080H	;ADDRESS OF USER'S TRNSFER BUFFER
NOOADB:	DEFW	0000H	;NO OF DIRECTORY ENTRIES RELEVANT ON CURRENT DRIVE
LF94E:	DEFW	0000H
LF950:	DEFW	0000H
;****************************************
;*	DISK PARAMETER HEADER IMAGE	*
;****************************************
DIRBUF:	DEFW	0000H	;ADDRESS OF DIRECTORY BUFFER
DPBAD:	DEFW	0000H	;ADDRESS OF DISK PARAMETER BLOCK FOR CURRENT DRIVE
CSVAD:	DEFW	0000H	;CHECKSUM VECTOR ADDRESS
ALVAD:	DEFW	0000H	;ALLOCATION VECTOR ADDRESS
;****************************************
;*	DISK PARAMETER BLOCK IMAGE	*
;****************************************
DPSEC:	DEFW	0000H	;NO OF RECORDS PER TRACK ON DISK
DPBSH:	DEFB	00H	;BLOCK SHIFT FACTOR
DPMSK:	DEFB	00H	;BLOCK MASK VALUE
DPEXM:	DEFB	00H	;EXTENT MASK
DPSIZ:	DEFW	0000H	;SIZE OF DISK IN BLOCKS
DPDIR:	DEFW	0000H	;NO OF DIRECTORY ENTRIES MAXIMUM ON DISK
DPALL:	DEFW	0000H	;INITIAL ALLOCATION VECTOR VALUE FOR DIRECTORY
DPCHK:	DEFW	0000H	;NO OF CHECKED DIRECTORY ENTRIES
DPSYS:	DEFW	0000H	;NO OF SYSTEM TRACKS
XLTAD:	DEFW	0000H
;****************************************
FLAGS:	DEFB	00H
LF96C:	DEFB	00H		;0=WRITE SEQUENTIAL, FF=READ
LF96D:	DEFB	00H		;0 OR 1
LF96E:	DEFB	00H		;0=FILE FOUND  OR FF
FLAGS2:	DEFB	00H
IPBYTE:	DEFB	00H
LASTDN:	DEFB	00H		;D.SLN
LF972:	DEFB	00H		;SEARCH LENGTH
LF973:	DEFB	00H		;0 OR FF
SAVDSK:	DEFB	00H
DEFFLG:	DEFB	00H
LF976:	DEFB	00H		;0 OR 1
CURRC:	DEFB	00H
CUREXT:	DEFB	00H
CURCR:	DEFB	00H
	DEFB	000H
REQSEC:	DEFW	0000H	;REQUIRED INTERNAL SECTOR No
BLSEC:	DEFW	0000H	;REQUIRED BLOCK No
DIROFF:	DEFB	00H	;OFFSET OF CURRENT ENTRY IN DIRECTORY RECORD
LF981	EQU	$+1
DIRENO:	DEFW	0000H	;ENTRY NUMBER OF CURRENT DIRECTORY SEARCH
DIRSEC:	DEFW	0000H	;REQUIRED INTERNAL SECTOR No OF DIRECORY BLOCK
PSWORD:	DEFB	00H,00H,00H,00H
	DEFB	00H,00H,00H,00H
FCB	EQU	$
;	OFFSETS INTO FCB
;FDRV	EQU	0	;DRV...DRIVE NUMBER IN B4-0, USER IN B7-5
;FNAM	EQU	1	;NAM...NAME UP TO 8 BYTES
;FTYP	EQU	9	;TYP..NAME EXTENSION
;FEXT	EQU	12	;EXT...EXTENT 0-31...DISC DIFFERENT
;FS1	EQU	13	;S1
;FS2	EQU	14	;S2...B7 SET IF NOT WRITTEN TO
;			;B6-0 ACTUAL EXTENT OPEN
;FRC	EQU	15	;RC...RECORD COUNT (=128 IF FLL EXTENT)
;FBLKS	EQU	16	;BLKS...16 BYTES OF BLOCK INFORMATION
;FCR	EQU	32	;CR..CURRENT RECORD 0-128
;FRRC	EQU	33	;RRC...RANDOM RECORD NO 0-65535 (3 BYTES USED)
FCBDRV:	DEFB	00H
FCBNAM:	DEFB	00H,00H,00H,00H
	DEFB	00H,00H,00H,00H
FCBTYP:	DEFB	00H,00H,00H
FCBEXT:	DEFB	00H
FCBS1:	DEFB	00H
FCBS2:	DEFB	00H
FCBRC:	DEFB	00H
FCBBLK:	DEFB	00H,00H,00H,00H
	DEFB	00H,00H,00H,00H
	DEFB	00H,00H,00H,00H
	DEFB	00H,00H,00H,00H
FCBCR:	DEFB	00H
FCBRRC:	DEFB	00H,00H,00H
	DEFB	000H
LF9B1:	DEFB	000H,000H,000H,000H
LF9B5:	DEFB	000H,000H,000H,000H
LF9B9:	DEFB	000H,000H,000H,000H
LF9BD:	DEFB	000H,000H,000H
XLTAD0:	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
DIRBUF0:DEFW	0FD00H
DPBAD0:	DEFW	0FAEEH
CSVAD0:	DEFW	0FD80H
ALVAD0:	DEFW	0FDC0H
XLTAD1:	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
DIRBUF1:DEFW	0FD00H
DPBAD1:	DEFW	0FAEEH
CSVAD1:	DEFW	0FD90H
ALVAD1:	DEFW	0FDCCH
XLTAD2:	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
DIRBUF2:DEFW	0FD00H
DPBAD2:	DEFW	0FAEEH
CSVAD2:	DEFW	0FDA0H
ALVAD2:	DEFW	0FDD8H
XLTAD3:	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
DIRBUF3:DEFW	0FD00H
DPBAD3:	DEFW	0FAEEH
CSVAD3:	DEFW	0FDB0H
ALVAD3:	DEFW	0FDE4H
;***********************************************************************
;*******			THE END				;*******
