	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH
;
ENTRY:	JP	CPR
;
LE303:	JP	LE109
;
;DOS LINE BUFFER
;
LE306:	DEFB	02H		;NUMBER OF DIR ENTRIES PER LINE 32/40=2,80=5
MBUFF:	DEFB	80H		;MAX BUFFER LENGTH
CBUFF:	DEFB	00H		;NUMBER OF VALID CHARS IN COMMAND LINE
CIBUFF:	DEFS	14,0		;	'              '	;DEFAULT (COLD BOOT) COMMAND
CIBUF:	DEFB	00H		;COMMAND STRING TERMINATOR
LE317:	DEFB	000H,000H
LE31A:	DEFB	000H,000H,000H,000H
LE31E:	DEFB	000H,000H,000H,000H
LE322:	DEFB	000H,000H,000H,000H
LE326:	DEFB	000H,000H
	DEFB	'COPYRIGHT (C) '
	DEFB	'1984, Xtal RESEARCH'
LE346:	DEFB	000H
LE34A:	DEFB	000H,000H,000H,000H
LE34E:	DEFB	000H,000H,000H,000H
LE352:	DEFB	000H,000H,000H,000H
LE356:	DEFB	000H,000H,000H,000H
LE35A:	DEFB	000H,000H,000H,000H
LE35E:	DEFB	000H,000H,000H,000H
LE362:	DEFB	000H,000H,000H,000H
LE366:	DEFB	000H,000H,000H,000H
LE36A:	DEFB	000H,000H,000H,000H
LE36E:	DEFB	000H,000H,000H,000H
LE372:	DEFB	000H,000H,000H,000H
LE376:	DEFB	000H,000H,000H,000H
LE37A:	DEFB	000H,000H,000H,000H
LE37E:	DEFB	000H,000H,000H,000H
LE382:	DEFB	000H,000H,000H,000H
LE386:	DEFB	000H,000H,000H,000H
CIBPTR:	DEFW	CIBUFF		;POINTER TO COMMAND INPUT BUFFER
CIPTR:	DEFW	0		;CURRENT POINTER
;
;OUTPUT <CRLF>
;
CRLF:	CALL	PRINT
	DEFB	CR,LF+80H
	RET
;
;OUTPUT A SPACE
;
LE394:	LD	A,' '
CONOUT:	PUSH	HL
	PUSH	DE
	PUSH	BC
	PUSH	AF
	LD	E,A
	LD	C,02H		;PRINT CHARACTER
	CALL	BDOS
	POP	AF
	POP	BC
	POP	DE
	POP	HL
	RET
;
OPENF:	CALL	LE51B
	XOR	A
	LD	(TFCBCR),A
	LD	DE,FCBDN
OPEN:	LD	C,0FH
GRBDOS:	CALL	BDOS
	INC	A		;SET ZERO FLAG FOR ERROR RETURN
	RET
;
CLOSE:	LD	C,10H
	JR	GRBDOS
;
SEARF:	LD	C,11H		;SEARCH FOR FIRST DIRECTORY
LE3BC:	LD	DE,FCBDN
LE3BF:	CALL	GRBDOS
	RET	NZ
PRNNF:	PUSH	AF
	CALL	PRINTC
	DC	'No File'
	POP	AF
	RET
;
SEARN:	LD	C,12H		;SEARCH FOR NEXT DIRECTORY ENTRY
	JR	GRBDOS
;
DELETE:	LD	C,13H		;DELETE FILE
BDOSJP:	JP	BDOS
;
READF:	LD	DE,FCBDN
	LD	C,14H		;READ SEQUENTIAL
BDOSB:	CALL	BDOS
	OR	A
	RET
;
LE3E3:	LD	DE,FCBDN
	LD	C,15H		;WRITE SEQUENTIAL
	JR	BDOSB
;
LE3EA:	LD	C,16H		;MAKE NEW FILE
	JR	GRBDOS
;
LE3EE:	LD	C,17H		;RENAME FILE
	JR	BDOSJP
;
CONSTAT:LD	C,0BH		;GET CONSOLE STATUS
	CALL	BDOS
	OR	A
	RET	Z
CONIN:	LD	C,01H		;GET CHAR FROM CON: WITH ECHO
	PUSH	DE
	CALL	BDOS
	POP	DE
	CP	1BH		;ESCAPE CHAR ?
	SCF
	RET	Z
	OR	A
	RET
;
;RETURN NUMBER OF CURRENT DISK IN A
;
GETDRV:	LD	C,19H
	JR	BDOSJP
;
;SET 80H AS DMA ADDRESS
;
DEFDMA:	LD	DE,128		;80H=TBUFF
SETDMA:	LD	C,1AH
	JR	BDOSJP
;
LE411:	PUSH	BC
	PUSH	DE
	LD	C,1BH		;GET ALLOCATION VECTOR
	CALL	BDOS
	LD	IY,0
	POP	DE
	DEC	HL		;DEC VECTOR POINTER
LE41E:	LD	B,08H
	INC	HL		;INC VECTOR POINTER
	LD	C,(HL)		;GET BYTE
LE422:	RR	C		;BOTTEM BIT SET?
	JR	C,LE428
	INC	IY		;INC PTR
LE428:	DEC	DE
	LD	A,D
	OR	E
	JR	Z,LE431		;FINISHED? DE=0
	DJNZ	LE422		;LOOP UNTIL 8 BYTES CHECKED
	JR	LE41E		;CHECK NEXT 8 BYTES
;
LE431:	PUSH	IY		;XFER VECTOR POINTER INTO HL
	POP	HL
	POP	BC
	RET
;
LE436:	LD	C,1FH		;GET DISC PARAMATER BLOCK
	CALL	BDOS
	INC	HL
	INC	HL
	LD	A,(HL)		;GET BYTE
	SUB	02H
	RET
;
GETUSR:	LD	E,0FFH		;SET CURRENT USER NUMBER
SETUSR:	LD	C,20H		;SET USER NUMBER TO VALUE IN E (GET IF E=FFH)
	JR	BDOSJP
;
MOS:	LD	C,26H
	JR	BDOSJP
;
LE44B:	LD	B,A
	INC	B
	DEC	B
	LD	HL,1
	JR	Z,LE456
LE453:	ADD	HL,HL
	DJNZ	LE453
LE456:	EX	DE,HL
	LD	C,25H		;RESET DRIVE
	JP	BDOS
;
;SET USER/DISK TO CURRENT USER AND CURRENT DISK
;
SETUD:	CALL	GETUSR
	ADD	A,A		;CONVERT INTO HIGH NIBBLE
	ADD	A,A
	ADD	A,A
	ADD	A,A
	LD	HL,TDRIVE
	OR	(HL)		;INCLUDE DRIVE NUMBER
	JR	LE46C
;
;SET USER/DISK FLAG TO USER 0 AND CURRENT DRIVE
;
SETU0D:	LD	A,(TDRIVE)
LE46C:	LD	(DEFDRV),A
	RET
;
;CONVERT CHAR IN A TO UPPER CASE
;
UCASE:	CP	'a'
	RET	C
	CP	'z'+1
	RET	NC
	AND	5FH		;CAPATALIZE
	RET
;
;PRINT STRING (ENDING WITH TOP BIT SET) PTED TO BY RET ADR;START WITH CRLF
;
PRINTC:	CALL	CRLF		;NEW LINE
PRINT:	EX	(SP),HL		;GET PTR TO STRING
PRIN1:	LD	A,(HL)		;GET NEXT BYTE
	BIT	7,A		;TOP BIT SET?
	RES	7,A		;RESET IF SO
	CALL	CONOUT
	INC	HL		;PT TO NEXT BYTE
	JR	Z,PRIN1		;LOOP IF TOP BIT NOT SET
	EX	(SP),HL		;RESTORE HL AND RET ADR
	RET
;
;PROCESS INPUT LINE
;
RB1:	CALL	SETUD
	LD	DE,MBUFF
	LD	C,0AH		;READ CONSOLE BUFFER
	CALL	BDOS
	CALL	SETU0D		;SET CURRENT DISC NUMBER IF LOWER PARAM
	LD	HL,CBUFF	;POINTER TO USERS'S COMMAND
	LD	B,(HL)		;CHAR COUNT IN B
CB1:	INC	HL		;POINT TO 1ST VALID CHAR
	LD	A,B
	OR	A
	JR	Z,CB2
	LD	A,(HL)		;CAPITALIZE COMMAND CHAR
	CALL	UCASE
	LD	(HL),A
	DEC	B
	JR	CB1
;
CB2:	LD	(HL),A
	LD	HL,CIBUFF	;SET COMMAND LINE POINTER TO 1ST CHAR
	LD	(CIBPTR),HL
	RET
;
;CHECK FOR SPECIFIED DRIVE AND LOG IT IN IF NOT DEFAULT
;
DLOGIN:	CALL	COMLOG
	RET	Z
	LD	A,(TDRIVE)
LOGIN:	LD	E,A
	LD	C,0EH		;SELECT DISC
	JP	BDOS
;
;ROUTINE TO LOGIN; ON EXIT, Z SET MEANS ABORT
;
COMLOG:	LD	A,(TEMPDR)
	OR	A
	LD	HL,TDRIVE
	JR	Z,LOG1
	DEC	A		;COMPARE IT AGAINST DEFAULT
	CP	(HL)
	RET			;ABORT IF SAME
;
LOG1:	LD	A,(HL)
	RET
;
;
;
PRMPT:	PUSH	HL
	PUSH	DE
	PUSH	BC
	CALL	CRLF		;NEW LINE
	CALL	GETDRV
	ADD	A,30H		;CONVERT IN RANGE 0-3
	CALL	CONOUT
	CALL	PRINT
	DC	':'
	POP	BC
	POP	DE
	POP	HL
	RET
;
;CHECK TO SEE IF DE POINTS TO DELIMITER; IF SO, RET W/ZERO FLAG SET
;
SDELM:	LD	A,(DE)
	OR	A		;0=DELIMITER
	RET	Z
	CP	' '		;ERROR IF > <SP>
	JP	C,ERROR
	RET	Z		;<SP>=DELIMITER
	CP	'='		;"=" DELIMITER
	RET	Z
	CP	5FH		;UNDERSCORE DELIMITER
	RET	Z
	CP	'.'		;"." DELIMITER
	RET	Z
	CP	':'		;":" DELIMITER
	RET	Z
	CP	';'		;";" DELIMITER
	RET	Z
	CP	'<'		;"<" DELIMITER
	RET	Z
	CP	'>'		;">" DELIMITER
	RET
;
;SKIP STRING PTED TO BY DE (STRING ENDS IN 0) UNTIL END OF STRING
; OR NON-BLANK ENCOUNTERED (BEGINNING OF TOKEN)
;
SBLANK:	INC	DE
BLANK1:	LD	A,(DE)
	OR	A
	RET	Z
	CP	' '
	RET	NZ
	INC	DE
	JR	BLANK1
;
;PT TO DIRECTORY ENTRY IN TBUFF WHOSE OFFSET IS SPECIFIED BY A AND C
;
DIRPTR:	LD	HL,TBUFF	;PT TO TEMP BUFFER
	ADD	A,C		;PT TO 1ST BYTE OF DIR ENTRY
	CALL	ADDAH		;PT TO DESIRED BYTE IN DIR ENTRY
	LD	A,(HL)		;GET DESIRED BYTE
	RET
;
;ADD A TO HL (HL=HL+A)
;
ADDAH:	ADD	A,L
	LD	L,A
	RET	NC
	INC	H
	RET
;
LE518:	CALL	LE526
LE51B:	XOR	A		;SET FCBDN FOR DEFAULT DRIVE
	LD	(FCBDN),A
	CALL	COMLOG		;CHECK DRIVE
	RET	Z
	JP	LOGIN		;DO LOGIN OTHERWISE
;
LE526:	CALL	SCANER
	RET	Z
	JP	ERROR
;
;EXTRACT TOKEN FROM COMMAND LINE AND PLACE IT INTO FCBDN
; FORMAT FCBDN FCB IS TOKEN RESEMBLES FILE NAME AND TYPE (FILENAME.TYPE)
; ON INPUT, CIBPTR PTS TO CHAR AT WHICH TO START SCAN
; ON OUTPUT, CIBPTR PTS TO CHAR AT WHICH TO CNTINUE AND ZERO FLAG IS RESET
;
;TOKEN LOADDED INTO FIRST FCB
;
SCANER:	XOR	A
LE52E:	LD	HL,FCBDN	;POINT TO FCBDN
LE531:	CALL	ADDAH
	PUSH	HL
	XOR	A		;SET TEMPORARY DRIVE TO DEFAULT
	LD	(TEMPDR),A
	LD	DE,(CIBPTR)
	CALL	BLANK1		;SKIP TO NON-BLANK OR END OF LINE
	LD	(CIPTR),DE	;SET PTR TO NON-BLANK OR END OF LINE
	JR	Z,SCAN2		;JUMPIF AT END OF LINE
	SUB	'0'-1		;CONVERT POSSIBLE DRIVE SPEC TO NUMBER
	LD	B,A		;STORE NUMBER IN B
	INC	DE		;PTR TO NEXT CHAR
	LD	A,(DE)		;SEE IF IT IS A COLON
	CP	':'
	JR	Z,SCAN3		;YES WE HAVE A DRIVE SPEC
	DEC	DE		;NO, BACK UP PTR TO FIRST NON-BLANK CHAR
SCAN2:	LD	A,(TDRIVE)	;SET 1ST BTE OF FCBDN AS DEFAULT DRIVE
	INC	A
	LD	(HL),A
	JR	SCAN4

SCAN3:	LD	A,B		;WE HAVE A DRIVE SPEC
	LD	(TEMPDR),A	;SET TEMPORARY DRIVE
	LD	(HL),B		;SET 1ST BYTE OF FCBDN AS SPECIFIED DRIVE
	INC	DE		;PTR TO BYTE AFTER ":"
SCAN4:	LD	B,08H		;MAX OF 8 CHARS IN FILE AME
	CALL	LE584
	CALL	SCANF
SCAN5:	INC	HL		;PTR TO NEXT BYTE IN FCBDN
	LD	(HL),00H	;FILL TYPE PART
	DJNZ	SCAN5
	LD	(CIBPTR),DE
	POP	HL
	LD	BC,000BH
SCAN6:	INC	HL
	LD	A,(HL)
	CP	'?'
	JR	NZ,SCAN7
	INC	B
SCAN7:	DEC	C
	JR	NZ,SCAN6
	LD	A,B
	OR	A
	RET
;
SCANF:	CP	'.'		;IF (DE) DELIMITER IS "." WE HAVE A TYPE
	JR	NZ,SCANF4
SCANF0:	INC	DE		;PT TO CHAR IN COMMAND LINE AFTER "."
LE584:	CALL	SDELM
	JR	Z,SCANF4
	INC	HL		;PT TO NEXT BYTE IN FCBDN
	CP	'*'		;IS (DE) A WILD CARD?
	JR	NZ,SCANF1	;CONTINUE IF NOT
	LD	(HL),'?'	;PLACE "?" IN FCBDN AND DON'T ADVANCE DE IF SO
	JR	SCANF2
;
SCANF1:	LD	(HL),A		;STORE FILENAME CHAR IN FCBDN
	INC	DE		;PT TO EXT CHAR IN COMMAND LINE
SCANF2:	DJNZ	LE584		;SCANF0
SCANF3:	CALL	SDELM		;8 CHARS OR MORE - SKIP UNTIL DELIMITER
	JR	Z,SCANF5
	INC	DE		;PT TO NEXT CHAR IN COMMAND
	JR	SCANF3
;
SCANF4:	INC	HL		;PT TO NEXT BYTE IN FCBDN
	LD	(HL),' '	;FILL FILENAME PART WITH <SP>
	DJNZ	SCANF4
SCANF5:	LD	B,03H		;MAX CHARS IN TYPE
	RET
;
CMDTBL:	DEFB	80H+'D','IR'
	DEFB	80H+'E','RA'
	DEFB	80H+'D','ISP'
	DEFB	80H+'L','OAD'
	DEFB	80H+'S','AVE'
	DEFB	80H+'R','EN'
	DEFB	80H+'P','SW'
	DEFB	80H+'G','O'
	DEFB	80H+'M','OS'
	DEFB	80H+'L','OCK'
	DEFB	80H+'U','NLOCK'
	DEFB	80H+'D','RIVE'
	DEFB	80H
;
CMDSER:	LD	DE,CMDTBL-1	;PT TO COMMAND TABLE
	LD	B,0FFH
	LD	HL,FCBFN	;PT TO STORED COMMAND NAME
CMS1:	LD	C,(HL)
	EX	DE,HL
CMS2:	INC	HL		;INC PTR IN COMMAND TABLE
	OR	(HL)		;COMPARE AGAINST COMMAND TABLE ENTRY
	JP	P,CMS2
	INC	B
	LD	A,(HL)
	AND	7FH
	JR	Z,CMS5
	CP	C
	JR	NZ,CMS2
	EX	DE,HL
	PUSH	HL
CMS3:	INC	DE		;INC PTR IN COMMAND TABLE
	INC	HL		;INS PTR IN COMMAND NAME
	LD	A,(DE)
	LD	C,A
	RLA
	LD	A,(HL)
	JR	C,CMS4
	CP	C
	JR	Z,CMS3
	POP	HL
	JR	CMS1
;
CMS4:	POP	HL
	DEC	DE
	CP	' '		;NEXT BYTE MUST BE <SP>
	JR	NZ,CMS1
CMS5:	LD	E,B
	RET
;
;CPR STARTING POINTS
;
;START CPR AND DON'T PROCESS DEFAULT COMMAND STORED
CPR1:	XOR	A		;SET NO DEFAULT COMMAND
	LD	(CBUFF),A
;
;START CPR AND POSSIBLY PROCESS DEFAULT COMMAND
;
CPR:	LD	SP,STACK	;RESET STACK
	PUSH	BC
	LD	A,C		;C=USER/DISC NUMBER
	RRA
	RRA
	RRA
	RRA
	AND	0FH
	LD	E,A		;SET USER NUMBER
	CALL	SETUSR
	LD	C,0DH		;RESET DISC SYSTEM
	CALL	BDOS
	POP	BC
	LD	A,C		;C=USER/DRIVE NUMBER
	AND	0FH		;EXTRACT DEFAULT DISC DRIVE
	LD	(TDRIVE),A	;SET IT
	CALL	LOGIN
	LD	A,(CBUFF)	;EXECUTE DEFAULT COMMAND?
	OR	A		;0=NO
	JR	NZ,RS1
RESTRT:	LD	SP,STACK	;RESET STACK
	CALL	PRMPT
	CALL	RB1
RS1:	CALL	DEFDMA
	CALL	GETDRV
	LD	(TDRIVE),A
	CALL	LE526
	CALL	CMDSER
	LD	HL,LEAE7
	PUSH	HL
	LD	HL,LE653
	LD	D,0
	ADD	HL,DE
	ADD	HL,DE
	LD	A,(HL)		;GET LOW ORDER PART
	INC	HL		;GET HIGH ORDER PART
	LD	H,(HL)		;STORE HIGH
	LD	L,A		;STORE LOW
	JP	(HL)		;EXECUTE CPR COMMAND

;LOOK UP TABLE FOR DOS_COMMANDS
LE653:	DEFW	DIR		;0E6F9H  ;/ 01 /
	DEFW	ERA		;0E818H  ;/ 02 /
	DEFW	DISP		;0E911H  ;/ 03 /
	DEFW	LOAD		;0EA08H  ;/ 04 /
	DEFW	SAVE		;0E958H  ;/ 05 /
	DEFW	REN		;0E9A9H  ;/ 06 /
	DEFW	PSW		;0E8BAH  ;/ 07 /
	DEFW	GO		;0EA90H  ;/ 08 /
	DEFW	MOS		;0E447H  ;/ 09 /
	DEFW	LOCK		;0E8D0H  ;/ 0A /
	DEFW	UNLOCK		;0E8EEH  ;/ 0B /
	DEFW	DRIVE		;0EA58H  ;/ 0C /
	DEFW	LEA6C		;0EA6CH  ;/ 0D /

NUMBER:	CALL	SCANER
	LD	A,(TEMPDR)
	OR	A
	JR	NZ,ERROR
	LD	HL,FCBFN
	LD	BC,000BH
LE67C:	LD	A,(HL)		;GET BYTE
	SUB	30H		;CONVERT TO 0-4
	CP	0AH		;COMPARE AGAINST ":"
	JR	NC,LE698
	INC	HL
	LD	D,A
	LD	A,B
	CP	1AH
	JR	NC,ERROR
	LD	A,B
	ADD	A,A
	ADD	A,A
	ADD	A,A
	ADD	A,B
	ADD	A,B
	ADD	A,D
	JR	C,ERROR
	LD	B,A
	DEC	C
	JR	NZ,LE67C
	RET
;
LE698:	LD	A,(HL)		;GET BYTE
	CP	' '
	JR	NZ,ERROR
	INC	HL
	DEC	C
	JR	NZ,LE698
	LD	A,B
	RET
;
LE6A3:	LD	H,0
	LD	L,A
LE6A6:	LD	E,0
	LD	BC,10000
	CALL	LE6C3
	LD	BC,1000
	CALL	LE6C3
	LD	BC,100
	CALL	LE6C3
	LD	BC,10
	CALL	LE6C3
	LD	A,L
	JR	LE6D3
;
LE6C3:	LD	A,0FFH
LE6C5:	OR	A
	SBC	HL,BC
	INC	A
	JR	NC,LE6C5
	ADD	HL,BC
	INC	E
	DEC	E
	JR	NZ,LE6D3
	INC	A
	DEC	A
	RET	Z
LE6D3:	ADD	A,30H
	LD	E,01H
	JP	CONOUT
;
LE6DA:	CALL	DLOGIN
;
ERROR:	CALL	CRLF
	LD	HL,(CIPTR)
LE6E3:	LD	A,(HL)
	CP	' '
	JR	Z,LE6F1
	OR	A
	JR	Z,LE6F1
	CALL	CONOUT
	INC	HL
	JR	LE6E3
;
LE6F1:	CALL	PRINT
	DEFB	'?',87H
	JP	RESTRT
;
;Command: DIR
;Function: To display a directory of the files on disk
;
DIR:	CALL	SCANER
	CALL	COMLOG
	PUSH	AF
	CALL	LE44B
	POP	AF
	CALL	LOGIN
	LD	HL,FCBDN
	LD	(HL),0
	INC	HL
	LD	A,(HL)		;GET FIRST CHARACTER OF FILENAME.TYPE
	CP	' '
	JR	NZ,DIR1
FILLQ:	LD	B,0BH		;FILL FCB @HL WITH "?"
FQLP:	LD	(HL),'?'
	INC	HL
	DJNZ	FQLP
DIR1:	CALL	LE436
	LD	(LEB46),A
	INC	HL
	INC	HL
	INC	HL
	LD	E,(HL)		;GET LOW ORDER BYTE
	INC	HL
	LD	D,(HL)		;GET HIGH ORDER BYTE
	INC	DE
	LD	(LEB44),DE	;SET DISC SPACE
	LD	HL,0
	LD	(LEB42),HL	;CLEAR DIR/FILE SIZE
	LD	HL,LEB28
	LD	(HL),'?'
	LD	D,12		;SET LINE COUNT
	LD	A,(LE306)
	DEC	A
	LD	E,A
	PUSH	DE
	CALL	SEARF
	POP	DE
	JR	Z,DIR3
DIR2:	PUSH	AF
	CALL	LE78D
	POP	BC
	LD	A,B
	RET	C
	CALL	LE7A0
	PUSH	DE
	CALL	SEARN
	POP	DE
	JR	NZ,DIR2
DIR3:	CALL	CRLF		;NEW LINE
	LD	HL,(LEB42)	;GET DIR/FILE SIZE
	CALL	LE7FF		;CONVERT INTO SIZE
	CALL	PRINT
	DC	'k Size, '
	LD	DE,(LEB44)	;GET DISC SIZE
	PUSH	DE
	CALL	LE411		;FIND FREE SPACE
	CALL	LE7FF		;CONVERT INTO SIZE
	CALL	PRINT
	DC	'k Free, '
	POP	HL		;GET DISC SIZE
	CALL	LE7FF		;CONVERT INTO SIZE
	CALL	PRINT
	DC	'k Total'
	RET
;
LE78D:	LD	A,(LE306)
	DEC	A
	CP	E		;MATCH?
	RET	NZ
	PUSH	DE
	CALL	CONSTAT
	POP	DE
	RET	C
	DEC	D
	RET	NZ		;LOOP UNTIL 12TH LINE
	LD	D,12		;LINE COUNT
	JP	CONIN		;GET ANY CHAR TO CONTINUE
;
LE7A0:	DEC	A
	AND	03H
	RRCA
	RRCA
	RRCA
	LD	HL,0081H
	ADD	A,L
	LD	L,A
	PUSH	HL
	POP	IX
	BIT	7,(IX+09H)
	RET	NZ
	PUSH	HL
	LD	BC,000FH
	ADD	HL,BC
	LD	B,08H
LE7BA:	LD	A,(HL)
	INC	HL
	OR	(HL)
	INC	HL
	JR	Z,LE7CB
	PUSH	DE
	LD	DE,(LEB42)
	INC	DE
	LD	(LEB42),DE
	POP	DE
LE7CB:	DJNZ	LE7BA
	POP	HL
	LD	A,(IX+0BH)
	OR	A
	RET	NZ
	LD	A,(LE306)
	INC	E
	CP	E
	JR	NZ,LE7E1
	LD	E,0
	CALL	PRMPT
	JR	LE7E6
;
LE7E1:	CALL	PRINT
	DC	' :'
LE7E6:	BIT	7,(IX+08H)	;CHECK IF R/O
	LD	A,20H
	JR	Z,LE7F0
	LD	A,'*'
LE7F0:	LD	B,08H
	PUSH	HL
	CALL	DIRPRN		;PRINT FILE NAME
	LD	A,2EH
	LD	B,03H
	CALL	DIRPRN		;PRINT FILE TYPE
	POP	HL
	RET
;
LE7FF:	LD	A,(LEB46)
	LD	B,A
	JR	LE806
;
LE805:	ADD	HL,HL
LE806:	DJNZ	LE805
	JP	LE6A6
;
;PRINT B CHARS STARTING WITH VALUE IN A
;
DIRPRN:	CALL	CONOUT
DIRPRN1:LD	A,(HL)		;GET NEXT BYTE
	AND	7FH		;RESET TOP BIT
	INC	HL		;POINT TO NEXT BYTE
	CALL	CONOUT
	DJNZ	DIRPRN1		;LOOP UNTIL FINISHED
	RET
;
;Command: ERA
;Function: To erase a file
;
;
ERA:	CALL	SCANER
	CALL	LE51B
	LD	HL,0
	LD	(LEB40),HL
	CALL	SEARF
ERA1:	LD	HL,LEB40
	INC	(HL)
ERA2:	LD	B,(HL)
	PUSH	BC
	LD	DE,FCBDN
	LD	C,11H		;GET FIRST DIRECTORY
	JR	ERA4
;
ERA3:	PUSH	BC
	LD	C,12H		;GET NEXT DIRECTORY
ERA4:	CALL	GRBDOS
	POP	BC
	RET	Z
	DJNZ	ERA3
	LD	E,01H
	CALL	LE7A0
	DEC	HL
	LD	DE,TFCB
	LD	BC,20H
	LDIR
	LD	A,(LEB41)
	OR	A
	JR	NZ,ERA6
	CALL	PRINT		;QUERY DELETE THIS FILE
	DC	'?'
	CALL	CONIN
	RET	C
	AND	05FH		;CONVERT TO UPPER CASE
	CP	'A'		;RESPONSE DELETE ALL FILES
	JR	NZ,ERA5		;NO?
	LD	A,'Y'
	LD	(LEB41),A
ERA5:	CP	'F'		;FINISH?
	RET	Z
ERA6:	CP	'Y'		;RESPONSE ERASE THIS FILE
	JR	NZ,ERA1		;LOOP ROUND FOR NEXT FILE
	XOR	A
	LD	IX,TFCB
	LD	(IX+0CH),A
	LD	(IX+20H),A
	BIT	7,(IX+09H)	;CHECK IF FILE R/O
	RES	7,(IX+09H)
	JR	Z,ERA7		;NOT R/O?
	CALL	PRINT		;QUERY UNLOCK FILE
	DC	' Unlock(Y/N)?'
	CALL	CONIN
	RET	C
	CP	'Y'		;RESPONSE UNLOCK FILE
	JR	NZ,ERA1		;LOOP IF NOT TO UNLOCK
	LD	DE,TFCB
	LD	C,1EH
	CALL	LE3BF
ERA7:	LD	DE,TFCB
	CALL	DELETE
	INC	A
	JR	Z,ERA8
	CALL	PRINT		;FILE ERASED MESSAGE
        DC	TAB,'Erased'
ERA8:	LD	HL,LEB40
	JP	ERA2		;LOOP FOR NEXT FILE
;
;Command: PSW
;Function: To set the password
;
PSW:	CALL	LE526
	LD	DE,FCBFN
	LD	A,(DE)
	SUB	20H
	JR	NZ,PSW_1
	LD	(DE),A
PSW_1:	LD	C,27H
	CALL	BDOS
	OR	A
	JP	NZ,ERROR
	RET
;
;Command: LOCK
;Function: To lock a specified file to R/O
;
LOCK:	CALL	LE902
	SET	7,(IX+09H)
	JR	Z,LOCK2
	CP	53H
	JP	NZ,ERROR
	SET	7,(IX+0AH)
LOCK1:	CALL	SBLANK
LOCK2:	LD	(CIBPTR),DE
	LD	C,1EH
	JP	LE3BC
;
;Command: UNLOCK
;Function: To unlock a specified file to R/W
;
UNLOCK:	CALL	LE902
	RES	7,(IX+09H)
	JR	Z,LOCK2
	CP	53H
	JP	NZ,ERROR
	RES	7,(IX+0AH)
	JR	LOCK1
;
LE902:	CALL	LE518
	LD	DE,(CIBPTR)
	CALL	BLANK1
	LD	IX,FCBDN
	RET
;
;Command: DISP
;Function: To display an ASCII file
;
DISP:	CALL	LE526
	CALL	OPENF
	JR	Z,LE955
	CALL	CRLF
	LD	HL,LEB3F
	LD	(HL),0FFH
DISP1:	LD	HL,LEB3F
	LD	A,(HL)
	CP	128
	JR	C,DISP2
	PUSH	HL
	CALL	READF
	POP	HL
	JR	NZ,DISP3
	LD	(HL),00H
DISP2:	INC	(HL)
	LD	HL,TBUFF
	CALL	ADDAH
	LD	A,(HL)
	CP	1AH		;END OF FILE?
	RET	Z		;RESTART CPR IF SO
	CALL	CONOUT
	CALL	CONSTAT
	RET	C
	JR	DISP1
;
DISP3:	DEC	A
	RET	Z
	CALL	PRINTC		;ERROR MESSAGE
	DC	'Read Error'
LE955:	JP	LE6DA
;
;Command: SAVE
;Function: To save a file startinf at 0100H and of specified length
;
SAVE:	CALL	NUMBER
	PUSH	AF
	CALL	LE518
	LD	DE,FCBDN
	PUSH	DE
	CALL	DELETE		;DELETE ANY OLD FILES
	POP	DE
	CALL	LE3EA
	JR	NZ,SAVE0
	POP	AF
	JR	SAVE3
;
SAVE0:	XOR	A
	LD	(TFCBCR),A
	POP	AF
	LD	L,A
	LD	H,00H
	ADD	HL,HL
	LD	DE,TPA		;POINTER TO START OF SAVE AREA
SAVE1:	LD	A,H		;DONE WITH SAVE?
	OR	L		;HL=0 IF SO
	JR	Z,SAVE2
	DEC	HL		;COUNT DOWN ON SECTORS
	PUSH	HL		;SAVE POINTER TO BLOCK TO SAVE
	LD	HL,128		;128 BYTES PER SECTOR
	ADD	HL,DE		;POINTER TO NEXT SECTOR
	PUSH	HL		;SAVE ON STACK
	CALL	SETDMA		;SET DMA ADDRESS FOR WRITE (ADDRESS IN DE)
	CALL	LE3E3		;WRITE SECTOR
	POP	DE		;GET POINTER TO NEXT SECTOR IN DE
	POP	HL		;GET SECTOR COUNT
	JR	NZ,SAVE3	;WRITE ERROR?
	JR	SAVE1
;
SAVE2:	LD	DE,FCBDN
	CALL	CLOSE
	INC	A		;ERROR?
	JR	NZ,SAVE4
SAVE3:	CALL	PRINTC
        DC	'No Space'
SAVE4:	JP	DEFDMA
;
;Command: REN
;Function: To rename a file
;
REN:	CALL	LE518
	LD	A,(TEMPDR)
	PUSH	AF
	CALL	SEARF
	JR	Z,LEA06
	LD	DE,(CIBPTR)
	CALL	BLANK1
	CP	54H
	JR	NZ,REN4
	INC	DE
	LD	A,(DE)
	CP	4FH
	JR	NZ,REN4
REN1:	EX	DE,HL		;POINTER TO CHAR AFTER "" IN HL
	INC	HL
	LD	(CIBPTR),HL	;SAVE POINTER TO OLD FILE NAME
	XOR	A
	LD	HL,LEB2C
	CALL	LE531
	JR	NZ,REN4
	POP	AF		;GET OLD DEFAULT DRIVE
	LD	B,A		;SAVE IT
	LD	HL,TEMPDR	;COMPARE IT AGAINST CURRENT DEAULT DRIVE
	LD	A,(HL)		;MATCH?
	OR	A
	JR	Z,REN2
	CP	B		;CHECK FOR DRIVE ERROR
	LD	(HL),B
	JR	NZ,REN4
REN2:	LD	(HL),B
	XOR	A
	LD	DE,LEB2C
	LD	(DE),A
	LD	C,11H		;GET CONSOLE STATUS
	CALL	GRBDOS
	JR	NZ,REN5
	LD	DE,FCBDN
	JP	LE3EE		;RENAME FILE
;
REN4:	JP	LE6DA
;
REN5:	CALL	PRINTC
	DC	'File Exists'
	RET
;
LEA06:	POP	AF
	RET
;
;Command: LOAD
;Function: To load a specified file to 0100H
;
LOAD:	CALL	LE526
	CALL	MLA1
	CALL	CRLF
	DEC	HL
	LD	L,H
	LD	H,00H
	CALL	LE6A6
	CALL	PRINT
	DC	' Block(s)'
	RET
;
MLA1:	CALL	OPENF
	CALL	Z,PRNNF
	JR	Z,LEA52
	LD	HL,TPA		;SET START ADDRESS OF MEMORY LOAD
ML2:	PUSH	HL		;SAVE ADDRESS OF NEXT SECTOR
	EX	DE,HL			;.... IN DE
	CALL	SETDMA		;SET DMA ADDRESS FOR LOAD
	CALL	READF		;READ SECTOR
	POP	HL		;GET ADDRESS OF NEXT SECTOR
	JR	NZ,ML3		;READ ERROR OR EOF?
	LD	DE,128		;MOVE 128 BYTES PER SETOR
	ADD	HL,DE		;POINT TO NEXT SECTOR IN HL
	LD	DE,ENTRY	;ENSURE WE DO NOT OVER WRITE CPR
	SBC	HL,DE
	ADD	HL,DE
	JR	C,ML2		;NOT OVER WRITING?
PRNLE:	CALL	PRINTC
	DC	'Mem Full'
LEA52:	POP	AF
	RET
;
ML3	DEC	A		;LOAD COMPLETE
	JR	NZ,PRNLE	;OK IF ZERO
	RET
;
;Command: DRIVE
;Function: To select a specified drive
;
DRIVE:	CALL	NUMBER
LEA5B:	CP	0AH
	JP	NC,ERROR
	LD	(TDRIVE),A
	CALL	SETU0D
	CALL	LOGIN
	JP	LEAEA
;
LEA6C:	LD	A,(FCBFN)
	CP	20H
	JR	NZ,LEA7C
	LD	A,(TEMPDR)
	OR	A
	JR	Z,LEAE4
	DEC	A
	JR	LEA5B
;
LEA7C:	LD	DE,LEB25
	LD	A,(DE)
	CP	20H
	JR	NZ,LEA8D
	EX	DE,HL
	LD	(HL),'C'
	INC	HL
	LD	(HL),'O'
	INC	HL
	LD	(HL),'M'
LEA8D:	CALL	MLA1
;
;Command: GO
;Function: To jump to 0100H
;
GO:	CALL	DLOGIN
	LD	HL,(CIBPTR)
	PUSH	HL
	CALL	SCANER
	LD	HL,TEMPDR
	PUSH	HL
	LD	A,(HL)
	LD	(FCBDN),A
	LD	A,10H
	CALL	LE52E
	POP	HL
	LD	A,(HL)
	LD	(LEB2C),A
	XOR	A
	LD	(TFCBCR),A
	LD	DE,TFCB
	LD	HL,FCBDN
	LD	BC,0021H
	LDIR
	POP	HL
	LD	DE,0081H
LEABF:	LD	A,(HL)
	LD	(DE),A
	OR	A
	JR	Z,LEAC9
	INC	B
	INC	HL
	INC	DE
	JR	LEABF
;
LEAC9:	LD	A,B
	LD	(TBUFF),A
	CALL	CRLF
	CALL	DEFDMA
	CALL	SETUD
	CALL	TPA
	LD	SP,STACK
	CALL	SETU0D
	CALL	LOGIN
	JR	LEAF9
;
LEAE4:	POP	AF
	JR	LEAEA
;
LEAE7:	CALL	DLOGIN
LEAEA:	CALL	SCANER
	LD	A,(FCBFN)
	SUB	20H
	LD	HL,TEMPDR
	OR	(HL)
	JP	NZ,ERROR
LEAF9:	JP	RESTRT
;
;DEFT
	DEFS	32
STACK:	EQU	$
FCBDN	DEFB	00H
FCBFN:	DEFB	00H,00H,00H
LEB20:	DEFB	00H,00H,00H,00H
LEB24:	DEFB	00H
LEB25:	DEFW	0000H
	DEFB	00H
LEB28:	DEFB	00H,00H,00H,00H
LEB2C:	DEFB	00H,00H,00H,00H
LEB30:	DEFB	00H,00H,00H,00H
LEB34:	DEFB	00H,00H,00H,00H
LEB38:	DEFB	00H,00H,00H,00H
TFCBCR:	DEFB	00H
TDRIVE	DEFB	00H
TEMPDR:	DEFB	00H
LEB3F:	DEFB	00H
LEB40:	DEFB	00H
LEB41:	DEFB	00H
LEB42:	DEFB	00H
	DEFB	00H
LEB44:	DEFB	00H,00H
LEB46:	DEFW	0FA00H

LEB48:	JP	LEC11
;
LEB4B:	SBC	A,0D0H
	PUSH	HL
	LD	C,E
	LD	HL,LEC60
	ADD	A,A
	ADD	A,L
	LD	L,A
	JR	NC,LEB58
	INC	H
LEB58:	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	POP	AF
	PUSH	HL
	LD	HL,(LF939)
	RET
;
LEB62:	LD	SP,(LF933)
	RET
;
;LOOK UP TABLE FOR ITP'S  ..NOT USED?
LEB67:	DEFW	0FA03H,0EF6EH  ;/ 00 /
LEB6B:	DEFW	0EE8BH,0EF73H  ;/ 02 /
LEB6F:	DEFW	0FA12H,0FA0FH  ;/ 04 /
LEB73:	DEFW	0EF78H,0EF91H  ;/ 06 /
LEB77:	DEFW	0EF96H,0EEC1H  ;/ 08 /
LEB7B:	DEFW	0EECCH,0EF9BH  ;/ 0A /
LEB7F:	DEFW	0EFA0H,0F305H  ;/ 0C /
LEB83:	DEFW	0F321H,0F497H  ;/ 0E /
LEB87:	DEFW	0F4DFH,0F81CH  ;/ 10 /
LEB8B:	DEFW	0F836H,0F426H  ;/ 12 /
LEB8F:	DEFW	0F5D3H,0F626H  ;/ 14 /
LEB93:	DEFW	0F541H,0F849H  ;/ 16 /
LEB97:	DEFW	0F872H,0F877H  ;/ 18 /
LEB9B:	DEFW	0F2A5H,0F87DH  ;/ 1A /
LEB9F:	DEFW	0F1E8H,0F882H  ;/ 1C /
LEBA3:	DEFW	0F482H,0F887H  ;/ 1E /
LEBA7:	DEFW	0F88EH,0F5C7H  ;/ 20 /
LEBAB:	DEFW	0F613H,0F79FH  ;/ 22 /
LEBAF:	DEFW	0F7CFH,0F8A1H  ;/ 24 /
LEBB3:	DEFW	0FA30H,0EFA6H  ;/ 26 /
LEBB7:	DEFW	0F619H         ;/ 28 /
;
LEBB9:	DEC	A
	LD	HL,DRVERR1
	JR	Z,LEBD4
	DEC	A
	LD	HL,DRVERR5
	JR	Z,LEBD4
	DEC	A
	LD	HL,DRVERR6
	JR	Z,LEBD4
	DEC	A
	LD	HL,DRVERR7
	JR	Z,LEBD4
	LD	HL,DRVERR2
LEBD4:	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	JP	(HL)
;
;DEFT
