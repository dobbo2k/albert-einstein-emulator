;BASE	EQU	0
;WBOOT	EQU	BASE+0000H
;DEFDRV	EQU	BASE+0004H
;BDOS	EQU	BASE+0005H
;TFCB	EQU	BASE+005CH
;TBUFF	EQU	BASE+0080H
;TPA	EQU	BASE+0100H
;CR	EQU	0DH
;LF	EQU	0AH
;TAB	EQU	09H

L00E1	EQU	000E1H
DRVERR1	EQU	0EC03H
DRVERR2	EQU	0EC05H
DRVERR3	EQU	0EC07H
DRVERR4	EQU	0EC09H
DRVERR5	EQU	0EC0BH
DRVERR6	EQU	0EC0DH
DRVERR7	EQU	0EC0FH
LEC11	EQU	0EC11H
LEC60	EQU	0EC60H
LF933	EQU	0F933H		;DEFW
LF939	EQU	0F939H		;DEFW
;LFA30	EQU	0FA30H
LFA68	EQU	0FA68H
;LFA96	EQU	0FA96H

	ORG	0E100H
;
;START UP PARAMETERS
;
LE100:	DEFW	0E100H  	;PT TO START OF LOAD
LE102:	DEFW	0FB00H  	;PT TO END OF LOAD
LE104:	DEFW	0FA00H  	;PT TO BIOS
;
;DRIVE PARAMETERS
;
LE106:	DEFB	00H		;<7:4> 80 TRACK	<3:0> DOUBLE SIDED
	DEFB	0FFH
LE108:	DEFB	04H

LE109:	CALL	RSTFKEY
	LD	A,(LFA30)
	CP	04H
	JP	Z,CPR1		;OK ENTER CPR
DRVSEL0	EQU	01H
	LD	A,DRVSEL0
	OR	A
	OUT	(DRVSEL),A	;SELECT DRIVE 0
	OUT	(RAMROM),A	;SELECT ROM
	JP	L00E1		;BOOT DRIVE

LE11E:	CALL	RSTFKEY
	DEFB	0CFH,0CFH	;MCAL,ZPRM
	DEFB	CR,LF,'TATUNG/XtalDOS'
	DEFB	' 1.31        (C)'
	DC	' 1983 1984'
LE14D:	LD	HL,LFA96
	LD	(LFA68),HL	;RESET COLD BOOT VECTOR
	JP	(HL)
;
;RESET FUNCTION KEY AREA
;
RSTFKEY:PUSH	BC
	XOR	A
	LD	D,80H		;AMMOUNT OF SPACE ALLOCATED
	LD	BC,VSATBL	;PT TO FUNCTION KEY AREA
RSTF1:	DEFB	0CFH,0C3H	;MCAL,ZVROUT
	INC	BC		;SET TO NEXT LOCATION
	DEC	D	
	JR	NZ,RSTF1	;LOOP UNTIL AREA CLEARED
	POP	BC
	RET
;
;SET AREA UP TO CCP ENTRY AREA
;
LE163:	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
	DEFB	0FFH,0FFH,0FFH,0FFH
