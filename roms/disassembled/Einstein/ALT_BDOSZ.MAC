Title	BDOSZ  Ver 1.4
Subttl	Replacement BDOS for CP/M 2.2

; Prepared and rewritten by MWTW 15/11/83
; STAT USR: bug in TENTCH fixed by WJBA 14/06/84
; Bug in 16 bit directory entries fixed by HV 15/08/84
; Modified to allow user selection of directory entry size
;  and version changed to 1.3 by MWTW 12/11/84
; Bug in random write fixed 7/5/85 by MWTW. Version 1.4


;  Selection of 8 or 16 bit directory entries may be automatic
;  if AUTOSIZ is set true. If AUTOSIZ is false, manual selection
;  between 8 and 16 bit entries may be set by setting DIRLRG
;  either false or true respectively. This feature was added to
;  cater for the Tatung Einstein which uses 16 bit entries
;  although the disk has fewer than 256 blocks. In multi-format
;  systems, setting and clearing of bit 2 of location FLAGS may
;  be performed by the BIOS providing AUTOSIZ is set false.

	ASEG
	.Z80

FALSE	EQU 0
TRUE	EQU NOT FALSE

;	INITIALISATION EQUATES
$BDOS	EQU	0DE00H		;BDOS START ADDRESS
$CPM	EQU	0H		;BASE OF CP/M SYSTEM
AUTOSIZ	EQU	TRUE		;AUTO SELECTION OF 8/16 BIT DIRECTORY ENTRIES
DIRLRG	EQU	FALSE		;FALSE IF 8 BIT ELSE TRUE
				; ONLY APPLIES IF AUTOSIZ IS FALSE

;
;	GENERAL EQUATES
$BIOS	EQU	$BDOS+0E00H	;BIOS START ADDRESS
$DBUF	EQU	$CPM+0080H	;DEFAULT BUFFER
REBOOT	EQU	$CPM+0000H	;RE-BOOT ADDRESS
IOBYTE	EQU	$CPM+0003H	;IOBYTE ADDRESS
TPA	EQU	$CPM+0100H	;START OF TRANSIENT PROGRAM AREA
;
;	BIOS JUMP TABLE ADDRESSES
$BCOLD	EQU	$BIOS
$BWARM	EQU	$BIOS+3
$BCONS	EQU	$BIOS+6
$BCONI	EQU	$BIOS+9
$BCONO	EQU	$BIOS+12
$BLSTO	EQU	$BIOS+15
$BPUNC	EQU	$BIOS+18
$BRDRI	EQU	$BIOS+21
$BHOME	EQU	$BIOS+24
$BSELD	EQU	$BIOS+27
$BSETT	EQU	$BIOS+30
$BSETS	EQU	$BIOS+33
$BSETM	EQU	$BIOS+36
$BREAD	EQU	$BIOS+39
$BWRIT	EQU	$BIOS+42
$BLSTS	EQU	$BIOS+45
$BSECT	EQU	$BIOS+48
;
;	OFFSETS INTO FCB
F.DRV	EQU	0		;DRV..DRIVE NUMBER IN B4-0, USER IN B7-5
F.NAM	EQU	1		;NAM..NAME UP TO 8 BYTES (B7 INSIG)
F.TYP	EQU	9		;TYP..NAME EXTENSION
F.EXT	EQU	12		;EXT..EXTENT 0-31..DISK DIFFERENT
F.S1	EQU	13		;S1..UNUSED AT PRESENT
F.S2	EQU	14		;S2..B7 SET IF NOT WRITTEN TO
				;B6-B0 ACTUAL EXTENT OPEN
F.RC	EQU	15		;RC..RECORD COUNT (=128 IF FULL EXTENT)
F.BLKS	EQU	16		;BLKS..16 BYTES OF BLOCK INFORMATION
;
;	ITEMS BELOW DO NOT APPEAR ON DISK
F.CR	EQU	32		;CR..CURRENT RECORD 0-128
F.RRC	EQU	33		;RRC..RANDOM RECORD NO 0-65535 (3 BYTES USED)
;
;	OTHER EQUATES
D.ERAS	EQU	0E5H		;VALUE OF ERASED BYTE
D.DEFD	EQU	$DBUF		;DEFAULT DMA ADDRESS
;
	PAGE	60
;
	ORG	TPA
;
	.PHASE	$BDOS
;
	DEFB	000H,	000H	;Six bytes containing CP/M serial No.
	DEFB	000H,	000H	;(0000-00000) and version No. (2.2)
	DEFB	000H,	000H
;
;	MAJOR ENTRY POINT FOR INTERFACE
IEXENT:
	LD	(SPSAVE),SP	;SAVE USER STACK
	LD	SP,OWNSTK	;SWITCH TO OWN STACK
	PUSH	IX
	PUSH	IY
	LD	IY,OSDATA
	LD	(IPWORD),DE	;SAVE INPUT WORD
	LD	(IY+D.IPB),E	;SAVE BYTE PARAM
	LD	HL,0		;CLEAR REPLY
	LD	(IY+D.DEF),L
	LD	(IREPLY),HL	;IN CASE
	LD	A,C		;GET FUNCTION
	CP	(FJE-FJTAB)/2	;IN RANGE?
	JR	NC,XPOINT
	LD	HL,FJTAB	;PT TO FUNCTION ADDRESSES
	LD	B,0
	ADD	HL,BC		;PT TO F ADDR
	ADD	HL,BC
	LD	C,E
	LD	E,(HL)		;GET IT IN DE
	INC	HL
	LD	D,(HL)
	LD	HL,(IPWORD)	;RESTORE PARAM
	LD	IX,(IPWORD)
	LD	A,(OSDATA+FLAGS)
	AND	SIZBIT
	LD	(OSDATA+FLAGS),A
	EX	DE,HL
	CALL	INDJUMP
XPOINT:
	BIT	DOP,(IY+FLAGS)
	JR	Z,NDSKOP	;J IF NOT
	LD	(IX+F.DRV),0	;CLEAR DRIVE AND USER
	LD	A,(DEFFLG)
	OR	A
	JR	Z,NDSKOP	;J IF NOT
	LD	(IX+F.DRV),A	;RESTORE DRIVE
	LD	A,(SAVDSK)	;RESET DEFAULT DRIVE
	LD	(IPBYTE),A
	CALL	ISELDS		;AND SELECT IT
NDSKOP:
	POP	IY
	POP	IX
	LD	SP,(SPSAVE)	;RESET TO USER STACK
	LD	HL,(IREPLY)	;GET REPLY
	LD	A,L		;AND IN AB
	LD	B,H
	RET			;EXIT
;
INDJUMP:
	JP	(HL)		;AND JUMP TO FUNCTION
;
;	FUNCTION VECTOR TABLE
FJTAB:
	DEFW	$BWARM		;0 - WARM BOOT
	DEFW	ICONIE		;1 - CONSOLE INPUT
	DEFW	ICONOP		;2 - CONSOLE OUTPUT
	DEFW	IRDRIN		;3 - READER INPUT
	DEFW	$BPUNC		;4 - PUNCH OUTPUT
	DEFW	$BLSTO		;5 - LIST OUTPUT
	DEFW	IDIRIO		;6 - DIRECT CONSOLE I/O
	DEFW	IGETIO		;7 - GET I/O BYTE VALUE
	DEFW	ISETIO		;8 - SET I/O BYTE VALUE
	DEFW	IPUTST		;9 - OUTPUT STRING TO CONSOLE
	DEFW	IGETLI		;10- GET BUFFERED CONSOLE INPUT
	DEFW	ICONST		;11- GET CONSOLE STATUS/INPUT
	DEFW	IGVERS		;12- GET VERSION NO
	DEFW	IRESET		;13- RESET DISK SYSTEM
	DEFW	ISELDS		;14- SELECT DISK
	DEFW	IOPENF		;15- OPEN FILE FOR I/O
	DEFW	ICLOSF		;16- CLOSE FILE
	DEFW	ISFIRS		;17- SEARCH FOR FIRST
	DEFW	ISNEXT		;18- SEARCH FOR NEXT
	DEFW	IDELEF		;19- DELETE FILE
	DEFW	IRDSQN		;20- READ SEQUENTIAL
	DEFW	IWRSQN		;21- WRITE SEQUENTIAL
	DEFW	IMAKEF		;22- MAKE (CREATE) FILE
	DEFW	IRENAF		;23- RENAME FILE
	DEFW	IGLONV		;24- GET LOGGED ON DISK VECTOR
	DEFW	IGCDSK		;25- GET CURRENT DISK
	DEFW	ISETDM		;26- SET TRANSFER ADDRESS
	DEFW	IGALOV		;27- GET ALLOCATION VECTOR ADDRESS
	DEFW	ISETRO		;28- SET DISK READ ONLY
	DEFW	IGRODV		;29- GET READ ONLY DISK VECTOR
	DEFW	ISETAT		;30- SET FILE ATTRIBUTES
	DEFW	IGDPAD		;31- GET DISK PARAM BLOCK ADDRESS
	DEFW	IGSUSR		;32- GET/SET CURRENT USER
	DEFW	IRDRAN		;33- READ RANDOM
	DEFW	IWRRAN		;34- WRITE RANDOM
	DEFW	IFILSZ		;35- CALCULATE RANDOM FILE SIZE
	DEFW	ISETRA		;36- SET RANDOM RECORD
	DEFW	IRESDS		;37- RESET DISK
	DEFW	IEXIT		;38- MP/M ONLY
	DEFW	IEXIT		;39- MP/M ONLY
	DEFW	IWRRAZ		;40- WRITE RANDOM WITH ZERO FILL
FJE:
;
;	SET IOBYTE
ISETIO:
	LD	A,C
	LD	(IOBYTE),A
	RET
;
;	GET NEXT CHAR FROM CONSOLE
GNCHAR:
	LD	HL,CHSAVE	;PT TO PREV CHAR IF ANY
	LD	A,(HL)		;GET IT
	LD	(HL),0		;CLEAR PREV
	OR	A		;ANY PREVIOUS CHAR?
	RET	NZ		;RET IF THERE WAS
	JP	$BCONI		;ELSE GET THE NEXT ONE
;
;	GET CHAR AND ECHO ON CONSOLE
GNECHO:
	CALL	GNCHAR		;GET A CHAR
	CALL	CMPCHC		;TEST IF KNOWN CONTROL CHAR
	RET	C		;RETURN IF UNKNOWN
	PUSH	AF		;SAVE CHAR
	LD	C,A		;GET IN C
	CALL	ICONOP		;OUTPUT IT
	POP	AF		;RESTORE
	RET			;AND EXIT
;
;	TEST IF KNOWN CONTROL CHARACTER
CMPCHC:
	CP	00DH
	RET	Z
	CP	00AH
	RET	Z
	CP	009H
	RET	Z
	CP	008H
	RET	Z
	CP	020H
	RET
;
;	TEST IF CONSOLE READY
TCIRDY:
	LD	A,(CHSAVE)	;GET SAVED CHAR IF ANY
	OR	A		;TEST IT
	JR	NZ,CIRDY	;J IF ONE SAVED
	CALL	$BCONS		;TEST STATUS OF CONSOLE
	AND	001H		;ONE THERE?
	RET	Z		;RET IF NOT
	CALL	$BCONI		;GET THE CHAR
	CP	013H		;IS IT CTRL/S?
	JR	NZ,SAVNXC	;J IF NOT TO SAVE IT
	CALL	$BCONI		;WAIT FOR NEXT CHAR
	CP	003H		;ABORT?
	JP	Z,REBOOT	;J IF SO
 	XOR	A		;PRETEND NONE THERE
	RET			;AND EXIT
;
SAVNXC:
	LD	(CHSAVE),A	;SAVE THE CHAR FOR LATER
CIRDY:
	LD	A,001H		;SET READY REPLY
	RET			;AND EXIT
;
;	REMOVE PREV CHAR BY BACKSPACING
BSSPBS:
	CALL	OPBSP		;OUTPUT BACKSPACE
	LD	C,020H		;FOLLOWED BY
	CALL	$BCONO		;SPACE
OPBSP:
	LD	C,008H		;AND ANOTHER BACKSPACE
	JP	$BCONO
;
;	CANCEL INPUT
KILLIN:
	LD	C,'#'		;PUT OUT # TO INDICATE CANCEL
	CALL	PUTCH
	CALL	OPCRLF		;GO TO NEW LINE
;	REPOSITION CURSOR AT START OF OLD LINE
POSCUR:
	LD	A,(LCUPOS)	;GET CURRENT POSITION
	CP	(IY+D.LST)	;SAME?
	RET	NC		;EXIT IF BEYOND START
	LD	C,020H		;SPACEFILL UP TO POS
	CALL	PUTCH
	JR	POSCUR
;
;	TYPE STRING TERMINATED WITH '$'
IPUTST:
	LD	C,E		;GET IN BC
	LD	B,D
;
;	OUTPUT STRING TERMINATED BY '$'
PUTSTR:
	LD	A,(BC)		;GET A CHAR
	CP	'$'		;END?
	RET	Z		;EXIT IF SO
	INC	BC		;PT TO NEXT
	PUSH	BC		;SAVE PTR
	LD	C,A		;OUTPUT CHAR
	CALL	ICONOP		;TO CONSOLE
	POP	BC		;RESTORE PTR
	JR	PUTSTR		;AND REPEAT
;
;	GET BUFFER LINE FROM CONSOLE WITH EDITING
IGETLI:
	LD	A,(LCUPOS)	;GET CURRENT LINE POSITION
	LD	(LSTPOS),A	;AND SAVE AS START POS
	LD	HL,(IPWORD)	;GET PARAM (PTR TO BUFFER AREA)
	LD	C,(HL)		;GET MAXIMUM LENGTH
	INC	HL		;PT TO REPLY LENGTH
	PUSH	HL		;SAVE PTR
	LD	B,0		;START AT ZERO CHARS
GLIREP:
	PUSH	BC		;SAVE CURRENT/MAX LENGTHS
	PUSH	HL		;AND LINE PTR
GLICH:
	CALL	GNCHAR		;GET A CHAR FROM CONSOLE
	AND	07FH		;STRIP PARITY
	POP	HL		;RESTORE PTR
	POP	BC		;AND LENGTHS
	CP	00DH		;IS IT RETURN (ENTER)?
	JP	Z,GLIFIN	;FINISH IF SO
	CP	00AH		;IS IT LINE FEED?
	JP	Z,GLIFIN	;SAME.. FINISH IF SO
	CP	008H		;IS IT BACKSPACE
	JR	NZ,TRYRUB	;J IF NOT
	LD	A,B		;GET CURRENT LENGTH
	OR	A		;TEST IT
	JR	Z,GLIREP	;IGNORE IF ZERO LENGTH
	DEC	B		;BACK OFF ONE CHAR
	LD	A,(LCUPOS)	;GET CURRENT POSITION
	LD	(FLDEOP),A	;MARK NO PRINTER ECHO/STOP TEST
	JR	REDLIN		;AND RE OUTPUT LINE
;
TRYRUB:
	CP	07FH		;IS IT RUBOUT
	JR	NZ,TRYNL	;J IF NOT
	LD	A,B		;GET CURRENT LENGTH
	OR	A		;TEST IT
	JR	Z,GLIREP	;IGNORE IF EMPTY LINE
	LD	A,(HL)		;GET THE CURRENT CHAR (LAST)
	DEC	B		;BACK OFF LENGTH
	DEC	HL		;BACK OFF PTR
	JR	GLIOP		;AND O/P PREV CHAR
;
TRYNL:
	CP	005H		;IS IT CTRL/E (NEWLINE..NO ENTER)
	JR	NZ,TRYLIF	;J IF NOT
	PUSH	BC		;SAVE LENGTHS
	PUSH	HL		;AND PTR
	CALL	OPCRLF		;GO TO NEW LINE
	XOR	A		;SET START OF ZERO
	LD	(LSTPOS),A
	JR	GLICH		;AND CONTINUE
;
TRYLIF:
	CP	010H		;IS IT CTRL/P (PRINTER ECHO)
	JR	NZ,TRYCAN	;J IF NOT
	PUSH	HL		;SAVE THE PTR
	LD	HL,FLLSTE	;PT TO LIST ECHO FLAG
	LD	A,001H		;INVERT STATE
	SUB	(HL)
	LD	(HL),A		;AND PUT BACK
	POP	HL		;RESTORE PTR
	JR	GLIREP		;AND CONTINUE
;
TRYCAN:
	CP	018H		;IS IT CTRL/X (CANCEL)
	JR	NZ,TRYU		;J IF NOT
	POP	HL		;RESTORE PTR
CLRLIN:
	LD	A,(LSTPOS)	;GET THE START POSITION
	LD	HL,LCUPOS
	CP	(HL)		;SAME?
	JR	NC,IGETLI	;J IF BEFORE START
	DEC	(HL)		;BACK OFF CURRENT
	CALL	BSSPBS		;STEP BACK CONSOLE TO CLEAR
	JR	CLRLIN		;AND REPEAT
;
TRYU:
	CP	015H		;IS IT CTRL/U (KILL LINE)
	JR	NZ,TRYRED	;J IF NOT
	CALL	KILLIN		;KILL CURRENT LINE
	POP	HL		;RESTORE I/P PARAM
	JR	IGETLI		;AND RESTART
;
TRYRED:
	CP	012H		;IS IT CTRL/R (RE-TYPE LINE)
	JR	NZ,GLISTO	;J IF NOT
REDLIN:
	PUSH	BC		;SAVE LENGTHS
	CALL	KILLIN		;KILL CURRENT LINE
	POP	BC		;RESTORE
	POP	HL		;BACK TO ORIG PTR
	PUSH	HL		;SAVE AGAIN
	PUSH	BC		;AND SAVE LENGTHS
PUTLIC:
	LD	A,B		;GET CURRENT LENGTH
	OR	A		;TEST IT
	JR	Z,GLIBAK	;J IF EMPTY
	INC	HL		;PT TO CHAR
	LD	C,(HL)		;GET IT
	DEC	B		;ONE LESS CHAR TO GO
	PUSH	BC		;SAVE LENGTHS
	PUSH	HL		;AND PTR
	CALL	OPCH		;RE-OUTPUT CHARACTER
	POP	HL		;RESTORE
	POP	BC
	JR	PUTLIC		;AND REPEAT
;
GLIBAK:
	PUSH	HL		;SAVE PTR
	LD	A,(FLDEOP)	;GET FLAG
	OR	A		;TEST IT
	JP	Z,GLICH		;J IF ZERO
	LD	HL,LCUPOS	;PT TO CURRENT POS
	SUB	(HL)
	LD	(FLDEOP),A	;PUT BACK
GLIBSB:
	CALL	BSSPBS		;REMOVE PREVIOUS CHAR
	LD	HL,FLDEOP
	DEC	(HL)		;BACK OFF ONE
	JR	NZ,GLIBSB	;REPEAT UNTIL DONE
	JP	GLICH		;THEN CONTINUE
;
GLISTO:
	INC	HL		;PT TO NEXT BUFFER POS
	LD	(HL),A		;SAVE THE CHAR
	INC	B		;UP CURRENT LENGTH
GLIOP:
	PUSH	BC		;SAVE LENGTHS
	PUSH	HL		;AND PTR
	LD	C,A		;GET THE I/P CHAR
	CALL	OPCH		;OUTPUT IT
	POP	HL		;RESTORE
	POP	BC
	LD	A,(HL)		;RESTORE CHAR
	CP	003H		;WAS IT CTRL/C (ABORT)
	LD	A,B		;GET LENGTH
	JR	NZ,GLINAB	;J IF NOT ABORT
	CP	001H		;IS IT THE ONLY CHAR
	JP	Z,REBOOT	;REBOOT IF SO
GLINAB:
	CP	C		;TEST MAX LENGTH
	JP	C,GLIREP	;J IF NOT EXCEEDED
GLIFIN:
	POP	HL		;RESTORE I/P PTR
	LD	(HL),B		;SAVE ACTUAL LENGTH
	LD	C,00DH		;INDICATE ACCEPTED
	JR	PUTCH		;AND EXIT
;
;	OUTPUT A CR/LF TO CONSOLE
OPCRLF:
	LD	C,00DH
	CALL	PUTCH
	LD	C,00AH
;
;	PUT CHAR ON CONSOLE
PUTCH:
	LD	A,(FLDEOP)	;DIRECT O/P?
	OR	A
	JR	NZ,UPLPOS	;J IF SO
	PUSH	BC		;SAVE CURRENT BC
	CALL	TCIRDY		;TEST IF ANY KEY PRESSED
	POP	BC		;RESTORE
	PUSH	BC		;SAVE AGAIN
	CALL	$BCONO		;OUTPUT IT
	POP	BC		;RESTORE
	PUSH	BC		;SAVE
	LD	A,(FLLSTE)	;LIST FLAG ON?
	OR	A
	CALL	NZ,$BLSTO	;PRINT IF IT IS
	POP	BC		;RESTORE CHAR
;	WORK OUT POSITION OF CURSOR
UPLPOS:
	LD	A,C		;GET THE CHAR
	LD	HL,LCUPOS	;PT TO CURRENT POSITION
	CP	07FH		;RUB?
	RET	Z		;OUT IF SO
	INC	(HL)		;UP BY ONE CHAR
	CP	020H		;CONTROL CHAR?
	RET	NC		;RETURN IF NOT
	DEC	(HL)		;BACK OFF POS
	RET	Z		;RET IF START OF LINE
	LD	A,C		;GET CHAR
	CP	008H		;BACK SPACE?
	JR	NZ,TIFLF	;J IF NOT
	DEC	(HL)		;BACK OFF 1
	RET			;AND EXIT
;
TIFLF:
	CP	00AH		;LINE FEED?
	RET	NZ		;RETURN IF NOT
	LD	(HL),0		;RESET TO START OF LINE
	RET			;AND EXIT
;
;	OUTPUT CHAR ALLOWING FOR TABS
OPCH:
	LD	A,C		;GET THE CHAR
	CALL	CMPCHC		;TEST IF A CONTROL
	JR	NC,ICONOP	;J IF NOT TO O/P IT
	PUSH	AF		;SAVE IT
	LD	C,05EH		;GET AN ARROW
	CALL	PUTCH		;AND O/P IT
	POP	AF		;RESTORE CHAR
	OR	040H		;MAKE LETTER
	LD	C,A		;TO C
;	OUTPUT CHAR IN C TO CONSOLE
ICONOP:
	LD	A,C		;GET THE CHAR
	CP	009H		;IS IT TAB
	JR	NZ,PUTCH	;J IF NOT
TABOP:
	LD	C,020H		;GET A SPACE
	CALL	PUTCH		;AND O/P IT
	LD	A,(LCUPOS)	;GET CURRENT POSITION
	AND	007H		;TEST LS 3 BITS
	JR	NZ,TABOP	;CONTINUE UNTIL ZERO
	RET
;
;	CONSOLE INPUT WITH ECHO
ICONIE:
	CALL	GNECHO		;GET AND ECHO CHAR
	JR	IREPEX		;AND EXIT
;
;	READER INPUT
IRDRIN:
	CALL	$BRDRI		;CALL BIOS READER
	JR	IREPEX		;AND EXIT
;
;	DIRECT CONSOLE I/O
IDIRIO:
	LD	A,C		;GET THE PARAMETER
	INC	A		;TEST IT
	JR	Z,ICONIQ	;J IF INPUT REQD
	INC	A		;TEST AGAIN
	JP	NZ,$BCONO	;O/P CHAR IF REQUIRED
	CALL	$BCONS		;ELSE GET STAUS
	JR	IREPEX
;
ICONIQ:
	CALL	$BCONS		;TEST CONSOLE STATUS
	OR	A
	JR	Z,IREPEX	;J IF NOT READY
	CALL	$BCONI		;GET THE CHAR
	JR	IREPEX		;AND REPLY WITH IT
;
ICONST:
	CALL	TCIRDY		;TEST IF CONSOLE READY
IREPEX:
	LD	(IREPLY),A	;SAVE REPLY
IEXIT:
	RET			;AND EXIT
;
;	GET IOBYTE CONTENTS
IGETIO:
	LD A,(IOBYTE)
	JR	IREPEX
;
;	GET VERSION NO.
IGVERS:
	LD	A,22H		;SET TO 2.2
	JR	IREPEX
;
;	GET CURRENT DISK
IGCDSK:
	LD	A,(CURDRV)	;GET THE DRIVE NO
	JR	IREPEX		;AND REPLY
;
;	GET/SET USER CODE
IGSUSR:
	LD	A,E		;GET THE PARAMETER
	CP	0FFH		;IS IT SET CODE?
	JR	NZ,STUSER	;J IF IT IS
	LD	A,(CURUSR)	;GET THE CURRENT VALUE
	JR	IREPEX		;AND REPLY
;
STUSER:
	AND	01FH		;MASK THE USER NO
	LD	(CURUSR),A
	RET
;
;	RENAME FILE
IRENAF:
	CALL	TCBDRV		;SET UP DRIVE
	CALL	RNFILE		;RENAME FILE
;	SET REPLY FOR DIRECTORY LOOK UP
DIREPY:
	XOR	A
	BIT	IOP,(IY+FLAGS)
	JR	Z,IREPEX
	LD	A,0FFH
	JR	IREPEX
;
;	DELETE FILE
IDELEF:
	CALL	TCBDRV		;SET UP DRIVE
	CALL	DEFILE		;DELETE THE FILE
	JR	DIREPY
;
;	SET ATTRIBUTES OF FILE
ISETAT:
	CALL	TCBDRV		;SET UP DRIVE
	CALL	SETATB		;SET THE ATTRIBUTES
	JR	DIREPY
;
;	FAILED TO FIND ENTRY REQUIRED
FFFAIL:
	CALL	STRTDI		;RESET ENTRY NO
	LD	A,0FFH		;MARK FAILED
	JR	IREPEX		;AND EXIT
;
;	FIND A FILE/EXTENT
FINDFI:
	SET	IOP,(IY+FLAGS)
	LD	(IY+D.SLN),C	;SET AS REQUIRED
	LD	HL,(IPWORD)	;GET FCB ADDR
	LD	(SVFCBA),HL	;AND SAVE
	CALL	STRTDI		;RESET TO START OF DIRECTORY
	CALL	$BHOME		;ENSURE CLEAN DISK BY RESTORE
GETFIE:
	LD	C,0		;MARK READ ACCESS
	CALL	NXTDIE		;AND GET ENTRY
	CALL	TSTEDI		;TEST IF IN RANGE
	JR	Z,FFFAIL	;J IF NOT TO NOT-FOUND (what?)
	LD	DE,(SVFCBA)	;RESTORE FCB PTR
	LD	A,(DE)		;GET THE DISK NO/USER
	CP	0E5H		;LOOKING FOR ERASED?
	JR	Z,NORNGC	;J IF WE ARE
	PUSH	DE		;SAVE FCB ADDR
	CALL	TENTNO		;TEST IF PAST DIR END
	POP	DE		;RESTORE FCB
	JR	NC,FFFAIL	;J IF SO TO FAIL
NORNGC:
	CALL	PTOENT		;PT TO ENTRY FOUND
	LD	B,(IY+D.SLN)
	LD	C,0		;INIT POSITION COUNTER
TENTCH:
	LD	A,B
	OR	A
	JR	Z,ENTFND
	LD	A,(DE)		;GET THE FCB BYTE
	CP	'?'		;IS IT '?'
	JR	Z,FFNXEN	;J IF SO SINCE ALL MATCH
	LD	A,C		;GET OFFSET REACHED IN ENTRY
	CP	F.S1		;IS IT S1
	JR	Z,FFNXEN	;J IF SO TO IGNORE S1
	CP	F.EXT		;IS IT EXTENT?
	LD	A,(DE)		;RESTORE RCB VALUE
	JR	Z,EXTTST	;J IF SO TO DO TEST OF EXTENT
	SUB	(HL)		;TEST AGAINST ENTRY VALUE
	AND	07FH		;IGNORE ATTRIBUTE BIT
	JR	NZ,GETFIE	;J IF NOT SAME
	JR	FFNXEN		;ELSE CARRY ON TESTING
;
;	TEST IF SAME EXTENT
EXTTST:
	PUSH	BC		;SAVE OFFSET AND LENGTH
	LD	C,(HL)		;GET ENTRY EXTENT
	PUSH	AF		;AND CONVERT TO REAL ONE
	LD	A,(DPEXM)	;GET THE EXTENT MASK
	CPL			;FORM MASK FOR ACT EXT NO.
	LD	B,A		;TO B
	LD	A,C		;GET EXTENT
	AND	B		;FIND REAL ONE
	LD	C,A		;AND SAVE
	POP	AF		;RESTORE OTHER EXTENT
	AND	B		;MASK IT
	SUB	C		;TEST AGAINST STORED
	AND	01FH		;MAKE MAX VALUE
	POP	BC		;RESTORE LENGTH/OFFSET
	JR	NZ,GETFIE	;J IF NOT THE SAME
FFNXEN:
	INC	DE		;BUMP FCB PTR
	INC	HL		;AND ENTRY PTR
	INC	C		;UP OFFSET
	DEC	B
	JR	TENTCH
;
;	FOUND MATCHING ENTRY
ENTFND:
	LD	A,(DIRENO)	;GET THE ENTRY NO
	AND	003H		;GET OFFSET
	LD	(IREPLY),A	;AS REPLY
	RES	IOP,(IY+FLAGS)
	RET
;
;	SELECT DISK FOR NEXT OPERATION
SELECD:
	LD	C,(IY+D.DRV)	;TO C
	CALL	$BSELD		;SELECT VIA BIOS
	LD	A,H		;TEST REPLY (DPE ADDRESS)
	OR	L
	RET	Z		;BAD SELECT IF ZERO REPLY
	LD	DE,XLTAD	;HL points to dpbase (trans)
	LD	BC,2
	LDIR
	LD	(NOOFDB),HL
	LD	BC,DPHEND-XLTAD-2
	LDIR
	LD	HL,(DPBAD)	;GET PTR TO DISK PARAM BLOCK
	LD	DE,DPSEC	;PT HL AT IMAGE AREA
	LD	BC,DPBEND-DPSEC	;COUNT OF 15
	LDIR
	IF AUTOSIZ
	LD	A,(DPSIZ+1)	;TEST MS BYTE
	RES	LRG,(IY+FLAGS)
	OR	A
	JR	Z,SMLSEL	;J IF SMALL ( < 256 BLOCKS )
	SET	LRG,(IY+FLAGS)
	ENDIF
SMLSEL:
	LD	A,0FFH		;MARK SELECT OK
	OR	A
	RET			;AND EXIT
;
;	READ A SECTOR
RDSECT:
	CALL	$BREAD		;DO THE READ USING PARAMS SET UP ALREADY
	OR	A
	RET	Z
	LD	DE,RDERR	;DISK READ ERROR
	JR	TRWOK
;
;	WRITE A SECTOR
WRSECT:
	CALL	$BWRIT		;DO THE WRITE
	OR	A		;READ/WRITE OK?
	RET	Z		;EXIT IF SO
	LD	DE,WRERR	;DISK WRITE ERROR
TRWOK:
	LD	BC,$DISK
	LD	HL,$NULL
	CALL	ERMDSK
	CP	3		;^C?
	JP	Z,$BWARM
	LD	A,-1
	RET
;
;	CONVERT DIRECTORY ENTRY NO TO TRK/SECT
CVENTN:
	LD	HL,(DIRENO)	;GET CURRENT ENTRY NO
	LD	B,3		;OUST OFFSET INTO RECORD
	CALL	HLSRB		;BY SHIFTING
	LD	(REQSEC),HL	;SAVE AS REQUIRED INTERNAL SECTOR
	LD	(DIRSEC),HL	;AND LAST DIRECTORY SECTOR
;	GENERAL CONVERSION TO TRK/SECT
CVISTS:
	LD	B,0		;SET SHIFT COUNT
	LD	HL,(DPSEC)
	JR	NORMT		;TO TEST NORMALIZE
NORML:
	INC	B		;UP COUNT OF SHIFTS
	ADD	HL,HL		;AND SHIFT HL LEFT
NORMT:
	BIT	7,H		;NORMALISED?
	JR	Z,NORML		;LOOP IF NOT
	EX	DE,HL		;GET DIVISOR TO DE
	LD	HL,(REQSEC)	;GET DIVIDEND IN HL
	XOR	A		;CLEAR QUOTIENT
	LD	C,A
	INC	B		;1 MORE SHIFT
DIVL:
	OR	A		;CLEAR CARRY
	SBC	HL,DE		;TRY SUBTRACT
	JR	NC,QUOT1	;J IF SUCCESS
	ADD	HL,DE		;RESTORE REMAINDER
	SLA	C		;SHIFT IN ZERO
	JR	RESQUO
QUOT1:
	SCF
	RL	C		;SHIFT IN ONE
RESQUO:
	RLA			;TO QUOTIENT
	SRL	D		;ADJUST DIVISOR
	RR	E
	DJNZ	DIVL		;AND LOOP UNTIL ALL DONE
	LD	B,A		;SET QUOTIENT IN BC
	PUSH	HL		;SAVE REMAINDER (SECTOR)
	LD	HL,(DPSYS)	;FORM TRACK NO
	ADD	HL,BC
	LD	B,H		;GET IN BC
	LD	C,L
	CALL	$BSETT		;SELECT TRACK
	POP	BC		;RESTORE SECTOR NUMBER
	LD	DE,(XLTAD)	;PTR TO TRANSLATE TABLE
	CALL	$BSECT		;TRANSLATE SECTOR
	LD	C,L
	LD	B,H		;GET IN BC
	JP	$BSETS		;SET SECTOR AND EXIT
;
;	CALCULATE OFFSET IN FCB OF REQD RECORD
CVRTOS:
	LD	B,(IY+D.BSH)	;GET SHIFT FACTOR
	LD	A,(IX+F.CR)	;GET CURRENT RECORD NO
SRREC:
	SRL	A
	DJNZ	SRREC
	LD	C,A		;SAVE IN C
	LD	A,008H		;CALC 8 - SHIFT FACTOR
	SUB	(IY+D.BSH)
	LD	B,A		;TO B
	LD	A,(IX+F.EXT)	;GET THE CURRENT EXTENT
	AND	(IY+D.EXM)
	JR	SLEXT
SLEXT1:
	ADD	A,A
SLEXT:
	DJNZ	SLEXT1
	ADD	A,C		;ADD THE SHIFTED BLOCK FACTOR
	RET			;AND EXIT
;
;	EXTRACT THE REQUIRED BLOCK NO FROM THE FCB
GETBLK:
	PUSH	IX
	ADD	IX,BC		;ADD OFSET IN AREA
	BIT	LRG,(IY+FLAGS)
	JR	NZ,BLKWD	;J IF WORDS
	LD	L,(IX+F.BLKS)	;GET THE BLOCK NO
	LD	H,0		;TO HL
	POP	IX
	RET			;AND RETURN
;
BLKWD:
	ADD	IX,BC		;DOUBLE UP OFFSET **HV** WAS ADD HL,BC
	LD	L,(IX+F.BLKS)
	LD	H,(IX+F.BLKS+1)
	POP	IX
	RET			;AND EXIT
;
;	GET THE CURRENT BLOCK NO FROM THE FCB
GCURBL:
	CALL	CVRTOS		;CONVERT RECORD NUM TO OFFSET
	LD	C,A		;GET IN BC
	LD	B,0
	CALL	GETBLK		;GET BLOCK NO FROM FCB
	LD	(REQSEC),HL	;SAVE AS REQUIRED BLOCK
	LD	A,H
	OR	L		;SET Z IF UNALLOCATED
	RET			;AND EXIT
;
;	CONVERT BLOCK NO TO INTERNAL SECTOR NO
CALCSN:
	LD	B,(IY+D.BSH)	;GET THE SHIFT FACTOR
	LD	HL,(REQSEC)	;GET REQD BLOCK
MKISEC:
	ADD	HL,HL		;SHIFT LEFT
	DJNZ	MKISEC		;ADJUSTED
	LD	(BLSEC),HL	;SAVE INTERNAL SECTOR NO
	LD	A,(IX+F.CR)	;GET CURRENT RECORD NO
	AND	(IY+D.MSK)	;MASK FOR OFFSET
	OR	L		;PUT IN ADJUSTED VALUE
	LD	L,A
	LD	(REQSEC),HL	;AND SAVE INT SECTOR NO REQD
	RET
;
;	SHIFT HL RIGHT [B] TIMES
HLSR:
	SRL	H
	RR	L
HLSRB:
	DJNZ	HLSR
	RET
;
;	SET BIT [CURRENT DISK] IN A VECTOR
SVECTB:
	LD	A,(IY+D.DRV)	;GET CURRENT DRIVE NO
	LD	HL,00001H	;BIT 0 SET TO START
	OR	A
	JR	Z,SVECT2
SVECT1:
	ADD	HL,HL
	DEC	A
	JR	NZ,SVECT1
SVECT2:
	LD	A,C		;AND SET THE BIT IN IT
	OR	L
	LD	L,A
	LD	A,B
	OR	H
	LD	H,A
	RET
;
;	TEST IF CURRENT DRIVE IS READ-ONLY
TSTROV:
	LD	HL,(ROVEC)	;GET THE READ ONLY VECTOR
	LD	B,(IY+D.DRV)	;GET CURRENT DRIVE
	INC	B
	CALL	HLSRB		;GET BIT INTO B0
	BIT	0,L
	RET			;AND EXIT
;
;	SET DISK READ ONLY
ISETRO:
	LD	C,(IY+D.ROV)	;GET IN BC
	LD	B,(IY+D.ROV+1)
	CALL	SVECTB		;SET THE VECTOR BIT
	LD	(ROVEC),HL	;AND SAVE BACK
	LD	HL,(DPDIR)	;SET NO OF ENTRIES IN DIR
	INC	HL		;TO MAXIMUM VALUE
	EX	DE,HL
	LD	HL,(NOOFDB)	;SAVE IN STORAGE AREA
	LD	(HL),E
	INC	HL
	LD	(HL),D
	RET
;
;	TEST IF FILE IS READ ONLY
TSTROF:
	CALL	PTOENT		;PT TO FILE ENTRY IN DIRECTORY RECORD
TSTROB:
	LD	DE,TSAVE
	PUSH	DE
	LD	BC,15
	LDIR			;COPY ENTRY TO TEMP FCB
	POP	HL		;RESTORE POINTER
	PUSH	HL
	LD	DE,F.TYP	;OFFSET OF R/O ATTRIBUTE
	ADD	HL,DE		;PT TO IT IN ENTRY
	BIT	7,(HL)
	POP	BC
	JR	Z,RSFUNC3
	RES	7,(HL)		;RESET R/O BIT IN TEMP FCB
	LD	(IPWORD),BC	;CHANGE INPUT PARAMETER TO TEMP FCB
	LD	HL,(DIRENO)	;GET CURRENT ENTRY POINTER
	PUSH	HL		;AND SAVE IT
	LD	A,(IY+D.SLN)
	LD	(SLTH),A
	LD	C,F.EXT
	CALL	FINDFI		;FIND ANY OCCURENCE OF FILE
	LD	HL,(DIRENO)	;ENTRY FOR FOUND FILE
	POP	DE
	OR	A
	SBC	HL,DE		;ARE THEY THE SAME?
	JR	NZ,RSFUNC1	;IF NOT THEN EARLIER ENTRY FOUND
	LD	BC,$FILE	;FILE IS R/O
	CALL	PUTSTR		;OUTPUT "File "
	CALL	PTOENT		;POINT TO DIRECTORY ENTRY
	INC	HL
	LD	B,8
	CALL	FNAME		;PRINT FILENAME
	PUSH	HL
	LD	C,"."
	CALL	ICONOP
	POP	HL
	LD	B,3
	CALL	FNAME		;PRINT FILETYPE
	LD	BC,WPERR
	LD	DE,DOIT
	CALL	ERMESS
	CP	"Y"
	JR	Z,TST1
	CP	03		;^C?
	JP	Z,$BWARM
	JR	RSFUNC1		;RESTORE PARAMETERS AND RETURN
;
TST1:	CALL	SETATB		;SET FILE R/W
;
RSFUNC2:
	CALL	RSFUNC1		;RESET PARAMETERS
	LD	D,A
	LD	E,A
RSFUNC3:
	LD	A,0FFH
	OR	A
	RET
;
;	RESTORE ENTRY PARAMETERS
RSFUNC1:
	LD	C,F.EXT+1
	CALL	FINDFI
	LD	(IPWORD),IX
	LD	(SVFCBA),IX
	LD	A,(SLTH)
	LD	(IY+D.SLN),A
	XOR	A
	RET
;
;	DUMMY FCB FOR CURRENTLY ADDRESSED DIRECTORY ENTRY
TSAVE:
	DEFB	0,0,0,0
	DEFB	0,0,0,0
	DEFB	0,0,0,0
	DEFB	0,0,0
;
;	TEST IF DRIVE IS READ ONLY
CHKWOK:
	CALL	TSTROV		;TEST R/O VECTOR
	RET	Z		;RETURN IF NOT R/O
	LD	HL,DOIT
	LD	DE,WPERR
	LD	BC,$DISK
	CALL	ERMDSK
	CP	"Y"
	JP	NZ,$BWARM
	JR	DOC1
;
;	REQUEST DISK CHANGE
DOCHNG:
	LD	BC,CHANGE
	CALL	PUTSTR
	CALL	$BCONI
	PUSH	AF
	CALL	OPCRLF
	POP	AF
	CP	03		;^C?
	JP	Z,$BWARM
;
;	RESET DISK
DOC1:
	LD	BC,0
	CALL	SVECTB
	CALL	RESDSK
	CALL	LOGOND
	XOR	A
	RET
;
;	CALCULATE ADDRESS OF CURRENT DIRECTORY ENTRY
PTOENT:
	LD	HL,(DIRBUF)	;PT TO DIRECTORY BUFFER
	LD	A,(DIROFF)	;GET OFFSET OF ENTRY
HLPLSA:
	ADD	A,L		;ADD A TO HL SINGLE LENGTH
	LD	L,A
	RET	NC		;RETURN IF NO CARRY TO H
	INC	H		;UP H
	RET
;
;	TEST IF DIRECTORY ENTRY OUTSIDE NO OF ENTRIES ON DISK
TENTNO:
	LD	HL,(DIRENO)
	EX	DE,HL
	LD	HL,(NOOFDB)
	LD	A,E
	SUB	(HL)
	INC	HL
	LD	A,D
	SBC	A,(HL)
	RET
;
;	INCREASE IF NECESSARY MAXIMUM NO OF ENTRIES ON DISK
UPMAXE:
	CALL	TENTNO
	RET	C
	INC	DE
	LD	(HL),D
	DEC	HL
	LD	(HL),E
	RET
;
;	TEST IF END OF DIRECTORY REACHED
TSTEDI:
	LD	HL,DIRENO
	LD	A,(HL)
	INC	HL
	CP	(HL)
	RET	NZ		;RETURN IF NOT END
	INC	A		;SET ZERO IF END
	RET
;
;	GET THE ALLOCATION VECTOR BIT FOR BLOCK [BC]
GALBIT:
	LD	H,B
	LD	L,C
	LD	B,4
	CALL	HLSRB
	LD	DE,(ALVAD)
	ADD	HL,DE
	LD	A,C
	AND	007H
	INC	A
	LD	B,A
	LD	D,A
	LD	A,(HL)		;GET BYTE
SLALBY:
	RLCA			;AND SHIFT INTO POSITION
	DJNZ	SLALBY
	RET
;
;	SET/RESET ALLOCATION BIT FROM B0 OF E
CALBIT:
	PUSH	DE		;SAVE SET/RESET
	CALL	GALBIT		;GET THE BIT
	AND	0FEH		;SET TO ZERO
	POP	BC		;RESTORE SET/RESET
	OR	C		;OR IN NEW BIT
SRALBY:
	RRCA			;PUT BACK INTO POSITION
	DEC	D
	JR	NZ,SRALBY
	LD	(HL),A		;AND SET NEW BYTE
	RET
;
;	SET ALLOCATION BITS FOR A DIRECTORY ENTRY
SENTAL:
	CALL	PTOENT		;POINT TO ENTRY
	LD	DE,F.BLKS	;PT TO BLOCKS AREA
	ADD	HL,DE
	PUSH	BC
	LD	C,011H		;NO OF BLOCKS TO DO +1
NXEALB:
	POP	DE
	DEC	C
	RET	Z		;RETURN IF FINISHED
	PUSH	DE
	BIT	LRG,(IY+FLAGS)
	JR	NZ,WDALBN	;J IF WORDS
	PUSH	BC
	PUSH	HL		;SAVE PTR TO AREA
	LD	C,(HL)		;GET THE BLOCK NO
	LD	B,0		;IN BC
	JR	SALBIT		;AND SET THE BIT
;
WDALBN:
	DEC	C		;1 LESS BYTE TO GO
	PUSH	BC
	LD	C,(HL)		;GET BLOCK NO
	INC	HL
	LD	B,(HL)		;IN BC
	PUSH	HL
SALBIT:
	LD	A,C		;IS IT UNALLOCATED
	OR	B
	JR	Z,FALBN		;J IF SO
	LD	HL,(DPSIZ)	;TEST IF BLOCK IN RANGE
	SBC	HL,BC
	CALL	NC,CALBIT	;SET BIT IF IN RANGE
FALBN:
	POP	HL		;SET TO NEXT BLOCK
	INC	HL
	POP	BC
	JR	NXEALB
;
;	DELETE SPECIFIED FILE
DEFILE:
	CALL	CHKWOK		;FAIL IF DISK READ ONLY
	LD	C,F.EXT		;SEARCH EXCLUDING EXTENT
	CALL	FINDFI		;FIND THE FILE
DELEXT:
	CALL	TSTEDI		;TEST IF IN RANGE/NOT THERE
	RET	Z		;RETURN IF NOT
	CALL	TSTROF		;TEST IF FILE READ ONLY
	JR	Z,DEL1		;SKIP FILE IF R/O
	CALL	PTOENT		;POINT TO ENTRY
	LD	(HL),D.ERAS	;SET ERASED
	LD	C,0		;MARK DELETING
	CALL	SENTAL		;AND RESET ALLOCATION VECTOR
	CALL	WRTDIR		;WRITE AWAY RECORD
DEL1:	CALL	GETFIE		;GET THE NEXT FILE IF ANY
	JR	DELEXT		;AND REPEAT
;
;	FIND A FREE BLOCK FROM THE ALLOC VECTOR
FIFREB:
	LD	C,B		;SAVE LAST POS REACHED
	LD	E,C
TSCBLN:
	LD	A,C		;TEST IF FIRST TIME
	OR	B
	JR	Z,NXFRAL	;J IF SO
	DEC	BC		;BACK OFF
	PUSH	DE		;SAVE OLD VALUE
	PUSH	BC
	CALL	GALBIT		;GET THE BLOCK BIT
	RRA			;IS IT FREE
	JR	NC,FRALBL	;J IF IT IS TO USE IT
	POP	BC		;RESTORE VALUES
	POP	DE
NXFRAL:
	LD	HL,(DPSIZ)	;GET SIZE IN BLOCKS
	LD	A,E		;LAST BLOCK NO
	SUB	L
	LD	A,D
	SBC	A,H
	JR	NC,TIFULL	;J IF REACHED END OF VECTOR
	INC	DE		;PT TO NEXT BLOCK
	PUSH	BC
	PUSH	DE
	LD	B,D
	LD	C,E
	CALL	GALBIT
	RRA			;TEST IF USED
	JR	NC,FRALBL	;J IF NOT
	POP	DE		;RESTORE LAST
	POP	BC
	JR	TSCBLN		;AND TEST NEXT
;
;	FOUND FREE BLOCK IN VECTOR
FRALBL:
	RLA			;RESTORE BYTE
	INC	A		;SET USED
	CALL	SRALBY		;RESTORE TO VECTOR
	POP	HL
	POP	DE
	RET
;
;	TEST WHETHER DISK IS FULL
TIFULL:
	LD	A,C		;TRIED ALL VECTOR?
	OR	B
	JR	NZ,TSCBLN	;J IF NO TO RESTART
	LD	HL,0		;INDICATE FAILED
	RET
;
;	CLOSE FILE
ICLOSF:
	CALL	TCBDRV		;SET UP DRIVE
;
;	CLOSE FILE
CLFILE:
	LD	HL,0
	LD	(DIRENO),HL	;CLEAR ENTRY NO
	LD	(IY+D.REP),L
	BIT	7,(IX+F.S2)
	RET	NZ		;NO UPDATE
	CALL	TSTROV		;FAIL IF READ ONLY DISK
	RET	NZ
	LD	C,F.EXT+1	;SEARCH LENGTH
	CALL	FINDFI		;FIND THE FILE
	CALL	TSTEDI		;FOUND?
	RET	Z		;RETURN IF NOT
	LD	BC,F.BLKS	;PT TO BLOCKS IN ENTRY
	CALL	PTOENT
	ADD	HL,BC
	EX	DE,HL		;PTR TO DE
	LD	HL,(IPWORD)	;PT TO FCB
	ADD	HL,BC		;BLOCKS AREA
	LD	B,010H		;NO OF BLOCKS DEFINED
CLNXTE:
	BIT	LRG,(IY+FLAGS)	;TEST IF WORD ENTRIES
	JR	NZ,CLTSEQ	;J IF WORD BLOCK NOS.
	LD	A,(HL)		;GET THE FCB VALUE
	OR	A		;IS IT ZERO (UNALLOC)
	LD	A,(DE)
	JR	NZ,CLTSCB	;J IF NOT UNALLOC
	LD	(HL),A		;RESET FCB VALUE
CLTSCB:
	OR	A		;IS ENTRY BLOCK ZERO
	JR	NZ,CLTSDN	;J IF NOT
	LD	A,(HL)		;GET THE FCB VALUE
	LD	(DE),A		;AND RESET ENTRY ACCORDINGLY
CLTSDN:
	CP	(HL)		;SAME BLOCKS
	JR	NZ,CLFAIL	;J IF NOT AS CORRUPT
	JR	CLUPDE		;REPEAT FOR ALL
;
;	CHECK WORD BLOCK NOS.
CLTSEQ:
	CALL	RSTDFE		;DO SHUFFLE
	EX	DE,HL
	CALL	RSTDFE		;AND AGAIN IN REVERSE
	EX	DE,HL
	LD	A,(DE)		;GET ENTRY VAL
	CP	(HL)		;SAME?
	JR	NZ,CLFAIL	;J IF CORRUPT
	INC	DE		;NEXT BYTE
	INC	HL
	LD	A,(DE)		;TRY AGAIN
	CP	(HL)
	JR	NZ,CLFAIL
	DEC	B		;BACK OFF ONE BYTE
CLUPDE:
	INC	DE		;PT TO NEXT BLOCK IN ENTRY
	INC	HL		;AND FCB
	DJNZ	CLNXTE		;J IF MORE
	LD	BC,-32+F.EXT	;PT TO EXTENT
	ADD	HL,BC		;IN FCB
	EX	DE,HL
	ADD	HL,BC		;AND ENTRY
	LD	A,(DE)		;GET THE FCB EXTENT
	CP	(HL)		;SAME AS BEFORE?
	JR	C,CLFINI	;J IF NOT INCREASED IN SIZE
	LD	(HL),A		;SAVE NEW VALUE IN ENTRY
	LD	BC,F.RC-F.EXT	;PT TO RECORD COUNT
	ADD	HL,BC
	EX	DE,HL
	ADD	HL,BC
	LD	A,(HL)		;GET IT FROM FCB
	LD	(DE),A		;PUT IN ENTRY
CLFINI:
	SET	UPD,(IY+FLAGS)
	JR	WRDIBL		;AND WRITE RECORD AWAY
;
;	FAILED TO CLOSE
CLFAIL:
	LD	(IY+D.REP),-1
	RET			;AND RETURN
;
;	RESET ALL OF ENTRY AND WRITE OUT
WRDIRE:
	LD	C,0		;START OFFSET
	LD	E,020H		;AND LENGTH
UPDENT:
	LD	D,0
	PUSH	DE		;SAVE LENGTH
	LD	B,0		;FROM START POSITION
	LD	HL,(IPWORD)	;IN FCB
	ADD	HL,BC
	EX	DE,HL		;TO DE
	CALL	PTOENT		;PT TO ENTRY
	EX	DE,HL
	POP	BC		;RESTORE LENGTH
	LDIR
WRDIBL:
	CALL	CVENTN		;SET UP FOR WRITE
	JR	WRTDIR		;AND WRITE IT OUT
;
;	RESTART DIRECTORY ENTRY NO
STRTDI:
	LD	HL,-1		;STARTS AT -1 DUE TO PRE-INCREMENT
	LD	(DIRENO),HL	;SAVE
	RET
;
;	GET THE NEXT DIRECTORY ENTRY IN TO BUFFER
NXTDIE:
	LD	HL,(DIRENO)	;GET CURRENT ENTRY NO
	INC	HL		;UP TO NEXT
	LD	(DIRENO),HL	; SAVE
	EX	DE,HL
	LD	HL,(DPDIR)	;NO OF DIRECTORY ENTRIES
	SBC	HL,DE
	JR	C,STRTDI
	LD	A,E		;GET CURRENT ENTRY NO
	AND	003H		;TEST IF FIRST IN RECORD
	ADD	A,A
	ADD	A,A
	ADD	A,A
	ADD	A,A
	ADD	A,A
	LD	(DIROFF),A	;SAVE OFFSET
	OR	A		;IS IT FIRST ONE IN BUFFER
	RET	NZ		;RETURN IF NOT
	PUSH	BC		;SAVE TYPE
	CALL	CVENTN		;SET UP PARAM FOR READ
	CALL	RDDIR		;AND READ RECORD
	POP	BC		;RESTORE FLAG
	JR	SUMDIR		;AND CHECK IT
;
;	CALCULATE NEW SUM FOR DIRECTORY RECORD
NEWSUM:
	LD	C,0FFH		;SET UPDATING FLAG
SUMDIR:
	LD	HL,(DIRSEC)	;GET SECTOR NO OF DIRECTORY
	LD	A,(DPCHK)
	OR	A
	RET	Z		;RETURN IF NOT
	XOR	A
	LD	B,128
	LD	HL,(DIRBUF)
SUMD1:
	ADD	A,(HL)
	INC	HL
	DJNZ	SUMD1
	LD	DE,(CSVAD)	;PT TO CHECK SUM VECTOR
	LD	HL,(DIRSEC)	;ADD SECTOR NO
	ADD	HL,DE
	INC	C		;TEST IF UPDATING
	JR	Z,SETSUM	;J IF WE ARE
	CP	(HL)		;IS SUM SAME
	CALL	NZ,ISETRO	;ELSE SET DRIVE READ ONLY
	RET
;
SETSUM:
	LD	(HL),A		;SAVE NEW SUM IN VECTOR
	RET
;
;	WRITE DIRECTORY RECORD AWAY
WRTDIR:
	CALL	NEWSUM		;FIND CHECKSUM VALUE
	LD	BC,(DIRBUF)	;GET DIRECTORY BUFFER ADDRESS IN BC
	CALL	$BSETM		;SET DIRECTORY TRANSFER ADDRESS
	LD	C,001H		;SET DIRECTORY WRITE
	CALL	WRSECT		;AND WRITE AWAY
	JR	RESDMA
;
;	READ DIRECTORY RECORD
RDDIR:
	LD	BC,(DIRBUF)	;GET DIRECTORY BUFFER ADDRESS
	CALL	$BSETM		;SET UP TRANSFER ADDRESS
	CALL	RDSECT		;READ THE RECORD
RESDMA:
	LD	BC,(USRDMA)	;RESET BACK TO USER XFER ADDR
	JP	$BSETM
;
;	SET DMA TRANSFER ADDRESS
ISETDM:
	LD 	(USRDMA),DE	;SAVE IT
	JR	RESDMA		;AND SET IT UP
;
;	RENAME FILE
RNFILE:
	CALL	CHKWOK		;FAIL IF READ ONLY DISK
	LD	C,00CH		;LENGTH EXCLUDING EXTENT
	CALL	FINDFI		;FIND THE FILE
	LD	A,(IX+F.DRV)	;GET DISK/USER
	LD	(IX+F.DRV+16),A	;SET CORRECT DISK/USER
RENEXT:
	CALL	TSTEDI		;TEST IF FOUND
	RET	Z		;RETURN IF NOT
	CALL	TSTROF		;FAIL IF READ ONLY FILE
	JP	Z,$BWARM	;WARM BOOT IF R/O
	LD	C,F.BLKS	;OFFSEWT OF NEW NAME
	LD	E,F.EXT		;LENGTH EXC. EXTENT
	CALL	UPDENT		;UPDATE ENTRY
	CALL	GETFIE		;GET THE NEXT ONE IF ANY
	JR	RENEXT		;AND REPEAT
;
;	SET A FILE'S ATTRIBUTE BITS
SETATB:
	LD	C,00CH		;SEARCH EXCLUDING EXTENT
	CALL	FINDFI		;FIND THE FILE
STBEXT:
	CALL	TSTEDI		;TEST IF FOUND
	RET	Z		;RET IF NOT
	LD	C,0		;OFFSET
	LD	E,F.EXT		;AND LENGTH
	CALL	UPDENT		;UPDATE ENTRY
	CALL	GETFIE		;GET THE NEXT ONE
	JR	STBEXT		;AND REPEAT
;
;	OPEN REQUESTED FILE
IOPENF:
	LD	(IX+F.S2),0
	CALL	TCBDRV		;SET UP DRIVE
;
;	OPEN REQUESTED FILE
OPFILE:
	LD	C,F.EXT+1	;SEARCH INCLUDING EXTENT
	CALL	FINDFI		;FIND THE FIRST ONE
	CALL	TSTEDI		;TEST IF FOUND
	RET	Z		;RETURN IF NOT
OPFEXT:
	LD	A,(IX+F.EXT)
	PUSH	AF		;SAVE FOR LATER
	CALL	PTOENT		;PT TO ENTRY
	LD	DE,(IPWORD)	;GET FCB ADDRESS
	LD	BC,020H		;LENGTH OF ENTRY
	LDIR
	SET	7,(IX+F.S2)
	LD	C,(IX+F.EXT)	;GET IN C
	POP	AF		;AND EXTENT
	LD	(IX+F.EXT),A	;SET UP EXTENT
	CP	C		;SAME AS SAVED VAL?
	JR	Z,OPFXIT	;J IF SO
	LD	A,0
	JR	NC,FULEXT
	LD	A,128		;SET MAXIMUM COUNT
FULEXT:
	LD	(IX+F.RC),A
OPFXIT:
	RET
;
RSTDFE:
	LD	A,(HL)
	INC	HL
	OR	(HL)
	DEC	HL
	RET	NZ
	LD	A,(DE)
	LD	(HL),A
	INC	DE
	INC	HL
	LD	A,(DE)
	LD	(HL),A
	DEC	DE
	DEC	HL
	RET
;
;	MAKE FILE
IMAKEF:
	LD	(IX+F.S2),0
	CALL	TCBDRV		;SET UP DRIVE
;
;	MAKE A FILE/EXTENT
MKFILE:
	CALL	CHKWOK		;FAIL IF READ ONLY
	LD	HL,CEMPTY	;PT TO EMPTY DUMMY FCB
	LD	(IPWORD),HL	;ALTER FCB PTR
	LD	C,001H		;LENGTH OF ONE FOR ERASED
	CALL	FINDFI		;FIND A FREE ENTRY
	CALL	TSTEDI		;ANY FOUND?
	LD	(IPWORD),IX
	JR	NZ,MAKE2	;JUMP IF YES
	LD	HL,CHGDSK
	LD	DE,DIRFUL
	LD	BC,$DISK	;DIRECTORY FULL
	CALL	ERMDSK		;GET USER REPLY
	CP	03		;^C?
	JP	Z,$BWARM
	CP	"Y"
	JR	Z,MAKE1		;JUMP IF DISK CHANGE REQUESTED
	XOR	A
	RET
MAKE1:
	CALL	DSKCHG		;DO DISK CHANGE
	JR	IMAKEF
MAKE2:
	LD	DE,(IPWORD)	;FCB PTR TO DE
	LD	HL,F.RC		;PT TO RECORD COUNT
	ADD	HL,DE
	LD	B,32-F.RC+1	;LENGTH OF CLEAR
	XOR	A
MKCLRE:
	LD	(HL),A		;CLEAR BYTES IN FCB
	INC	HL
	DJNZ	MKCLRE
	LD	(IX+F.S1),0
	CALL	UPMAXE		;UPDATE ALL ENTRY
	CALL	WRDIRE		;WRITE AWAY
	SET	7,(IX+F.S2)
	RET
;
;	OPEN NEXT EXTENT OF FILE
OPNXEX:
	RES	UPD,(IY+FLAGS)
	CALL	CLFILE		;CLOSE CURRENT EXTENT
	CALL	TSTEDI		;DID IT FAIL?
	RET	Z		;RETURN IF SO
	LD	A,(IX+F.EXT)
	INC	A		;UP BY ONE
	AND	01FH		;MOD 32
	LD	(IX+F.EXT),A	;RESET IT
	JR	Z,MAXEXT	;J IF MAXIMUM REACHED
	BIT	UPD,(IY+FLAGS)
	JR	Z,FNXTEX
	AND	(IY+D.EXM)
	JR	Z,FNXTEX	;J IF CANT BE IN SAME ONE
	JR	EXTFND		;FIND THE NEXT ONE
;
;	MAXIMUM REACHED
MAXEXT:
	INC	(IX+F.S2)	;UP IT
	LD	A,(IX+F.S2)	;AND GET RESULT
	AND	00FH		;GET ACTUAL EXTENT
	JR	Z,FNEXFL	;J IF MAX TO FAIL
FNXTEX:
	LD	C,F.EXT+1	;SEARCH LENGTH
	CALL	FINDFI		;FIND THE NEXT ONE
	CALL	TSTEDI		;FOUND?
	JR	NZ,EXTFND	;J IF IT WAS
	BIT	RD,(IY+FLAGS)
	JR	NZ,FNEXFL	;J IF IT IS
	CALL	MKFILE		;MAKE NEXT EXTENT
	CALL	TSTEDI		;ANY LUCK?
	JR	Z,FNEXFL	;J IF NOT TO FAIL
	JR	FINEXT		;FINISH OFF
;
;	FOUND REQUIRED EXTENT
EXTFND:
	CALL	OPFEXT		;SET UP REQUIRED VALUES
FINEXT:
	XOR	A		;MARK OPERATION OK
	JP	IREPEX		;AND RETURN
;
;	FAILED TO OPEN EXTENT
FNEXFL:
	SET	7,(IX+F.S2)
	JR	MAXWR		;SET REPLY AND RETURN
;
;	READ RANDOM RECORD
IRDRAN:
	CALL	TCBDRV		;SET UP DRIVE
;
;	READ RANDOM RECORD
RDRAND:
	LD	C,0FFH		;MARK READ OPERATION
	CALL	RANSER		;SET THE REQUIRED VALUES
	JR	Z,RDSQRA	;READ THE RECORD IF OK
	RET			;AND RETURN
;
;	READ SEQUENTIAL
IRDSQN:
	CALL	TCBDRV		;SET UP DRIVE
;
;	READ FILE SEQUENTIAL
RDSEQN:
	SET	SEQ,(IY+FLAGS)
RDSQRA:
	SET	RD,(IY+FLAGS)
	LD	A,(IX+F.CR)	;GET CURRENT RECORD NO
	CP	(IX+F.RC)	;TEST IF EXCEEDED
	JR	C,RDEXSE	;J IF NOT TO CARRY OUT READ
	CP	080H		;IS IT MAXIMUM?
	JR	NZ,RDFAIL	;J IF NOT TO FAIL
	CALL	OPNXEX		;OPEN NEXT EXTENT IF ANY
	LD	(IX+F.CR),0
	LD	A,(IREPLY)	;GET REPLY
	OR	A		;TEST IT
	JR	NZ,RDFAIL	;FAIL IF BAD EXTENT OPEN
RDEXSE:
	CALL	GCURBL		;GET THE CURRENT BLOCK
	JR	Z,RDFAIL	;FAIL IF IT IS
	CALL	CALCSN		;CALCULATE PARAM FOR READ
	CALL	CVISTS		;CONV TO TRAK/SECT
	CALL	RDSECT		;READ IT IN
	BIT	SEQ,(IY+FLAGS)
	RET	Z
	INC	(IX+F.CR)
	RET
;
;	FAILED TO READ
RDFAIL:
;
;	FAILED TO WRITE
MAXWR:
	LD	(IY+D.REP),1
	RET
;
;	WRITE RANDOM WITH ZERO FILL
IWRRAZ:
	CALL	TCBDRV		;SET UP DRIVE
	RES	SEQ,(IY+FLAGS)
	SET	ZFI,(IY+FLAGS)
	LD	C,0		;MARK WRITE
	CALL	RANSET		;SET THE RECORD NO
	JR	Z,WRSQRA	;WRITE IF OK
	RET			;AND RETURN
;
;	WRITE RANDOM RECORD
IWRRAN:
	CALL	TCBDRV		;SET UP DRIVE
;
;	WRITE RANDOM RECORD
WRRAND:
	LD	C,0		;MARK WRITE
	CALL	RANSER		;SET RECORD VALUES ETC
	JR	Z,WRSQRA	;WRITE IF CONVERSION OK
	RET			;EXIT
;
;	WRITE SEQUENTIAL
IWRSQN:
	CALL	TCBDRV		;SET UP DRIVE
;
;	WRITE SEQUENTIAL
WRSEQN:
	SET	SEQ,(IY+FLAGS)
WRSQRA:
	RES	RD,(IY+FLAGS)
	CALL	CHKWOK		;FAIL IF READ ONLY
	LD	HL,(IPWORD)	;PT TO FCB
	CALL	TSTROB		;FAIL IF READ ONLY FILE
	JP	Z,$BWARM	;WARM BOOT IF R/O
	LD	A,(IX+F.CR)	;GET CURRENT RECORD
	CP	080H		;MAXIMUM REACHED?
	JR	NC,MAXWR	;J IF OVER LIMIT
	CALL	GCURBL		;GET THE CURRENT BLOCK
	LD	C,0		;SET ALLOCATED IN CASE
	JR	NZ,WRREC	;J IF NOT REQD
	CALL	CVRTOS		;CONVERT THE BLOCK NO
	LD	(LASTDN),A	;SAVE LAST ONE
	LD	BC,0		;SET RESTART ALLOC SEARCH
	OR	A
	JR	Z,FINDNW	;J IF LAST RECORD NULL
	LD	C,A		;START AT LAST RECORD
	DEC	BC		;-1
	CALL	GETBLK		;GET NEXT BLOCK IF POSS
	LD	B,H
	LD	C,L
FINDNW:
	CALL	FIFREB		;FIND A FREE BLOCK
	LD	A,L		;ANY FREE?
	OR	H
	JR	NZ,SETNEW	;J IF THERE IS
;
;	DISK FULL
DSKFL:
	LD	HL,CHGDSK
	LD	DE,DSKFUL	;DISK FULL
	LD	BC,$DISK
	CALL	ERMDSK
	CP	03		;^C?
	JP	Z,$BWARM
	CP	"Y"
	JR	Z,DSKF1
	LD	A,002H		;SET REPLY TO TRANSIENT PROGRAM
	JP	IREPEX
DSKF1:
	CALL	CLFILE		;CLOSE FILE ON OLD DISK
	CALL	DSKCHG		;DO DISK CHANGE
	CALL	MKFILE		;CREATE NEW COPY OF FILE
	LD	(IY+D.REP),0	;SET "WRITE OK" INTO REPLY
	JR	WRSQRA		;WRITE RECORD TO NEW FILE
;
SETNEW:
	LD	(REQSEC),HL	;SAVE THE NEW BLOCK NO
	EX	DE,HL		;PUT IN DE
	LD	HL,(IPWORD)	;PT TO FCB
	LD	BC,F.BLKS	;BLOCK AREA
	ADD	HL,BC
	BIT	LRG,(IY+FLAGS)
	LD	A,(LASTDN)	;GET OFFSET
	JR	NZ,WDNEW	;J IF WORDS
	CALL	HLPLSA		;CALC BLOCK BYTE
	LD	(HL),E		;SAVE NEW BLOCK
	JR	SETUNA		;AND WRITE UNALLOCATED
;
WDNEW:
	LD	C,A		;FORM OFFSET
	LD	B,0
	ADD	HL,BC		;IN AREA
	ADD	HL,BC
	LD	(HL),E		;SAVE NEW BLOCK
	INC	HL
	LD	(HL),D
SETUNA:
	LD	C,002H		;MARK UNALLOCATED WRITE
WRREC:
	LD	A,(IREPLY)	;GET REPLY
	OR	A
	RET	NZ		;RETURN IF PREVIOUSLY FAILED
	PUSH	BC		;SAVE ALLOC/UNALLOC
	CALL	CALCSN		;FIND INTERNAL SECTOR NO
	BIT	ZFI,(IY+FLAGS)
	JR	Z,WROUTS	;J IF NOT WRITE WITH ZERO FILL
	POP	BC		;RESTORE UNALLOC FLAG
	PUSH	BC		;SAVE IT
	LD	A,C		;GET THE FLAG
	DEC	A		;TEST
	DEC	A
	JR	NZ,WROUTS	;J IF NOT ALLOCATED WRITE
	PUSH	HL		;SAVE BLOCKS AREA PTR
	LD	HL,(DIRBUF)	;PT TO DIRECTORY BUFFER
	PUSH	HL
	PUSH	HL
	LD	(HL),A
	POP	DE
	INC	DE
	LD	BC,127
	LDIR
	POP	BC
	CALL	$BSETM
	LD	HL,(BLSEC)	;GET BLOCK SIZE IN SECTORS
	LD	C,002H		;SET UNALLOCATED WRITE
WRZERO:
	LD	(REQSEC),HL	;SET REQUIRED SECTOR
	PUSH	BC		;SAVE FLAGS
	CALL	CVISTS		;CONVERT TO TRAK/SECTOR
	POP	BC
	CALL	WRSECT		;WRITE AWAY
	LD	HL,(REQSEC)	;GET THE REQUIRED SECTOR
	LD	C,0		;SET ALLOCATED NOW
	LD	A,(DPMSK)	;MASK FOR BLOCKS
	LD	B,A		;TO B
	AND	L		;END OF BLOCK?
	CP	B
	INC	HL
	JR	NZ,WRZERO	;J IF NOT TO REPEAT OP
	POP	HL		;RESTORE REQUIRED BLOCK
	LD	(REQSEC),HL	;AND SAVE
	CALL	RESDMA		;RESET THE XFER ADDR
WROUTS:
	CALL	CVISTS		;CONVERT TO INTERNAL SECTOR NO
	POP	BC		;RESTORE ALLOC FLAG
	PUSH	BC		;SAVE IT
	CALL	WRSECT		;WRITE NEW ONE OUT
	POP	BC		;RESTORE ALLOC
	LD	A,(IX+F.CR)	;GET THE CURRENT RECORD NO
	CP	(IX+F.RC)	;EXCEEDED?
	JR	C,TSETWR	;J IF NOT
	LD	(IX+F.RC),A	;SET THE NEW VALUE
	INC	(IX+F.RC)	;UP BY ONE
	LD	C,002H		;SET DUMMY UNALLOC
TSETWR:
	DEC	C		;TEST IF UNALLOC
	DEC	C
	JR	NZ,TMAXRC	;J IF NOT UNALLOCATED
	RES	7,(IX+F.S2)
TMAXRC:
	BIT	SEQ,(IY+FLAGS)
	RET	Z		;RETURN IF NOT SEQ OPERATION
	CP	07FH		;WRITE LAST OF EXTENT?
	JR	NZ,FINWR	;J IF NOT TO FINISH
	CALL	OPNXEX		;OPEN NEXT EXTENT
	BIT	0,(IY+D.REP)
	JR	NZ,OKWRI	;J IF IT DID
	LD	(IX+F.CR),-1
OKWRI:
	LD	(IY+D.REP),0	;SET REPLY OK
FINWR:
	INC	(IX+F.CR)
	RET
;
RANSER:
	RES	SEQ,(IY+FLAGS)
RANSET:
	PUSH	BC		;SAVE PAR
	LD	A,(IX+F.RRC)	;GET FIRST BYTE
	AND	07FH		;CLEAR SIGN
	PUSH	AF		;SAVE IT
	LD	A,(IX+F.RRC)	;RESTORE VALUE
	RLA			;GET BIT 7 VALUE
	LD	A,(IX+F.RRC+1)	;GET IT
	RLA			;CORRECT WITH C
	AND	01FH		;MASK FOR MAX
	LD	C,A		;SAVE IT
	LD	A,(IX+F.RRC+1)	;RESTORE VALUE
	RRA			;OUST B0
	RRA			;B1
	RRA			;B2
	RRA			;B3
	AND	00FH		;AND GET RESIDUE
	LD	B,A		;IN B
	POP	AF		;RESTORE FIRST VALUE
	LD	L,(IX+F.RRC+2)	;GET IT
	INC	L		;UP BY ONE
	DEC	L		;DOWN AGAIN
	LD	L,006H		;SET FAILED CODE
	JR	NZ,RAFAIL	;J IF OVERFLOWED
	LD	(IX+F.CR),A	;SAVE NEW VALUE
	LD	A,C		;SAVE NEW EXTENT
	SUB	(IX+F.EXT)	;SAVE AS CURRENT?
	JR	NZ,RAXTOK	;J IF IT IS
	LD	A,B		;GET THE CALCULATED VALUE
	SUB	(IX+F.S2)	;SAME?
	AND	07FH		;OMITTING B7
	JR	Z,RAOPOK	;J IF IT IS
RAXTOK:
	PUSH	BC		;SAVE VALS
	PUSH	DE		;AND FCB PTR
	CALL	CLFILE		;CLOSE CURRENT EXTENT
	POP	DE		;RESTORE FCB PTR
	POP	BC		;AND VALS
	LD	L,003H		;SET FAIL CODE
	LD	A,(IREPLY)	;DID CLOSE FAIL?
	INC	A
	JR	Z,RAEXTF	;J IF IT DID
	LD	(IX+F.EXT),C	;SET NEW VALUE
	LD	(IX+F.S2),B	;SET NEW VALUE
	CALL	OPFILE		;OPEN THE RIGHT EXTENT
	LD	A,(IREPLY)	;DID IT FAIL?
	INC	A
	JR	NZ,RAOPOK	;J IF IT DIDNT
	POP	BC		;RESTORE VALUES
	PUSH	BC		;SAVE THEM
	LD	L,004H		;SET FAIL CODE
	INC	C		;UP EXTENT NO
	JR	Z,RAEXTF	;J IF MAX REACHED
	CALL	MKFILE		;MAKE A NEW EXTENT
	LD	L,005H		;FAIL CODE
	LD	A,(IREPLY)	;DID THE MAKE FAIL
	INC	A
	JR	Z,RAEXTF	;J IF IT DID
RAOPOK:
	POP	BC		;RESTORE VALS
	XOR	A		;MARK OK
	JP	IREPEX		;AND EXIT
;
;	FAILED RANDOM SET
RAEXTF:
	LD	(IX+F.S2),0C0H
RAFAIL:
	POP	BC		;RESTORE VALS
	LD	(IY+D.REP),L	;GET FAIL CODE
	SET	7,(IX+F.S2)
	OR	L
	RET
;
;	CALCULATE RANDOM RECORD FROM EXT/RC/S2
CALCRA:
	EX	DE,HL		;FCB PTR IN HL
	ADD	HL,DE		;GET PTR TO CURRENT REC
	LD	C,(HL)		;GET IT IN C
	LD	B,0		;SET UPPER BYTE ZERO
	LD	HL,F.EXT	;PT TO EXTENT
	ADD	HL,DE
	LD	A,(HL)		;GET THE VALUE
	RRCA			;SHIFT
	AND	080H		;MASK BIT 7
	ADD	A,C		;ADD THE CURRENT RECORD
	LD	C,A		;SAVE IT
	LD	A,0
	ADC	A,B
	LD	B,A
	LD	A,(HL)		;GET EXTENT AGAIN
	RRCA			;OUST B0
	AND	00FH		;GET CORRECT PART
	ADD	A,B		;ADD TO UPPER BYTE OF RANDOM REC
	LD	B,A
	LD	HL,F.S2		;PT TO S2
	ADD	HL,DE
	LD	A,(HL)		;GET IT
	ADD	A,A		;SHIFT TO POS
	ADD	A,A
	ADD	A,A
	ADD	A,A
	PUSH	AF		;SAVE IT
	ADD	A,B		;ADD TO TOP BYTE
	LD	B,A
	PUSH	AF		;SAVE VALUE
	POP	HL		;RESTORE IT IN HL
	LD	A,L		;TEST IF OUT OF RANGE
FINSIZ:
	POP	HL
	OR	L
	AND	001H		;SET REPLY
	RET			;AND EXIT
;
;	FIND SIZE OF FILE
IFILSZ:
	CALL	TCBDRV		;SET UP DRIVE
;
;	CALCULATE SIZE OF FILE
FILSIZ:
	LD	C,00CH		;LENGTH OF FCB COMPARE
	CALL	FINDFI		;FIND THE FIRST FILE
	LD	HL,(IPWORD)	;PT TO FCB
	LD	DE,F.RRC	;PT TO RANDOM RECORD NO
	ADD	HL,DE
	PUSH	HL		;SAVE ITS ADDRESS
	LD	(HL),D		;CLEAR IT
	INC	HL
	LD	(HL),D
	INC	HL
	LD	(HL),D
NXTSIZ:
	CALL	TSTEDI		;FILE FOUND?
	JR	Z,FINSIZ	;J IF NOT
	CALL	PTOENT		;GET PTR TO ENTRY
	LD	DE,F.RC		;PT TO RECORD COUNT
	CALL	CALCRA		;FIND RANDOM REC COUNT
	POP	HL		;RESTORE PTR TO RANDOM REC
	PUSH	HL		;SAVE AGAIN
	LD	E,A		;TEST IF EXCEEDED
	LD	A,C
	SUB	(HL)
	INC	HL
	LD	A,B
	SBC	A,(HL)
	INC	HL
	LD	A,E
	SBC	A,(HL)
	JR	C,UPSIZ		;J IF IT ISNT
	LD	(HL),E		;SET THE NEW VALUE
	DEC	HL
	LD	(HL),B
	DEC	HL
	LD	(HL),C
UPSIZ:
	CALL	GETFIE		;FIND THE NEXT EXTENT
	JR	NXTSIZ		;AND REPEAT
;
;	SET RANDOM RECORD
ISETRA:
	LD	HL,(IPWORD)	;PT TO FCB
	LD	DE,F.CR		;RECORD COUNT
	CALL	CALCRA		;FIND THE VALUE
	LD	(IX+F.RRC),C
	LD	(IX+F.RRC+1),B
	LD	(IX+F.RRC+2),A
	RET			;AND EXIT
;
;	SELECT DISK
ISELDS:
	LD	A,(IPBYTE)	;GET THE DRIVE REQUIRED
	CP	(IY+D.DRV)	;IS IT THE SAME
	RET	Z		;RETURN IF IT IS
	LD	(IY+D.DRV),A	;SET NEW VALUE
	JR	LOGOND		;AND LOGON IF NECESSARY
;
;	RESET DISK SYSTEM
IRESET:
	LD	HL,0		;CLEAR
	LD	(ROVEC),HL	;READ ONLY VECTOR
	LD	(LOVEC),HL	;AND LOGGED ON VECTOR
	LD	(IY+D.DRV),L
	LD	BC,D.DEFD	;RESET DMA ADDRESS
	LD	(USRDMA),BC
	CALL	$BSETM		;RESET VIA BIOS
;
;	LOG ON A DISK IF REQUIRED
LOGOND:
	LD	HL,(LOVEC)	;GET VECTOR
	LD	B,(IY+D.DRV)
	INC	B
	CALL	HLSRB		;GET THE RIGHT BIT
	PUSH	HL		;SAVE IT
	EX	DE,HL		;GET IN DE
	CALL	SELECD		;SELECT THE DISK
	POP	HL		;RESTORE THE VECTOR
	JR	NZ,LOG2
;	ERROR IF BAD SECECT
	LD	HL,GETDRV
	LD	DE,SELERR
	LD	BC,$DRIVE	;DRIVE SELECT ERROR
	CALL	ERMDSK
	CP	03		;^C?
	JR	Z,LOG1
	SUB	"A"		;CONVERT TO DRIVE NUMBER
	LD	(IPBYTE),A
	JR	ISELDS		;SELECT NEW DISK
LOG1:
	CALL	IRESET		;RESET DISK SYSTEM
	JP	$BWARM		;WARM BOOT
LOG2:
	LD	A,L		;GET LO BYTE OF VECTOR
	RRA			;OUST B0
	RET	C		;RETURN IF ALREADY KNOWN
	LD	BC,(LOVEC)	;PT TO VECTOR
	CALL	SVECTB		;SET THE BIT
	LD	(LOVEC),HL
;
;	SET UP VECTORS, CHECKSUMS ETC FOR NEW DISK
NEWDSK:
	LD	HL,(DPSIZ)	;SIZE IN BLOCKS OF DISK
	LD	B,004H		;CALCULATE NO OF ALLOC BYTES
	CALL	HLSRB
	INC	HL		;UP BY 1
	LD	B,H		;TO BC
	LD	C,L
	LD	HL,(ALVAD)	;PT TO ALLOC VECTOR
	LD	(HL),0
	LD	D,H
	LD	E,L
	INC	DE
	DEC	BC
	LDIR
	LD	DE,(DPALL)	;GET DIRECTORY ALLOCATION BITS
	LD	HL,(ALVAD)	;PRESET ALLOCATION OF DIRECTORY
	LD	(HL),E
	INC	HL
	LD	(HL),D
	CALL	$BHOME		;RESET DISK TO TRK ZERO ETC
	LD	HL,(NOOFDB)	;RESET NO OF DIRECTORY ENTRIES TO MIN
	LD	(HL),003H
	INC	HL
	LD	(HL),0
	CALL	STRTDI		;START DIRECTORY NO
NDNXTD:
	LD	C,0FFH		;MARK UPDATE
	CALL	NXTDIE		;GET ENTRY
	CALL	TSTEDI		;TEST IF IN RANGE
	RET	Z		;RETURN IF NOT
	CALL	PTOENT		;POINT TO ENTRY
	LD	A,0E5H		;ERASED VALUE
	CP	(HL)		;EMPTY ENTRY?
	JR	Z,NDNXTD	;J IF IT IS
	LD	A,(CURUSR)	;SAME USER?
	CP	(HL)
	JR	NZ,NDSETE
	INC	HL		;PT TO 1ST BYTE IN NAME
	LD	A,(HL)		;GET THE VALUE
	SUB	'$'		;IS IT '$'
	JR	NZ,NDSETE	;J IF NOT
	DEC	A		;SET REPLY
	LD	(IREPLY),A	;TO FF
NDSETE:
	LD	C,001H		;SET ALLOCATION VECTOR BITS FOR ENTRY
	CALL	SENTAL
	CALL	UPMAXE		;INCREASE MAX ENTRIES IF REQD
	JR	NDNXTD		;REPEAT FOR NEXT ENTRY
;
;	SET UP DRIVE FROM FCB DRIVE NO
TCBDRV:
	SET	DOP,(IY+FLAGS)
	LD	A,(IX+F.DRV)	;GET THE DRIVE/USER
	AND	01FH		;GET DRIVE NO
	DEC	A		;BACK OFF (0=DEFAULT)
	LD	(IPBYTE),A	;RESTORE VALUE
	CP	01EH		;IS IT DEFAULT
	JR	NC,SCBUSR	;J IF NOT
	LD	A,(CURDRV)	;GET THE CURRENT DRIVE NO
	LD	(SAVDSK),A	;SAVE IT
	LD	A,(IX+F.DRV)	;GET REQUIRED ONE
	LD	(DEFFLG),A	;SET DEFAULT
	AND	0E0H		;GET USER
	LD	(IX+F.DRV),A	;PUT USER AWAY
	CALL	ISELDS		;SELECT DRIVE
SCBUSR:
	LD	A,(CURUSR)	;GET THE DEFAULT USER
	OR	(IX+F.DRV)	;GET DRIVE CODE
	LD	(IX+F.DRV),A	;REPLACE
	RET			;AND EXIT
;
;	SEARCH FOR FIRST
ISFIRS:
	LD	C,0		;SET ANY MATCH
	LD	A,(IX+F.DRV)	;GET DRIVE REQD
	CP	'?'		;IS IT '?'
	JR	Z,ANYUSR	;J IF IT IS TO MATCH ANY USER
	LD	A,(IX+F.EXT)	;GET IT
	CP	'?'		;IS IT '?'
	JR	Z,ISFIR1
	LD	(IX+F.S2),0
ISFIR1:
	CALL	TCBDRV		;SET UP ANY DRIVE
	LD	C,F.EXT+1	;MATCH ALL INC S2.EXT
ANYUSR:
	CALL	FINDFI		;FIND THE FILE
	JR	MOVDIR		;AND MOVE RECORD TO BUFFER
;
;	SEARCH FOR NEXT
ISNEXT:
	LD	HL,(SVFCBA)	;GET LAST FCB ADDR
	LD	IX,(SVFCBA)
	LD	(IPWORD),HL	;AND RESET PARAMETER
	CALL	TCBDRV		;SET UP DRIVE
	CALL	GETFIE		;GET THE NEXT FILE
;
;	MOVE DIRECTORY ENTRY TO USER DMA BUFFER
MOVDIR:
	LD	HL,(DIRBUF)
	LD	DE,(USRDMA)
	LD	BC,128
	LDIR
	RET
;
;	GET LOGON VECTOR
IGLONV:
	LD	HL,(LOVEC)	;GET VECTOR
	JR	IWDREP		;AND REPLY
;
;	GET ALLOC VECTOR ADDR
IGALOV:
	LD	HL,(ALVAD)	;GET THE ADDRESS
	JR	IWDREP		;AND REPLY WITH IT
;
;	GET READ ONLY VECTOR
IGRODV:
	LD	HL,(ROVEC)	;GET THE VECTOR
	JR	IWDREP		;AND REPLY
;
;	GET DISK PARAMTETER AREA ADDRESS
IGDPAD:
	LD	HL,(DPBAD)
IWDREP:
	LD	(IREPLY),HL	;SET REPLY WORD
	RET			;AND RETURN
;
;	RESET DISK
IRESDS:
	LD	HL,(IPWORD)	;GET PARAM
RESDSK:
	LD	A,L		;MAKE MASK
	CPL
	LD	E,A
	LD	A,H
	CPL
	LD	HL,(LOVEC)	;CLEAR BITS IN LOG ON VECTOR
	AND	H
	LD	D,A
	LD	A,L
	AND	E
	LD	E,A
	LD	HL,(ROVEC)	;AND READ ONLY VECTOR
	EX	DE,HL
	LD	(LOVEC),HL
	LD	A,L
	AND	E
	LD	L,A
	LD	A,H
	AND	D
	LD	H,A
	LD	(ROVEC),HL
	RET			;EXIT
;
;	DRIVE OR DISK ERROR
ERMDSK:
	PUSH	HL
	PUSH	DE
	CALL	PUTSTR
	CALL	DNAME		;OUTPUT DRIVE LETTER
	POP	BC
	POP	DE
;
;	OUTPUT STRINGS POINTED TO BY BC AND DE
;	AND GET USER REPLY IN UPPER CASE
ERMESS:
	PUSH	DE
	CALL	PUTSTR
	POP	BC
	CALL	PUTSTR
	CALL	GNECHO		;READ A CHARACTER
	PUSH	AF
	CALL	OPCRLF		;OUTPUT NEW LINE
	POP	AF
;
;	CONVERT LETTER IN A TO UPPER CASE
UCASE:
	CP	"a"
	RET	C
	CP	"z"+1
	RET	NC
	AND	5FH
	RET
;
;	OUTPUT DRIVE LETTER
DNAME:
	LD	A,(IY+D.DRV)
	ADD	A,"A"
	LD	C,A
	CALL	ICONOP
	LD	C,":"
	CALL	ICONOP
	RET
;
;	OUTPUT FILENAME OR FILETYPE
FNAME:
	LD	C,(HL)
	INC	HL
	RES	7,C
	LD	A,C
	CP	" "
	JR	Z,FN1
	PUSH	HL
	PUSH	BC
	CALL	ICONOP
	POP	BC
	POP	HL
FN1:
	DJNZ	FNAME
	RET
;
;	DO DISK CHANGE AND DELETE
;	ANY FILE OF SAME NAME ON NEW DISK
DSKCHG:
	CALL	DOCHNG		;PROMPT USER TO CHANGE DISKS
	CALL	DEFILE		;DELETE FILE IN CASE IT EXISTS
	LD	C,F.EXT		;FIND FILE EXCLUDING EXTENT
	CALL	FINDFI		;TRY FINDING FILE
	CALL	TSTEDI		;FILE FOUND?
	JP	NZ,$BWARM	;WARM BOOT IF FOUND (USER REPLIED 'N')
	LD	(IX+F.EXT),0	;CLEAR EXTENT
	LD	(IX+F.S2),0
	RET
;
;	ERROR MESSAGES
;
$DISK:
	DEFB	07H, 0DH, 0AH
	DEFB	"Disk "
;
$NULL:
	DEFB	"$"
;
$FILE:
	DEFB	07H, 0DH, 0AH
	DEFB	"File $"
;
$DRIVE:
	DEFB	07H, 0DH, 0AH
	DEFB	"Drive $"
;
DSKFUL:
	DEFB	" Full$"
;
DIRFUL:
	DEFB	" Directory Full$"
;
WPERR:
	DEFB	" is R/O$"
;
SELERR:
	DEFB	" select error$"
;
RDERR:
	DEFB	" read error$"
;
WRERR:
	DEFB	" write error$"
;
CHGDSK:
	DEFB	0DH, 0AH, "Change Disk? (Y/N/^C) $"
;
DOIT:
	DEFB	0DH, 0AH, "Do it anyway? (Y/N/^C) $"
;
GETDRV:
	DEFB	0DH, 0AH, "Enter valid drive or ^C $"
;
CHANGE:
	DEFB	0DH, 0AH, "Change disk then hit any key or ^C$"
;
OSDATA:
FLAGS	EQU	$-OSDATA	;PLACE FOR FLAGS
	IF AUTOSIZ
	DEFB	00000000B	;ASSUME 8 BIT DIRECTORY ENTRIES
	ELSE
	IF DIRLRG
	DEFB	00000100B	;FORCE 16 BIT DIRECTORY ENTRIES
	ELSE
	DEFB	00000000B	;FORCE 8 BIT DIRECTORY ENTRIES
	ENDIF
	ENDIF
DOP	EQU	0
UPD	EQU	1
LRG	EQU	2
SIZBIT	EQU	00000100B	;**HV** WAS 00100000B
SEQ	EQU	3
ZFI	EQU	4
INT	EQU	5
IOP	EQU	6
RD	EQU	7
;	EMPTY FCB BYTE
CEMPTY:
	DEFB	D.ERAS
;	READ ONLY VECTOR..B[N] SET IF DRIVE N IS READ ONLY
ROVEC:
D.ROV	EQU	$-OSDATA
	DEFW	0
;	LOG ON VECTOR..B[N] SET IF DRIVE HAS BEEN ACCESSED
LOVEC:
	DEFW	0
;	ADDRESS OF USER'S TRANSFER BUFFER
USRDMA:
	DEFW	080H
;	NO OF DIRECTORY ENTRIES RELEVANT ON CURRENT DRIVE
NOOFDB:
	DEFW	0

;****************************************
;*	DISK PARAMETER HEADER IMAGE	*
;****************************************
;	ADDRESS OF TRANSLATE TABLE FOR DISK
XLTAD:
	DEFW	0,0
	DEFW	0,0

;	ADDRESS OF DIRECTORY BUFFER
DIRBUF:
	DEFW	0

;	ADDRESS OF DISK PARAMETER BLOCK FOR CURRENT DRIVE
DPBAD:
	DEFW	0
;	CHECKSUM VECTOR ADDRESS
CSVAD:
	DEFW	0
;	ALLOCATION VECTOR ADDRESS
ALVAD:
	DEFW	0
DPHEND:

;****************************************
;*	DISK PARAMETER BLOCK IMAGE	*
;****************************************
;	NO OF RECORDS PER TRACK ON DISK
DPSEC:
	DEFW	0
;	BLOCK SHIFT FACTOR
DPBSH:
D.BSH	EQU	$-OSDATA
	DEFB	0
;	BLOCK MASK VALUE
DPMSK:
D.MSK	EQU	$-OSDATA
	DEFB	0
;	EXTENT MASK
DPEXM:
D.EXM	EQU	$-OSDATA
	DEFB	0
;	SIZE OF DISK IN BLOCKS
DPSIZ:
	DEFW	0
;	NO OF DIRECTORY ENTRIES MAXIMUM ON DISK
DPDIR:
	DEFW	0
;	INITIAL ALLOCATION VECTOR VALUE FOR DIRECTORY
DPALL:
	DEFW	0
;	NO OF CHECKED DIRECTORY ENTRIES
DPCHK:
	DEFW	0
;	NO OF SYSTEM TRACKS
DPSYS:
	DEFW	0
DPBEND:
;******************************************************

;	INPUT PARAMETER BYTE
IPBYTE:
D.IPB	EQU	$-OSDATA
	DEFB	0
LASTDN:
	DEFB	0
;	SAVED LENGTH OF MATCH REQUIRED IN FIND FILE
SRCHLN:
D.SLN	EQU	$-OSDATA
	DEFB	0
;	SAVED FCB ADDRESS WHEN SEARCHING
SVFCBA:
	DEFW	0
;	CURRENT DISK SAVE AREA
SAVDSK:
	DEFB	0
;	PLACE TO SAVE REQD DRIVE IF NOT DEFAULT
DEFFLG:
D.DEF	EQU	$-OSDATA
	DEFB	0
;	REQUIRED INTERNAL SECTOR NO.
REQSEC:
	DEFW	0
;	REQUIRED BLOCK NO.
BLSEC:
	DEFW	0
;	OFFSET OF CURRENT ENTRY IN DIRECTORY RECORD
DIROFF:
	DEFB	0
;	ENTRY NO OF CURRENT DIRECTORY SEARCH
DIRENO:
	DEFW	0
;	REQUIRED INTERNAL SECTOR NO. OF DIRECTORY BLOCK
DIRSEC:
	DEFW	0
FLDEOP:
	DEFB	0
;	START POSITION OF CURRENT BUFFERED I/P LINE
LSTPOS:
D.LST	EQU	$-OSDATA
	DEFB	0
;	CURRENT POSITION OF CURSOR
LCUPOS:
	DEFB	0
;	SET NON-ZERO IF LIST ECHO ON
FLLSTE:
	DEFB	0
;	PLACE TO SAVE CHAR IF TYPED AHEAD
CHSAVE:
	DEFB	0
;	USER'S STACK POINTER SAVE AREA
SPSAVE:
	DEFW	0
CURUSR:
	DEFB	0
;	CURRENT DRIVE NUMBER (0-15)
CURDRV:
D.DRV	EQU	$-OSDATA
	DEFB	0
;	I/P PARAMETER SAVE AREA
IPWORD:
	DEFW	0
;	REPLY SAVE AREA (BYTE)
IREPLY:
D.REP	EQU	$-OSDATA
	DEFW	0
;	TEMP SAVE AREA FOR SEARCH LENGTH
SLTH:
	DEFB 0
;
	DS	48
;	OUR OWN INTERNAL STACK
OWNSTK:

	.DEPHASE

Subttl	Symbol Table

	END

