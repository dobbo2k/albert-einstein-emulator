;****************************************************
; EINSTEIN BIOS DISASSEMBLED FROM XTALDOS SYSTEM
; VERSION1.11		ISS.1	P.B. 850809 
;****************************************************
;
MCAL: MACRO @PRM1
      RST 8		; RESTART MCAL
      DEFB @PRM1
      ENDM
;
CDISC 	EQU 	0004H	; CURRENT DISC SELECTED
BIOS	EQU	0FA00H	; START OF BIOS
TPA 	EQU 	0100H	; NORMAL CP/M TRANSIENT AREA
LE100 	EQU 	0E100H	; ENTRY POINT
CCPC 	EQU 	0E300H	; CCP COLD START
CCPW 	EQU 	0E303H  ; CCP WARM START
BDOS 	EQU 	0EC00H	; BDOS START
DDP 	EQU 	0F9C0H	; DISC DESCRIPTOR POINTER
;
CR	EQU	0DH
LF	EQU	0AH
;
*LIST OFF
*INCLUDE A:MOSEQU.GEN
*LIST ON 
;
; START THE BIOS:
;
	ORG	BIOS
;
BCOLD:	JP LFA5E		; JUMP TO COLD START
BWARM: 	JP LFAB7		; NORMAL (WARM) RESTART
;
	JP LFA33		; CONSOLE STATUS
 	JP LFA36		; CONSOLE INPUT
	JP LFA39		; CONSOLE OUTPUT
 	JP LFA3D		; O/P TO PLL. PRINTER
	JP LFA41		; O/P TO SERIAL PORT
	JP LFA45		; I/P FROM SERIAL PORT
	JP LFA4B		; RESET DISC TO 0,0,0	
	JP LFA48		; SELECT DISC
	JP LFA52		; SET TRACK
	JP LFA4F		; SET SECTOR
	JP LFA55		; SET BUFFER
	JP LFA58		; READ 128-BYTE RECORD
	JP LFA5B		; WRITE 128-BYTE RECORD
;
	XOR A			; CLEAR A
 	NOP
 	RET
;
 	MCAL ZINIT		; INITIALISE SYSTEM
	RET
;
LFA33	MCAL ZRSCAN		; SCAN KEYBOARD (CONIN)
 	RET
;
LFA36 	MCAL ZKEYIN		; GET KEY VALUE
	RET
;
LFA39	LD A,C
	MCAL ZOUTC		; O/P <A> (CONOUT)
 	RET
;
LFA3D	LD A,C
	MCAL ZPOUT		; O/P TO PARALLEL PORT
 	RET
;
LFA41 	LD A,C
	MCAL	ZSLOUT		; O/P TO SERIAL PORT
 	RET
;
LFA45	MCAL	ZSRLIN		; I/P FROM SERIAL
 	RET
;
LFA48 	MCAL	ZSLDSC		; SELECT DISC
 	RET
;
LFA4B 	LD C,#00
	MCAL	ZSETRK		; SET TRACK
LFA4F	MCAL	ZSETSC		; SET SECTOR
 	RET
;
LFA52 	MCAL	ZSETRK		; SET TRACK
	RET
;
LFA55	MCAL	ZSETBF		; SET BUFFER (DMA?)
	RET
;
LFA58	MCAL	ZRD128		; READ A RECORD
	RET
;
LFA5B	MCAL	ZWR128		; WRITE A RECORD
	RET
;
; THIS IS THE COLD BOOT (RE-) ENTRY POINT. 
; If MOS finds a disc in D0 after reset or <ctrl-BREAK> it reads in 
; a boot sector from track 0, sector0. MOS then gets DOS start and 
; end addresses from this along with default single/double side flag 
; (0 for Single). Finally the jump address is stacked and a RETURN 
; sends us to DOS cold start and thence here. 
;
; System data:  START OF DOS = 0E100H
;               END OF DOS   = 0FB00H
;		BOOT JUMP    = 0FA00H 
;
LFA5E 	LD SP,TPA		; SET SP UNDER TPA (FOR MOS?)
	LD DE,0000H		; TO 0000H
	LD (0FB86H),DE		; CLEAR HOST ACTIVE FLAG
	LD HL,LFAD4		; 0FAD4H IN HL
 	LD BC,0008H		; DO 8 BYTES
	LDIR			; COPY FROM 0FAD4H TO 0 (SET UP CPM)
;
 	MCAL	ZLOGO		; PRINT 'EINSTEIN' LOGO
	MCAL	ZPRM		; PRINT MESSAGE
	DEFB	CR,LF
	DEFM	"TATUNG/XtalDOS 1.11       "
	DEFM	" (C) 1983 198"
	DEFB	"4"+80H
;
 	XOR A			; CLEAR A
	LD HL,CCPC		; SET UP START OF CCP FOR RET.
RCCP 	LD C,A			; CLEAR C
 	PUSH HL			; SAVE START OF CCP ON STACK
	LD HL,DDP		; SET UP POINTER FOR DPB @ F9C0H
	LD (0FBB3H),HL		
	LD HL,0FE00H		; SET SECTOR BUFFER = 0FE00H
LFAAD 	LD (0FB53H),HL
	LD HL,0000H		; SET THE 'BREAK' VECTOR TO 0
	LD (0FB30H),HL
	RET
;
; THIS IS THE WARM START RE-ENTRY POINT:
;
LFAB7 	LD SP,TPA		; RESET SP 
 	LD HL,LE100		; START VECTOR (CCP @  E300)
	LD DE,BDOS		; END (START OF BDOS)
	XOR A			; SET DISC,TRACK, SECTOR = 0
	LD B,A
	LD C,A			; NOW ARE SET UP FOR CCP 
	MCAL	ZRBLK		; READ A BLOCK INTO E100
;
 	LD HL,IOBYTE		; POINT TO DEFAULT DRIVE
 	LD A,(HL)		; GET VALUE IN AA
	CP #04			; TEST FOR 04
	JR C,0FACFH		; LESS IS OK?
	XOR A			; ELSE CLEAR 
	LD (HL),A		; DEFAULT TO D0(ONLY 4 STATES)
LFACF 	LD HL,CCPW		; POINT TO WARM CCP ENTRY
	JR RCCP			; AND JUMP TO CCP RESTART
;
; These data are copied to first 8 bytes in RAM from 
; address 0 by the cold start routine above:
;
LFAD4 	JP BWARM		; WARM START VECTOR
	DEFB  00		; INIT. TO 0
	JP BDOS			; TO SYSTEM
	DEFS  20H		; ABOUT 32 BYTE (BUFFER?)
;
; NOTE:   FB00 - FB30 (APPROX) IS THE MOS I/P LINE BUFFER
;	  (MAY BE USED BY DOS AS WELL)
;	  FB80 - FC90 (AT LEAST) IS SCRATCH PAD INITIALISED 
;	  BY THE MOS ON RESET 
;         FE00 - FFFF IS A 1 (PHYSICAL) SECTOR BUFFER FOR
;	  DISC I/O 
; 
	END	PAD INITIALISED 
;	  BY THE MOS ON RESET 
;         FE