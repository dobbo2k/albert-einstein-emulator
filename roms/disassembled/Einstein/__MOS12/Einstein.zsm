;VIDEO PROCESSOR DEFAULT VALUES
VPGTBL	EQU	0		;PATTERN GENERATOR TABLE
VSPTBL	EQU	1800H		;SPRITE/TEXT PATTERN TABLE
VPCTBL	EQU	2000H		;PATTERN COLOUR TABLE
VPNTBL	EQU	3800H		;PATTERN NAME TABLE
VSATBL	EQU	3B00H		;SPRITE ATTRIBUTE TABLE
VFKTBL	EQU	3B80H		;FUNCTION KEYS
VTTBL	EQU	3C00H		;TEXT POSITION TABLE
