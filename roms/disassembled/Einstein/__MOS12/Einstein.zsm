;***********************************************************************
;*******		DEFAULT MOS 1.2 LOCATIONS               ********
;*******	R.H0HNE				08-DEC-86	********
;***********************************************************************
;tab spacing=8
;
;HARDWARE DEPENDANT ADDRESSES
SFTRST	EQU	00H		; RESET PORT,FDC/PSG
;
PSG	EQU	00H		;PSG	00-07 	AY-3-8910
PSG_SEL	EQU 02H	;LATCH ADDRESS
PSG_RD	EQU 02H	;READ FROM PSG
PSG_WR	EQU 03H	;WRITE TO PSG
;
VDP	EQU	08H		;VDP	08-0F	TMS9129
VDP_VRAM	EQU 08H	; VRAM READ/WRITE
VDP_REG	EQU 09H	;
VDP_STAT EQU 09H	;READ VDP STATUS
;
PCI	EQU	10H		;PCI	10-17	8251
;
FDC	EQU	18H		;FDC	18-1F	FD1770
FDC_CMD	EQU	18H
FDC_STATUS	EQU	18H
FDC_TRACK	EQU	19H
FDC_SECTOR	EQU	1AH
FDC_DATA	EQU	1BH
;
KBDMSK	EQU	20H		;KEYBOARD INTERRUPT MASK
ADCMSK	EQU	21H		;ADC INTERRUPT MASK
ALPHA	EQU	22H		;TOGGLES ALPHA LED
DRVSEL	EQU	23H		;DRIVE SELECT
RAMROM	EQU	24H		;SELECT RAM/ROM
FIREMSK	EQU	25H		;FIRE INTERRUPT MASK
CTC	EQU	28H		;CTC	28-2F	Z80A CTC
PIA	EQU	30H		;PIA	30-37	Z80A PIA
ADC_PT	EQU	38H		;ADC	38-3F	ACD0844
OP80	EQU	40H		; 40 THRO' 47H ARE VIDE0 (80-COL) RAM
RG6845	EQU	48H		; 6845 REGISTER ADDRESS PORT.
DT6845	EQU	49H		; 6845 REGISTER DATA PORT.
IP80	EQU	4CH		; 80 - COL. INPUT PORT
;
;**********************************************
; MOS	EQUATES FOR EINSTEIN 
;**********************************************
;
; CALL THESE WITH     RST 8
;		      DEFB <MCAL>
; Note: In general, HL,DE,BC and AF destroyed.
;
; MCAL'S - Einstein ROM calls
MCAL	EQU	0CFH
;
ARITH:	EQU	80H	; ARITH COMMAND
BAUD:	EQU	81H	; BAUD RATE
COPY:	EQU	82H	; COPY COMMAND
DECIML:	EQU	83H	; DECIMAL
EXEC:	EQU	84H	; EXECUTE
MFILL:	EQU	85H	; FILL
GOTO:	EQU	86H	; GOTO PC
HEX:	EQU	87H	; HEXADECIMAL 
MODIFY:	EQU	8CH	; MODIFY
;
RDBLOK:	EQU	91H	; READ 2K FROM DISC
TBLATE:	EQU	93H	; TABULATE
WRBLOK:	EQU	96H	; WRITE 2K TO DISC
COLD:	EQU	97H	; "X" COLD START
WARM:	EQU	98H	; "Y" WARM START
REGSTR:	EQU	99H	; "Z" REGISTER EXAMINE
;
ZINIT:	EQU	9AH	; RE-ENTRY TO MOS
ZRSCAN:	EQU	9BH	; REPEAT KEY SCAN
ZKEYIN:	EQU	9CH	; WAIT FOR KEY I/P
ZGETLN:	EQU	9DH	; ENTER TEXT FROM (DE)
ZOUTC:	EQU	9EH	; INVERSE OF ZKEYIN
ZPOUT:	EQU	9FH	; O/P CHR. TO PLL PRINTER
ZSLOUT:	EQU	0A0H	; O/P A TO SERIAL PORT
ZSRLIN:	EQU	0A1H	; INP FROM SERIAL PORT TO A
;
ZRSECT:	EQU	0A2H	; READ 200H BYTES INTO BUFFER
ZWSECT:	EQU	0A3H	; WRITE 200H BYTES FROM BUFFER
ZRBLK:	EQU	0A4H	; READ BLOCK INTO MEMORY
ZWBLK:	EQU	0A5H	; WRITE BLOCK FROM MEMORY
;
ZCRLF:	EQU	0A6H	; O/P CR(0DH) AND LF(0AH)
ZCRLFZ:	EQU	0A7H	; O/P CRLF IF CURSOR NOT AT COL. ZERO
ZSPACE:	EQU	0A8H	; O/P 1 SPACE
;
ZPR4HX:	EQU	0A9H	; O/P (HL) AS HEX DIGITS TEXT
ZP2HXZ:	EQU	0AAH	; O/P (A) AS HEX + 1 SPACE
ZPR2HX:	EQU	0ABH	; AS ZP2HXZ BUT NO SPACE
ZFC4HX:	EQU	0ACH	; GET HEX NO FROM [DE] INTO HL
ZFCZHX:	EQU	0ADH	; GET HEX NO FROM [DE] INTO A 
;
ZDCMD:	EQU	0AEH	; O/P (A) COMMAND TO FDC
ZHMDSC:	EQU	0AFH	; HOME DISC (A) TO TK 0
;
ZIGBLK:	EQU	0B0H	; RETURN RAM [DE] IN A 
ZRDMEM:	EQU	0B1H	; RET. RAM [HL] IN A
ZRCPYU:	EQU	0B2H	; DO LDIR, SW. OUT ROM
ZRCPYD:	EQU	0B3H	; DO LDDR, SW. OUT ROM
;
ZMOUT:	EQU	0B4H	; O/P (B) TO PSG [C]
ZKSCAN:	EQU	0B5H	; GET KEY IN A (RPT)
;
; CALLS 0B6H TO 0BBH ARE DOS CALLS.
;
ZSLDSC:	EQU	0B6H	; SELECT DRIVE
ZSETRK:	EQU	0B7H	; SELECT TRACK
ZSETSC:	EQU	0B8H	; SET SECTOR
ZSETBF:	EQU	0B9H	; SET BUFFER
ZRD128:	EQU	0BAH	; READ RECORD
ZWR128:	EQU	0BBH	; WRITE RECORD	
;
ZZTIME:	EQU	0BCH	; SET UP CTC CH. 2&3 FOR 1SEC. TICK
ZFRDST:	EQU	0BDH	; RESET FDC AFTER ERROR
ZSYSRS:	EQU	0BEH	; CLEAR 40-COL
ZLOGO:	EQU	0BFH	; O/P '***EINSTEIN***' LOGO
ZPINIT:	EQU	0C0H	; SET PSG 7 TO 7FH,REST TO 0
;
ZSREG:	EQU	0C1H	; SEND ADDR. IN BC TO VDP (DATA P8)
ZVRIN:	EQU	0C2H	; VALUE FROM VRAM IN A,PTR [BC]
ZVROUT:	EQU	0C3H	; WRITE (A) TO VRAM [BC]
ZPLOT:	EQU	0C4H	; PLOT/UNPLOT A PIXEL
ZPLTXY:	EQU	0C5H	; PLOT A POINT
ZPOINT:	EQU	0C6H	; GET PIXEL STATUS
ZPNTXY:	EQU	0C7H	; GET PIXEL STATUS
ZDRWTO:	EQU	0C8H	; DRAW LINE
ZPOLYG:	EQU	0C9H	; DRAW POLYGON
ZORGCO:	EQU	0CAH	; CHANGE ORIGIN
ZCALAD:	EQU	0CBH	; GET VRAM ADDRESS
ZSETCL:	EQU	0CCH	; WRITE TO PATTERN GENERATOR TABLE
ZFILL:	EQU	0CDH	; FILL IN AREA ON SCREEN
ZIMULT:	EQU	0CEH	; FORM [DEHL] FROM [DE]*[BC]
ZPRM:	EQU	0CFH	; O/P MESSG TO SCRN, (TERM. W. +80H)
ZVOUT:	EQU	0D0H	; O/P A TO CURENT CURSOR POSN.
ZSCURS:	EQU	0D1H	; RET. VRAM (CURS) IN BC
ZROM:	EQU	0D2H	; START EXEC. FROM 4004H 2ND. ROM
;
ZIN80:	EQU	0D3H	; INIT. 80 - COL. CARD
ZST80:	EQU	0D4H	; PROG. STATUS LINE FROM [DE]
;
