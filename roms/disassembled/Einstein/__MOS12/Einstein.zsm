;
;***********************************************************************
; KEYBOARD MATRIX
;___________________________________________________________________________
;VALUE  |							      |    |
;PASSED |  01	02	04	08	10	20	40	80    |	   |
;IN 'E' |							      |    |
;_______|_____________________________________________________________|____|
;SHIFT  |  BRK		F0	F7	AL	ENT	SP	ESC   |    |
;NORM   |  							      | 01 |
;_______|_____________________________________________________________|____|
;SHIFT  |  I	O	P	1/4	POUND	VT	1/2	@     |    |
;NORM   |  i	o	p	LEFT	_	LF	||	0     |	02 |
;_______|_____________________________________________________________|____|
;SHIFT  |  K	L	+	*	3/4	BS	)	F5    |    |
;NORM   |  k	l	;	:	RIGHT	HT	9	      |	04 |
;_______|_____________________________________________________________|____|
;SHIFT  |  <	>	?	(	INS	-	DIV	F4    |    |
;NORM   |  ,	.	/	8	DEL	=	UP	      |	08 |
;_______|_____________________________________________________________|____|
;SHIFT  |  '	&	%	$	HASH	"	!	F3    |    |
;NORM   |  7	6	5	4	3	2	1	      |	10 |
;_______|_____________________________________________________________|____|
;SHIFT  |  U	Y	T	R	E	W	Q	F2    |    |
;NORM   |  u	y	t	r	e	w	q	      |	20 |
;_______|_____________________________________________________________|____|
;SHIFT  |  J	H	G	F	D	S	A	F1    |    |
;NORM   |  j	h	g	f	d	s	a	      |	40 |
;_______|_____________________________________________________________|____|
;SHIFT  |  M	N	B	V	C	X	Z	F6    |    |
;NORM   |  m	n	b	v	c	x	z	      |	80 |
;_______|_____________________________________________________________|____|
;
;***********************************************************************
;
;Port 23 (74LS273)
;
;D0	Drive Selset 0
;D1	Drive Selset 1
;D2	Drive Selset 2
;D3	Drive Selset 3
;D4	Side Select

;***********************************************************************
;FLOPPY DISC CONTROLLER COMMANDS
; DDEN - TIED TO GROUND
; INTRQ - NOT USED
; DRQ - NOT USED
;  TYPE	| COMMAND	| 7  6  5  4  3  2  1  0    |BASE CODE
;   1  	|RESTORE	| 0  0  0  0  h  V r1 r0    |	00
;   1  	|SEEK           | 0  0  0  1  h  V r1 r0    |	10
;   1  	|STEP           | 0  0  1  u  h  V r1 r0    |	20
;   1  	|STEP-IN        | 0  1  0  u  h  V r1 r0    |	40
;   1  	|STEP-OUT       | 0  1  1  u  h  V r1 r0    |	60
;   2  	|READ SECTOR    | 1  0  0  m  h  E  0  0    |	80
;   2  	|WRITE SECTOR   | 1  0  1  m  h  E  P a0    |	A0
;   2  	|READ ADDRESS   | 1  1  0  0  h  E  0  0    |	C0
;   3  	|READ TRACK     | 1  1  1  0  h  E  0  0    |	E0
;   3  	|WRITE TRACK    | 1  1  1  1  h  E  P  0    |	F0
;   4  	|FORCE INTERRUPT| 1  1  0  1 I3 I2 I1 I0    |	D0
;
;TYPE 1 COMMANDS
;h = MOTOR ON FLAG			
;h = 0,enable spin up sequence  	h = 1,disable spin up sequence
;
;V = VERIFY FLAG                  
;V = 0,no verify			V = 1,verify on destination track
;
;r1,r0 = STEPPING RATE
;0 = 6ms		1 = 12ms	2 = 20ms	3 = 30msecs
;
;u = UPDATE FLAG
;u = 0,no update			u = 1,update track register
;
;TYPE 2&3 COMMANDS
;m = MULTIPLE SECTOR FLAG
;m = 0,single sector			m = 1,multiple sector
;
;a0 = DATA ADDRESS MARK
;a0 = 0,write normal data address mark	a0 = 1,write deleted data address mark
;
;E = 30MS SETTLING TIME
;E = 0,no delay				E = 1,add 30ms delay
;
;P = WRITE PRECOMPENSATION
;P = 0,enable write precompensation	P = 1,disable write precompensation
;
;TYPE 4 COMMANDS
;I3-I0 = INTERRUPT CONDITION
;I0 = 1,don't care			I1 = 1,don't care
;I2 = 1,interrupt on index pulse	I3 = 1,immediate interrupt
;I3-I0 = 0,terminate without interrupt
;
;STATUS WORD
;BIT | | BIT NAME	 |COMMENTS	
; 7  | |MOTOR ON         |1=motor on
; 6  | |WRITE PROTECT    |1=write protect (write only)
; 5  | |RECORD TYPE      |0=data mark , 1=deleted data mark
; 5  |1|SPIN UP          |1=6 revs completed
; 4  | |RECORD NOT FOUND |1=track/sector/side not found
; 3  | |CRC ERROR        |1=error in data field
; 2  | |LOST DATA        |1=cpu didn't respond to DRQ
; 2  |1|TRACK 0          |1=track zero
; 1  | |DATA REQUEST     |1=byte ready to be read/written
; 1  |1|INDEX            |1=index
; 0  | |BUSY             |1=command in operation
;
;   Bit |      Type I      |    Type II    |   Type III    | Comments
;   ----+------------------+---------------+---------------+-------------------
;    7  |    Motor on      | ---------- Motor on --------- | / If bit 3 is
;    6  |    Not used.     | -- Disk is write protected. - | | set then:
;    5  |  Motor spin-up   |    Data type : 0 = normal.    | | If bit 4 is
;       |    completed.    |                1 = deleted.   | | set, the error
;    4  | Record not found | ----- Record not found ------ | / is in the ID
;    3  |    CRC error.    | --------- CRC error --------- |<  field. If bit 4
;    2  |   Not track 0    | ------ Lost data / byte ----- | \ is clear, the
;    1  |   Data Request   | -------- Data request ------- | | error is in
;    0  |       Busy       | ------------ Busy ----------- | \ the data field.
;
;***********************************************************************
;
;8251A PROGRAMMABLE COMMUNICATION INTERFACE
;BIT	STATUS WORD		BIT	COMMAND INSTRUCTION     
; 7	DATA SET READY           7	ENTER HUNT MODE         
; 6		                 6	INTERNAL RESET          
