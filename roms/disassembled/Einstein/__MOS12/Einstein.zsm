TFCB	EQU	BASE+005CH	; address of 1st FCB provided on command line
TBUFF	EQU	BASE+0080H	; DMA buffer used when reading/writing files
TPA	EQU	BASE+0100H
;
BS	EQU	08H
TAB	EQU	09H
CR	EQU	0DH
LF	EQU	0AH
;
