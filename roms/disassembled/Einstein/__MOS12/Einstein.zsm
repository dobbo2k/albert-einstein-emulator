FRRC	EQU	33		;RRC...RANDOM RECORD COUNT (3 BYTES)
;
FRO	EQU	FTYP		;MSB SET IF READ ONLY
FSYS	EQU	FTYP+1		;MSB SET IF SYSTEM FILE
