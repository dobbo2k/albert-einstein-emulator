FTYP	EQU	9		;TYP...NAME EXTENSION
FEXT	EQU	12		;EXT...EXTENT
FS1	EQU	13		;S1....
FS2	EQU	14		;S2....B7 SET IF NOT WRITTEN TO
				;      B0-6 ACTUAL EXTENT OPEN
FRC	EQU	15		;RC....RECORD COUNT (=128 IF EXTENT FULL)
FBLKS	EQU	16		;BLKS..16 BYTES OF BLOCK INFO
;	ITEMS BELOW DO NOT APPEAR ON DISC
