DERROR	EQU     0FB56H		;DRIVE ERROR CODE
DTRYS	EQU     0FB57H		;NUMBER OF RETRYS
HEAD0	EQU     0FB58H		;CURRENT HEAD POSITION 	- DRIVE 0
