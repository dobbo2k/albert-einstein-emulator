;**********************************************************************
;*******		EINSTEIN XDOS 2.02 CCP 			*******
;*******	R.H0HNE				29-JAN-87	*******
;******* DEC-2006   MINOR CORRECTIONS                           *******
;**********************************************************************
;
CCPNUM	EQU	22H		;VERSION NUMBER OF DOS
;
	ORG	0E100H
;
;	START UP PARAMETERS
LE100:	DEFW	0E100H		;LOAD START ADDRESS
	DEFW	0FB00H		;LOAD FINISH ADDRESS+1
	DEFW	0F800H		;LOCATION OF ENTRY POINT
;
DISCS:	DEFB	042H		;<7:4> 80 TRACK	<3:0> DOUBLE SIDED
;
	DEFS 249,0FFH
;
;	LE107 to LE1FF NOT USED
;
CPRLOC	EQU	0E200H
;
	ORG	CPRLOC
ENTRY:	JP	CPR		;PROCESS POTENTIAL DEFAULT COMMAND
	JR	CPR1		;DO NOT PROCES POTENTIAL DEFAULT COMMAND
;
CCPVER:	DEFB	CCPNUM
LE206:	DEFB	02H
MBUFF:	DEFB	3FH		;MAXIMUM BUFFER LENGTH
CBUFF:	DEFB	00H		;NO OF VALID CHARS IN COMMAND LINE
CIBUFF: DEFB	00H
CIBUF:	DEFS	61,0
;
LE247:	DEFB	63H
LE248:	DEFB	73H
CIBPTR:	DEFW	CIBUFF		;POINTER TO COMMAND INPUT BUFFER
CIPTR:	DEFW	0		;CURRENT POINTER
;
CPR1:	LD	B,CCPNUM	;CHECK CCP VERSION NUMBER
	CP	B
	JP	Z,CPR2		;J IF OK
	OUT	(24H),A		;SELECT RAM
	RST	00H		;AND REBOOT
;
;	OUTPUT <CRLF>
CRLF:	LD	A,CR
	CALL	CONOUT
	LD	A,LF		;FALL THRU TO CONOUT
;
CONOUT:	PUSH	HL
	PUSH	DE
	PUSH	BC
	PUSH	AF
	LD	E,A
	LD	C,02H		;CONSOLE OUTPUT
	CALL	BDOS
	POP	AF
	POP	BC
	POP	DE
	POP	HL
	RET
;
OPENF:	CALL	EXTST1
	XOR	A
	LD	(FCBCR),A	;CLEAR RECORD COUNT
	LD	DE,FCBDN	;PT TO FCB
	LD	C,0FH		;OPEN FILE
	JR	GRBDOS
;
SEARF:	LD	C,11H
SEAR1:	LD	DE,FCBDN	;PT TO FCB
CBDOS:	CALL	GRBDOS
	RET	NZ
;
;	NO FILE ERROR MESSAGE
PRNNF:	PUSH	AF
	CALL	PRINTC		;...DEFM
	DC	'No File'
	POP	AF
	JP	ERR
;
SEARN:	LD	C,12H		;SARCH FOR NEXT DIR ENTRY
	JR	GRBDOS
;
DELETE:	LD	C,13H		;DELETE FILE
	JR	GRBDOS
;
READF:	LD	DE,FCBDN	;PT TO FCB
	LD	C,14H		;READ SEQUENTIAL
JPBDOS:	CALL	BDOS
	OR	A
	RET
;
WRITF:	LD	DE,FCBDN	;PT TO FCB
	LD	C,15H		;WRITE SEQUENTIAL
	JR	JPBDOS
;
MAKEF:	LD	C,16H		;MAKE NEW FILE
GRBDOS:	CALL	BDOS
	INC	A
	RET
;
RENF:	LD	C,17H		;RENAME FILE
	JR	JBDOS
;
CONST:	LD	C,0BH		;GET CONSOLE STATUS
	CALL	BDOS
	OR	A
	RET	Z		;RETURN IF NO CHAR READY
CONIN:	LD	C,01H
	CALL	BDOS
	CP	1BH		;ESCAPE?
	SCF
	RET Z
	OR	A
	RET
;
;	RETURN NUMBER OF CURRENT DISC IN A
GETDRV:	LD	C,19H		;GET CURRENT DRIVE NMBER
	JR	JBDOS
;
;	SET 80H AS DMA ADDRESS
DEFDMA:	LD	DE,TBUFF
DMASET:	LD	C,1AH		;SET DMA ADDRESS
JBDOS:	JP	BDOS
;
;	GET ALLOCATION VECTOR
GETAV:	PUSH	BC
	PUSH	DE
	LD	C,1BH		;GET ALLOCTION VECTOR
	CALL	BDOS
	LD	IY,0000H
	POP	DE
	DEC	HL		;DEC ALLOCATION VECTOR
GAV1:	LD	B,08H
	INC	HL		;INC VECTOR
	LD	C,(HL)		;GET VECTOR BYTE
GAV2:	RLC	C		;TOP BIT SET?
	JR	C,GAV3		;J IF SO
	INC	IY
GAV3:	DEC	DE		;DEC PTR
	LD	A,D
	OR	E
	JR	Z,GAV4		;END IF ZERO
	DJNZ	GAV2		;LOOP UNTIL 8 BYTES DONE
	JR	GAV1		;DO NEXT 8 BYTES
;
GAV4:	PUSH	IY
	POP	HL
	POP	BC
	RET
;
GETDPB:	LD	C,1FH		;GET DISC PARAMETER BLOCK
	CALL	BDOS
	INC	HL
	INC	HL
	LD	A,(HL)
	SUB	02H
	RET
;
GETUSR:	LD	E,0FFH		;GET CURRENT USER NUMBER
	LD	C,20H		;GET/SET USER NUMBER
	JR	JBDOS
;
;--------------------------------------------------------------------------
;
;	Command:	MOS
;	Function:	To enter MOS
MOS:	LD	C,26H		;RETURN TO MOS
	JR	JBDOS
;
;--------------------------------------------------------------------------
;
;	RESET DRIVE SYSTEM
RSTDRV:	LD	B,A
	INC	B
	DEC	B
	LD	HL,0001H
	JR	Z,RSTDV2	;J IF DRIVE 0
RSTDV1:	ADD	HL,HL		;SET HL ACCORDING TO DRIVE
	DJNZ	RSTDV1
RSTDV2:	EX	DE,HL		;XFER INTO DE
	LD	C,25H		;RESET DRIVE
	JR	JBDOS
;
;
SETUD:	CALL	GETUSR
	ADD	A,A		;CONVERT INTO UPPER NIBBLE
	ADD	A,A
	ADD	A,A
	ADD	A,A
	LD	B,A
SETDD:	LD	A,(DEFDRV)
	AND	0FH		;ONLY DRIVE
	OR	B		;COMBINE USER
	LD	(DEFDRV),A	;RESET DEFAULT DRIVE
	RET
;
SETU0D:	LD	B,00H		;SET FOR USER 0
	JR	SETDD
;
;	CAPITALIZE CHAR
UCASE:	CP	'a'		;LOWER CASE A
	RET	C
	CP	'z'+1		;GREATER THEN LOWER CASE Z
	RET	NC
	AND	5FH		;CAPITALISE
	RET
;
;	PRINT STRING (ENDING >80H) PTED TO BY RETURN ADDRESS,START WITH CRLF
PRINTC:	CALL	CRLF		;NEW LINE
PRIN1:	EX	(SP),HL		;GET PTE TO STRING
;
;	PRINT STRING (ENDING >80H) PTED TO BY HL
PRIN2:	LD	A,(HL)		;GET NEXT BYTE
	BIT	7,A		;TOP BIT SET?
	RES	7,A
	CALL	CONOUT		;PRINT CHAR
	INC	HL		;PT TO NEXT BTE
	JR	Z,PRIN2		;LOOP UNTIL MSB SET
	EX	(SP),HL		;RESTORE RETURN ADDRESS
	RET			;AND RETURN
;
;	INPUT COMMAND LINE FROM USER CONSOLE
RB1:	CALL	SETUD
	LD	DE,MBUFF
	LD	C,0AH		;READ COMMAND LINE FROM USER
	CALL	BDOS
	CALL	SETU0D
	LD	HL,CBUFF	;PT TO USERS COMMAND
	LD	B,(HL)		;GET CHAR COUNT
;
;	CAPITALIZE STRING (ENDING IN 0) IN CBUFF AND SET PTR FOR PARSING
CB1:	INC	HL		;PT TO NEXT CHAR
	LD	A,B		;END OF COMMAND?
	OR	A
	JR	Z,CB2		;J IF SO
	LD	A,(HL)		;GET CHAR
	CALL	UCASE		;CAPITALIZE IT
	LD	(HL),A		;RESTORE IT
	DEC	B
	JR	CB1		;CONTINUE
;
CB2:	LD	(HL),A		;RESTORE TERMINATOR <NULL>
	LD	HL,CIBUFF	;SET COMMAND LINE POINTER TO 1ST CHAR
	LD	(CIBPTR),HL
	RET
;
;	CHECK FOR SPECIFIED DRIVE AND LOG IN DEFAULT DRIVE
;	IF SPECIFIED<>DEFAULT
DLOGIN:	CALL	GETDRV
	LD	B,A
	LD	A,(DEFDRV)	;GET DEFAULT USER/DRIVE
	AND	0FH		;GET DRIVE
	CP	B		;SAME?
	RET	Z		;RETURN IF SO
LOGIN:	LD	E,A
	LD	C,0EH
	JP	BDOS
;
;ROUTINE COMMON TO BOTH LOGIN ROUTINES; ON EXIT, Z SET MEANS ABORT
COMLOG:	LD	A,(TEMPDR)
	LD	B,A
	LD	A,(DEFDRV)
	AND	0FH		;DRIVE ONLY
	INC	B
	DEC	B
	RET	Z		;RESET IF DRIVE 0
	DEC	B
	CP	B
	LD	A,B
	RET
;
;	PRINT CURRENT DRIVE PROMPT
PRNPMT:	PUSH	HL
	PUSH	DE
	PUSH	BC
	CALL	CRLF		;NEW LINE
	CALL	GETDRV		;GET CURRENT DRIVE
	ADD	A,30H		;CONVERT TO ASCII 0-3
	CALL	CONOUT		;PRINT DRIVE
	CALL	PRIN1		;...DEFM
	DC	':'
	POP	BC
	POP	DE
	POP	HL
	RET
;
;	CHECK TO SEE IF DE PTS TO DELIMITER, IF SO RET W/ZERO FLAG SET
SDELM:	LD	A,(DE)		;GET CHAR
	OR	A		;0=DELIMITER
	RET	Z
	CP	' '		;ERROR IF LESS THAN SPACE
	JP	C,ERR
	RET	Z		;<SP>=DELIMITER
	CP	'='
	RET	Z		;'='=DELIMTER
	CP	5FH
	RET	Z		;UNDESCORE=DELIMITER
	CP	'.'
	RET	Z		;DOT=DELIMITER
	CP	':'
	RET	Z		;':'=DELIMITER
	CP	';'
	RET	Z		;';'=DELIMITER
	CP	'<'
	RET	Z		;'<'=DELIMITER
	CP	'>'
	RET
;
;	ADVANCE INPUT PTR TO FIRST NON-BLANK AND FALL THRU TO SBLANK
ADVAN:	INC	DE
;
;	SKIP STRING PTED TO BY DE (STRING ENDS IN 0) UNTIL END OF STRING
;		OR NON-BLANK ENCOUNTERED (BEGINNING OF TOKEN)
SBLANK:	LD	A,(DE)		;GET BYTE
	OR	A
	RET	Z		;RETURN IF ZERO
	CP	' '
	RET	NZ		;RETURN IF NOT BLANK
	INC	DE
	JR	SBLANK		;CONTINUE
;
;	ADD A TO HL (HL=HL+A)
ADDAH:	ADD	A,L
	LD	L,A
	RET	NC
	INC	H
	RET
;
;
EXTEST:	CALL	SLOGIN
EXTST1:	XOR	A
	LD	(FCBDN),A
	CALL	COMLOG
	RET	Z
	JR	LOGIN
;
;
SLOGIN:	CALL	SCANER
	RET	Z
	JP	ERR
;
;	EXTRACT TOKEN FROM COMMAND LINE AND PLACE IT INTO FCBDN;
;	Format FCBDN FCB if token resembles filename.type
;	On input, CIBPTR pts to char at which to start scan
;	On exit, CIPTR pts to char at which to continue
;
;	ENTRY POINTS :
;		SCANER	-  LOAD TOKEN INTO FIRST FCB
;		SCANX	-  LOAD TOKEN INTO FCB PTED TO BY HL
SCANER:	XOR	A
SCANX:	LD	HL,FCBDN
SCAN1:	CALL	ADDAH
	PUSH	HL
	XOR	A		;SET TEMP DRIVE NUMBER TO DEFAULT
	LD	(TEMPDR),A
	LD	DE,(CIBPTR)
	CALL	SBLANK		;SKIP TO NON-BLANK OR END OF LINE
	LD	(CIPTR),DE
	JR	Z,SCAN2		;J IF END OF LINE
	SUB	'0'-1		;CONVERT POSSIBLE DRIVE SPEC TO NUMBER
	LD	B,A		;STORE NUMBER IN B
	INC	DE		;PT TO NEXT CHAR
	LD	A,(DE)		;IS IT A ':'
	CP	':'
	JR	Z,SCAN3		;YES WE HAVE A DRIVE SPEC
	DEC	DE		;NO, BACK UP PTR TO FIRST NON-BLANK CHAR
SCAN2:	LD	A,(DEFDRV)	;SET 1ST BYTE OF FCBFN TO DEFAULT DRIVE
	AND	0FH
	INC	A
	LD	(HL),A
	JR	SCAN4
;
SCAN3:	LD	A,B		;WE HAVE A DRIVE SPEC
	LD	(TEMPDR),A	;SET TEMP DRIVE
	LD	(HL),B		;SET 1ST BYTE OF FCBDN TO SPECIFIED DRIVE
	INC	DE		;PT TO BYTE AFTER ':'
;
;	EXTRACT FILENAME FROM POSSIBLE FILENAME.TYPE
SCAN4:	LD	B,08H		;No OF CHARS IN NAME
	CALL	SCANF		;FILL FCB FILENAME
	CALL	SCAN8		;FILL FCB TYPE
;
;	FILL IN EX,S1,S2 AND RC WITH ZEROES
SCAN5:	INC	HL		;PT TO NEXT BYTE IN FCBFN
	LD	(HL),00H
	DJNZ	SCAN5
;
;	SCAN COMPLETE -- DE PTS TO DELIMITER BYTE AFTER TOKEN
	LD	(CIBPTR),DE
	POP	HL
	LD	BC,11
SCAN6:	INC	HL
	LD	A,(HL)
	CP	'?'
	JR	NZ,SCAN7
	INC	B
SCAN7:	DEC	C
	JR	NZ,SCAN6
	LD	A,B
	OR	A
	RET
;
;	EXTRACT FILE TYPE FROM POSSIBLE FILENAME.TYP
SCAN8:	CP	'.'		;IF (DE) DELIMITER IS A '.' WE HAVE A TYPE
	JR	NZ,SCANF5
	INC	DE
SCANF:	CALL	SDELM
	JR	Z,SCANF5
	INC	HL		;PT TO NEXT BYTE IN FCBFN
	CP	'*'		;IS (DE) A WILD CARD?
	JR	NZ,SCANF1	;CONTINUE IF NOT
	LD	(HL),'?'	;PLACE '?' IN FCBFN AND DON'T ADVANCE IF SO
	JR	SCANF2
;
SCANF1:	LD	(HL),A		;STORE FILENAME IN FCBFN
	INC	DE		;PT TO NEXT CHAR IN COMMAND LINE
SCANF2:	DJNZ	SCANF
SCANF3:	CALL	SDELM
	JR	Z,SCANF6
	INC	DE		;PT TO NEXT CHAR IN COMMAND LINE
	JR	SCANF3
;
;	FILL MEMORY PTD TO BY HL WITH SPACES FOR B BYTES
SCANF5:	INC	HL		;PT TO NEXT BYTE IN FCBFN
	LD	(HL),' '		;FILL FILENAME PART WITH <SP>
	DJNZ	SCANF5
SCANF6:	LD	B,03H		;No OF CHARS IN TYPE
	RET
;
CMDS:	DEFB	80H+'D','IR'
	DEFB	80H+'E','RA'
	DEFB	80H+'D','ISP'
	DEFB	80H+'L','OAD'
	DEFB	80H+'S','AVE'
	DEFB	80H+'R','EN'
	DEFB	80H+'P','SW'
	DEFB	80H+'G','O'
	DEFB	80H+'M','OS'
	DEFB	80H+'L','OCK'
	DEFB	80H+'U','NLOCK'
	DEFB	80H+'D','RIVE' 
	DEFB	80H
;
;	SCAN FOR CPR-RESIDENT COMMAND
CMDSER:	LD	DE,CMDS-1	;PT TO COMMAND TABLE
	LD	B,0FFH
	LD	HL,FCBFN	;PT TO STORED COMMAND NAME
CMS1:	LD	C,(HL)		;GET CHAR OF STORED NAME
	EX	DE,HL
CMS2:	INC	HL		;BUMP PT TO COMMAND TABLE
	OR	(HL)
	JP	P,CMS2
	INC	B		;INC COUNTER
	LD	A,(HL)		;GET TABLE ENTRY
	AND	7FH		;RESET MSB
	JR	Z,CMS4		;J IF END OF TABLE
	CP	C		;COMPARE AGAINST STORED NAME
	JR	NZ,CMS2
	EX	DE,HL
	PUSH	HL
CMS2A:	INC	DE		;BUMP PT TO COMMAND TABLE
	INC	HL		;BUMP PT TO STORED NAME
	LD	A,(DE)		;GET COMMAND ENTRY
	LD	C,A		;SAVE IT
	RLA
	LD	A,(HL)		;GET STORED NAME ENTRY
	JR	C,CMS3		;J IF END OF COMMAND
	CP	C		;COMPARE AGAINST NAME
	JR	Z,CMS2A		;J IF MATCH
	POP	HL
	JR	CMS1
;
CMS3:	POP	HL
	DEC	DE
	CP	' '		;NEXT CHAR IN INPUT MUST BE <SP>
	JR	NZ,CMS1
CMS4:	LD	E,B
	RET
;
;	START CPR AND DONT PROCESS DEFAULT COMMAND STORED
CPR2:	XOR	A		;SET NO DEFAULT COMMAND
	LD	(CBUFF),A
;
;	START CPR AND POSSIBLY PROCESS DEFAULT COMMAND
CPR:	LD	SP,STACK	;RESET STACK
	PUSH	BC
	LD	A,C
	RRA			;GET USER NUMBER
	RRA
	RRA
	RRA
	AND	0FH
	LD	E,A		;AND SAVE IT
	CALL	GETUSR
	LD	C,0DH		;RESET DISC SYSTEM
	CALL	BDOS
	POP	BC
	LD	A,C		;C=USER/DISC NUMBER
	AND	0FH		;EXTRACT DEFAULT DISC DRIVE
	LD	(DEFDRV),A	;SET IT
	CALL	LOGIN
	LD	A,(CBUFF)	;EXECUTE DEFAULT COMMAND?
	OR	A		;0=NO
	JR	NZ,RS1
;
;	PROMPT USER AND INPUT COMMAND LINE FROM HIM
RESTRT:	LD	SP,STACK	;RESET STACK
	CALL	PRNPMT		;PRINT CURRENT DRIVE PROMPT
	CALL	RB1
;
;	PROCESS INPUT LINE
RS1:	CALL	DEFDMA		;SET TBUFF TO DMA ADDRESS
	CALL	GETDRV		;GET DEFAULT DRIVE No
	LD	(DEFDRV),A	;SET IT
	CALL	SLOGIN
	CALL	CMDSER		;SCAN FOR CPR-RESIDENT COMMAND
	LD	HL,RSTCPR	;PUT RETURN ADDRESS OF COMMAND
	PUSH	HL		;ON THE STACK
	LD	HL,CMDTBL	;CALCULATE ADDRESS OF CPR ROUTINE
	LD	D,00H
	ADD	HL,DE
	ADD	HL,DE
	LD	A,(HL)		;GET LOW ORDER PART
	INC	HL
	LD	H,(HL)		;GET HIGH ORDER PART
	LD	L,A
	JP	(HL)		;EXECUTE CPR ROUTINE
;
;LOOK UP TABLE FOR DOS_COMMANDS
CMDTBL:	DEFW	DIR  	
	DEFW	ERA  	
	DEFW	DISP  	
	DEFW	LOAD  	
	DEFW	SAVE  	
	DEFW	REN  	
	DEFW	PSW  	
	DEFW	GO  	
	DEFW	MOS  	
	DEFW	LOCK  	
	DEFW	UNLOCK  
	DEFW	DRIVE
	DEFW	LE92A  ;/ 0D /
;
;	Extract decimal number from command line
;	  return with value in <A>
NUMBER:	CALL	SCANER		;PARSE NUMBER AND PLACE IN FCBFN
	LD	A,(TEMPDR)
	OR	A
	JR	NZ,ERROR
	LD	HL,FCBFN	;PT TO START OF TOKEN FOR CONVERSION
	LD	BC,11		;11 CHARS MAX
NUMS:	LD	A,(HL)		;GET CHAR
	SUB	'0'		;CONVERT TO BINARY
	CP	10		;ERROR IF >= 10
	JR	NC,NUM1
	INC	HL		;PT TO NEXT CHAR
	LD	D,A		;DIGIT IN <D>
	LD	A,B
	CP	01AH
	JR	NC,ERROR
	LD	A,B		;NEW VALUE = OLD VALUE * 10
	ADD	A,A
	ADD	A,A
	ADD	A,A
	ADD	A,B
	ADD	A,B
	ADD	A,D
	JR	C,ERROR		;CHECK FOR RANGE ERROR
	LD	B,A		;SET NEW VALUE
	DEC	C
	JR	NZ,NUMS		;END CHAR ?
	RET
;
NUM1:	LD	A,(HL)		;GET CHAR
	CP	' '		;DONE IF <SP>
	JR	NZ,ERROR
	INC	HL		;PT TO NEXT CHAR
	DEC	C
	JR	NZ,NUM1
	LD	A,B		;GET ACCUMULATED VALUE
	RET
;
PRNSIZ:	LD	H,00H
	LD	L,A
PRSIZ:	CALL	PRNNUM
	PUSH	DE
	LD	A,H
	OR	L
	CALL	NZ,PRSIZ
	POP	DE
	LD	A,E
	ADD	A,30H		;CONVERT INTO NUMBER 0-3
	JP	CONOUT
;
PRNNUM:	LD	BC,000AH
	LD	D,B
	LD	E,B
PRNUM:	OR	A
	SBC	HL,BC
	INC	DE
	JR	NC,PRNUM
	ADD	HL,BC
	DEC	DE
	EX	DE,HL
	RET
;
ERR:	CALL	DLOGIN
;
;	INVALID COMMAND -- PRINT IT
ERROR:	CALL	CRLF		;NEW LINE
	LD	HL,(CIPTR)
ERR1:	LD	A,(HL)		;GET CHAR
	CP	' '
	JR	Z,ERR2		;J IF <SP>
	OR	A
	JR	Z,ERR2		;J IF END OF COMMAND
	CALL	CONOUT		;PRINT COMMAND CHAR
	INC	HL		;PT TO NEXT
	JR	ERR1		;CONTNUE
;
ERR2:	CALL	PRIN1;...DEFM
	DEFB	'?',87H
	JP	RESTRT		;RESTART CCP
;
;--------------------------------------------------------------------------
;
;	Command:	DIR
;	Function:	To display a directory of the files on a disc
;	Forms:
;		DIR <afn>	Displays the DIR files
;
DIR:	CALL	SCANER		;EXTRACT POSSIBLE D:FILENAME.TYP TOKEN
	CALL	COMLOG
	PUSH	AF
	CALL	RSTDRV
	POP	AF
	CALL	LOGIN		;LOGON DRIVE IF NECESSARY
	LD	HL,FCBDN	;MAKE FCB WILD (ALL '?') IF NO FILENAME.TYP
	LD	(HL),00H
	INC	HL
	LD	A,(HL)		;GET FIRST CHAR OF FILENAME.TYPE
	CP	' '		;IF <SP>, ALL WILD
	JR	NZ,DIR1
;
;	FILL FCB @HL WITH '?'
	LD	B,11		;NUMBER OF CHARS IN FN &FT
FQLP:	LD	(HL),'?'	;STORE '?'
	INC	HL
	DJNZ	FQLP
DIR1:	CALL	GETDPB		;GET DISC PARAMETER BLOCK
	LD	(LE9F7),A
	INC	HL
	INC	HL
	LD	A,(HL)
	LD	(LE9F8),A
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	DE
	LD	(LE9F5),DE
	LD	HL,0000H
	LD	(LE9F3),HL
	LD	HL,LE9DA
	LD	(HL),3FH
	LD	C,11H		;SEARCH FOR FIRST
	LD	DE,FCBDN
	CALL	GRBDOS
	JR	Z,DIR3
	LD	DE,(LE206)
	LD	D,0CH
	DEC	E
DIR2:	PUSH	AF
	CALL	DIR4
	POP	BC
	LD	A,B
	RET	C
	CALL	DIR6
	PUSH	DE
	CALL	SEARN
	POP	DE
	JR	NZ,DIR2
DIR3:	CALL	CRLF		;NEW LINE
	LD	HL,(LE9F3)
	CALL	CNVSIZ
	CALL	PRIN1		;...DEFM
	DC	'k Size, '
	LD	DE,(LE9F5)
	PUSH	DE
	CALL	GETAV
	CALL	CNVSIZ
	CALL	PRIN1		;...DEFM
	DC	'k Free, '
	POP	HL
	CALL	CNVSIZ
	CALL	PRIN1		;...DEFM
	DC	'k Total'
	RET
;
DIR4:	LD	A,(LE206)
DIR5:	DEC	A
	CP	E
	RET	NZ
	PUSH	DE
	PUSH	BC
	CALL	CONST
	POP	BC
	POP	DE
	RET	C
	DEC	D
	RET	NZ
	LD	D,0CH
	JP	CONIN
;
DIR6:	DEC	A
	AND	03H
	RRCA
	RRCA
	RRCA
	LD	HL,0081H
	ADD	A,L
	LD	L,A
	PUSH	HL
	POP	IX
	BIT	7,(IX+09H)	;CHECK SYSTEM FLAG
	RET	NZ
	PUSH	HL
	LD	BC,000FH
	ADD	HL,BC
	LD	B,10H
DIR7:	LD	A,(LE9F8)
	OR	A
	LD	A,(HL)
	INC	HL
	JR	Z,DIR8
	DEC	B
	OR	(HL)
	INC	HL
DIR8:	OR	A
	JR	Z,LE689
	PUSH	DE
	LD	DE,(LE9F3)
	INC	DE
	LD	(LE9F3),DE
	POP	DE
LE689:	DJNZ	DIR7
	POP	HL
	LD	A,(IX+0BH)
	OR	A
	RET	NZ
	LD	A,(LE206)
	INC	E
	CP	E
	JR	NZ,PRTENT
	LD	E,00H
	CALL	PRNPMT
	JR	PRNENT
;
;	PRINT DIRECTORY ENTRY
PRTENT:	CALL	PRIN1		;...DEFM
	DC	' :'
PRNENT:	BIT	7,(IX+08H)	;CHECK IF FILE LOCKED
	LD	A,' '
	JR	Z,PRENT		;J IF FILE NOT LOCKED
	LD	A,'*'
PRENT:	LD	B,08H		;NUMBER OF CHARS IN FILENAME
	PUSH	HL
	CALL	PRNSTR		;PRINT FILENAME
	LD	A,'.'
	LD	B,03H		;NUMBER OF CHARS IN TYPE
	CALL	PRNSTR		;PRINT TYPE
	POP	HL
	RET
;
CNVSIZ:	LD	A,(LE9F7)
	LD	B,A
	JR	CALSIZ
;
DBLSIZ:	ADD	HL,HL
CALSIZ:	DJNZ	DBLSIZ
	JP	PRSIZ
;
;	PRINT STRING OF LENGTH B BYTES
PRNSTR:	CALL	CONOUT		;O/P TO CRT
	LD	A,(HL)		;GET CHAR
	AND	7FH		;RESET MSB
	INC	HL		;PT TO NEXT CHAR
	DJNZ	PRNSTR		;END OF STRING?
	JP	CONOUT		;O/P TO CRT AND RETURN TO CALLER
;
;--------------------------------------------------------------------------
;
;	Command:	ERA
;	Function:	To erase specified files on a disc
;	Forms:
;		ERA D:FILENAME.TYPE
;
ERA:	CALL	SCANER		;PARSE FILE SPECIFICATION
	CALL	EXTST1
	LD	HL,0000H	;SET TO FIRST ENTRY
	LD	(ERA_ENO),HL
	CALL	SEARF
ERA1:	LD	HL,ERA_ENO
	INC	(HL)		;SET TO NEXT ENTRY
ERA2:	LD	B,(HL)		;GET IT
	PUSH	BC
	LD	DE,FCBDN
	LD	C,11H		;GET FIRST DIRECTORY
	JR	ERA4
;
ERA3:	PUSH	BC
	LD	C,12H		;GET NEXT DIRECTORY
ERA4:	CALL	GRBDOS
	POP	BC
	RET	Z
	DJNZ	ERA3
	PUSH	AF
	LD	A,(LE206)
	DEC	A
	LD	E,A
	POP	AF
	CALL	DIR6
	DEC	HL
	LD	DE,TFCB
	LD	BC,0020H
	LDIR
	LD	A,(AUTO_ERA)	;CHECK ERASE FLAG
	OR	A
	JR	NZ,ERA6		;J IF NOT TO QUERY
	CALL	PRIN1		;...DEFM
	DC	'?'		;QUERY ACTION
	CALL	CONIN		;GET REPLY
	RET	C
	AND	5FH
	CP	'A'		;ALL ?
	JR	NZ,ERA5
	LD	A,'Y'
	LD	(AUTO_ERA),A	;SET FOR NO QUERY
ERA5:	CP	'F'		;FINISH ?
	RET	Z
ERA6:	CP	'Y'
	JR	NZ,ERA1		;J IF NOT TO ERASE
	XOR	A
	LD	IX,TFCB		;CLEAR EXENT AND CURRENT RECORD
	LD	(IX+FEXT),A
	LD	(IX+FCR),A
	BIT	7,(IX+FRO)	;CHECK IF FLE LOCKED
	RES	7,(IX+FRO)
	JR	Z,ERA7		;J IF NOT
	CALL	PRIN1		;...DEFM
	DC	' Unlock(Y/N)?'
	CALL	CONIN
	RET	C
	CP	'Y'
	JR	NZ,ERA1
	LD	DE,TFCB
	LD	C,1EH
	CALL	CBDOS
ERA7:	LD	DE,TFCB		;DELETE SPECIFIED FILE
	CALL	DELETE
	INC	A
	JR	Z,ERA8
	CALL	PRIN1		;...DEFM
	DEFB	09H
    DC	'Erased'
ERA8:	LD	HL,ERA_ENO
	JP	ERA2
;
;--------------------------------------------------------------------------
;
;	Command:	PSW
;	Function:	To set the system password
PSW:	CALL	SLOGIN
	LD	DE,FCBFN
	LD	A,(DE)
	SUB	20H
	JR	NZ,PSW2
PSW1:	LD	(DE),A
PSW2:	LD	C,27H
	CALL	BDOS
	OR	A
	JP	NZ,ERR
	RET
;
;--------------------------------------------------------------------------
;
;	Command:	LOCK
;	Function:	To set a specified file as read only
LOCK:	CALL	LE7C4
	SET	7,(IX+FRO)
	JR	Z,LOCK2
	CP	'S'
	JP	NZ,ERR
	SET	7,(IX+FSYS)
LOCK1:	CALL	ADVAN
LOCK2:	LD	(CIBPTR),DE
	LD	C,1EH
	JP	SEAR1
;
;--------------------------------------------------------------------------
;
;	Command:	UNLOCK
;	Function:	To set a specified file as read/write
UNLOCK:	CALL	LE7C4
	RES	7,(IX+FRO)
	JR	Z,LOCK2
	CP	'S'
	JP	NZ,ERR
	RES	7,(IX+FSYS)
	JR	LOCK1
;
LE7C4:	CALL	EXTEST
	LD	DE,(CIBPTR)
	CALL	SBLANK
	LD	IX,FCBDN
	RET
;
;--------------------------------------------------------------------------
;
;	Command:	DISP
;	Function:	To display a specified file on the CON: device
DISP:	CALL	SLOGIN		;LOGIN SELECTED DISC IF ANY
	CALL	OPENF		;OPEN SELECTED FILE
	JR	Z,DISP4		;ABORT IF ERROR
	CALL	CRLF		;NEW LINE
	LD	HL,CHRCNT	;SET CHAR POSITION/COUNT
	LD	(HL),7FH	;EMPTY LINE
DISP1:	LD	A,(CHRCNT)	;CHECK COUNT
	INC	A
	CP	80H		;END OF BUFFER?
	JR	C,DISP2
	CALL	READF
	JR	NZ,DISP3	;J IF ERROR
	XOR	A		;CLEAR COUNT
DISP2:	LD	(CHRCNT),A	;UPDATE COUNT
	LD	HL,TBUFF	;PT TO BUFFER
	CALL	ADDAH		;CALC ADDRESS OF NEXT CHAR FROM OFFSET
	LD	A,(HL)		;GET CHAR
	CP	1AH		;END OF FILE?
	RET	Z		;RESTART CCP IF SO
	CALL	CONOUT		;OUTPUT CHAR
	CALL	CONST
	RET	C
	JR	DISP1
;
DISP3:	DEC	A
	RET	Z
	CALL	PRINTC		;...DEFM
	DC	'Read Error'
DISP4:	JP	ERR
;
;--------------------------------------------------------------------------
;
;	Command:	SAVE
;	Function:	To save the contents of the TPA onto disc as the 
;			specified file and defined length
SAVE:	CALL	NUMBER
	PUSH	AF		;SAVE NUMBER OF BLOCKS
	CALL	EXTEST
	LD	DE,FCBDN
	PUSH	DE
	CALL	DELETE		;DELETE EXISTING FILE
	POP	DE
	CALL	MAKEF		;MAKE NEW FILE
	JR	Z,SAVE3
	XOR	A		;SET RECORD COUNT FIELD OF NEW FILE'S FCB
	LD	(FCBCR),A
	POP	AF		;RETRIEVE BLOCK COUNT
	LD	L,A
	LD	H,00H
	ADD	HL,HL
	LD	DE,TPA		;PT TO START OF SAVE
SAVE1:	LD	A,H		;DONE WITH SAVE?
	OR	L		;HL=0 IF SO
	JR	Z,SAVE2
	DEC	HL		;COUNT DOWN ON SECTORS
	PUSH	HL		;SAVE PTR TO BLOCK TO SAVE
	LD	HL,128		;128 BYTES PER SECTOR
	ADD	HL,DE		;PT TO NEXT SECTOR
	PUSH	HL		;SAVE IT
	CALL	DMASET		;SET DMA ADDRESS FOR WRITE
	CALL	WRITF		;WRITE SECTOR
	POP	DE		;GET PTR TO NEXT SECTOR
	POP	HL		;GET SECTOR COUNT
	JR	NZ,SAVE3	;WRITE ERROR ?
	JR	SAVE1		;CONTINUE
;
SAVE2:	LD	DE,FCBDN	;CLOSE SAVED FILE
	LD	C,10H
	CALL	GRBDOS
	INC	A		;ERROR ?
	JR	NZ,SAVE4
SAVE3:	CALL	PRINTC		;...DEFM
	DC	'No Space'
SAVE4:	JP	DEFDMA		;SET DMA TO 0080H
;
;--------------------------------------------------------------------------
;
;	Command:	REN
;	Function:	To change the name of an existing file
REN:	CALL	EXTEST
	LD	A,(TEMPDR)	;SAVE CURRENT DEFAULT DISC
	PUSH	AF		;SAVE ON STACK
	CALL	SEARF		;LOOK FOR SPECIFIED FILE
	JR	Z,REN3
	LD	DE,(CIBPTR)
	CALL	SBLANK
	CP	54H
	JR	NZ,REN1
	INC	DE
	LD	A,(DE)
	CP	4FH
	JR	NZ,REN1
	EX	DE,HL
	INC	HL
	LD	(CIBPTR),HL
	XOR	A
	LD	HL,LE9DE
	CALL	SCAN1
	JR	NZ,REN1
	POP	AF		;GET OLD DEFAULT DRIVE
	LD	B,A		;SAVE IT
	LD	HL,TEMPDR	;COMPARE IT AGAINST CURRENT DEFAULT DRIVE
	LD	A,(HL)		;MATCH ?
	OR	A
	JR	Z,REN2
	CP	B		;CHECK FOR DRIVE ERROR
	LD	(HL),B
REN1:	JP	NZ,ERR
REN2:	LD	(HL),B
	XOR	A
	LD	DE,LE9DE
	LD	(DE),A
	LD	C,11H		;SEARCH FOR FIRST
	CALL	GRBDOS
	JR	NZ,PRNFE
	LD	DE,FCBDN
	JP	RENF
;
;	FILE EXISTS ERROR MESSAGE
PRNFE:	CALL	PRINTC		;...DEFM
	DC	'File Exists'
	RET
;
REN3:	POP	AF
	RET
;
;--------------------------------------------------------------------------
;
;	Command:	LOAD
;	Function:	To load the specified file into the TPA
LOAD:	CALL	SLOGIN
	CALL	MLA
	CALL	CRLF		;NEW LINE
	DEC	HL
	LD	L,H
	LD	H,00H
	CALL	PRSIZ
	CALL	PRIN1		;...DEFM
	DC	' Block(s)'
	RET
;
MLA:	CALL	OPENF
	CALL	Z,PRNNF		;PRINT NO FILE ERROR MESSAGE
	JR	Z,DFUSR
	LD	HL,TPA		;PT TO LOAD ADDRESS
MLA1:	PUSH	HL		;SAVE ADDRESS OF NEXT SECTOR
	EX	DE,HL			;...IN DE
	CALL	DMASET		;SET DMA ADDRESS FOR LOAD
	CALL	READF
	POP	HL		;GET ADDRESS OF NEXT SECTOR
	JR	NZ,MLA2
	LD	DE,128		;MOVE 128 BYTES PER SECTOR
	ADD	HL,DE		;PT TO NEXT SECTOR IN HL
	LD	DE,ENTRY	;TEST IF MEM FULL
	SBC	HL,DE
	ADD	HL,DE
	JR	C,MLA1		;J IF NOT FULL
PRNLE:	CALL	PRINTC		;...DEFM
	DC	'Mem Full'
DFUSR:	POP	AF
	RET
;
MLA2:	DEC	A
	JR	NZ,PRNLE
	RET
;
;--------------------------------------------------------------------------
;
;	Command:	DRIVE
;	Function:	To select and logon the specified drive
DRIVE:	CALL	NUMBER
DRV1:	CP	0AH
	JP	NC,ERR
	LD	(DEFDRV),A
	CALL	SETU0D
	CALL	LOGIN
	JP	RCPRNL
;
LE92A:	LD	A,(FCBFN)
	CP	' '
	JR	NZ,FILCOM
	LD	A,(TEMPDR)
	OR	A
	JR	Z,LE9A2
	DEC	A
	JR	DRV1
;
FILCOM:	LD	DE,LE9D7
	LD	A,(DE)
	CP	' '
	JR	NZ,LE94B
	EX	DE,HL
	LD	(HL),'C'
	INC	HL
	LD	(HL),'O'
	INC	HL
	LD	(HL),'M'
LE94B:	CALL	MLA
;
;--------------------------------------------------------------------------
;
;	Command:	GO
;	Function:	To call a program allready existing in the TPA
GO:	CALL	DLOGIN
	LD	HL,(CIBPTR)
	PUSH	HL
	CALL	SCANER
	LD	HL,TEMPDR
	PUSH	HL
	LD	A,(HL)
	LD	(FCBDN),A
	LD	A,10H
	CALL	SCANX
	POP	HL
	LD	A,(HL)
	LD	(LE9DE),A
	XOR	A
	LD	(FCBCR),A
	LD	DE,TFCB
	LD	HL,FCBDN
	LD	BC,0021H
	LDIR
	POP	HL
	LD	DE,0081H
GO1:	LD	A,(HL)
	LD	(DE),A
	OR	A
	JR	Z,LE987
	INC	B
	INC	HL
	INC	DE
	JR	GO1
;
LE987:	LD	A,B
	LD	(TBUFF),A
	CALL	CRLF
	CALL	DEFDMA
	CALL	SETUD
	CALL	TPA
	LD	SP,STACK
	CALL	SETU0D
	CALL	LOGIN
	JR	LE9AB
;
LE9A2:	POP	AF
LE9A3:	JR	RCPRNL
;
;	ENTRY POINT FOR RESTARTING CPR AND LOGGING ON DEFAULT DRIVE
RSTCPR:	CALL	DLOGIN
;
;	ENTRY POINT FOR RESTARTING CPR AND WITHOUT LOGGING ON DEFAULT DRIVE
RCPRNL:	CALL	SCANER
LE9AB:	JP	RESTRT

;DEFT
LE9AE:	DEFB	061H,000H,000H,000H
LE9B2:	DEFB	000H,000H,000H,000H
LE9B6:	DEFB	000H,000H,000H,000H
LE9BA:	DEFB	000H,000H,000H,000H
LE9BE:	DEFB	000H,000H,000H,000H
LE9C2:	DEFB	000H,000H,000H,000H
LE9C6:	DEFB	000H,000H,000H,000H
LE9CA:	DEFB	000H,000H,000H,000H
STACK	EQU	$
FCBDN:	DEFB	000H
FCBFN:	DEFB	000H,000H,000H
LE9D2:	DEFB	000H,000H,000H,000H
LE9D6:	DEFB	000H
LE9D7:	DEFB	000H,000H,000H
LE9DA:	DEFB	000H,000H,000H,000H
LE9DE:	DEFB	000H,000H,000H,000H
LE9E2:	DEFB	000H,000H,000H,000H
LE9E6:	DEFB	000H,000H,000H,000H
LE9EA:	DEFB	000H,000H,000H,000H
FCBCR:	DEFB	00H
TEMPDR:	DEFB	00H
CHRCNT:	DEFB	00H
ERA_ENO:	DEFB	000H	;DIRECTORY ENTRY NUMBER FOR ERASE
AUTO_ERA:	DEFB	00H	;SET TO 'Y' FOR AUTOMATIC ERASURE
LE9F3:	DEFW	0000H
LE9F5:	DEFW	0000H
LE9F7:	DEFB	000H
LE9F8:	DEFB	000H,074H
LE9FA:	DEFB	0C3H,011H,0EAH,0E3H
LE9FE:	DEFB	0EAH,019H


