;**********************************************************************
;*******			XDOS 202			*******
;*******	R.H0HNE				13-AUG-87	*******
;******* DEC-2006   MINOR CORRECTIONS                           *******
;**********************************************************************
;
DERAS	EQU	0E5H		;VALUE OF ERASED BYTE
;
	ORG	0EA00H
;
;	MAJOR ENTRY POINT FOR INTERFACE
LDOS:	JP	IEXENT1
;
;	POINTERS TO DRIVE ERROR ROTINES
PTRBD:	DEFW	ERR_BD		;BAD DATA
PTRND:	DEFW	ERR_ND		;NO DRIVE
PTRDL:	DEFW	ERR_DL		;DRIVE LOCKED
PTRFL:	DEFW	ERR_FL		;FILE LOCKED
PTRWP:	DEFW	ERR_WP		;WRITE PROTECTED
PTRNS:	DEFW	ERR_NS		;NO SECTOR
PTRNR:	DEFW	ERR_NR		;DRIVE NOT READY
;
IEXENT1:LD	(HLSAVE),HL
	LD	(SPSAVE),SP
	LD	SP,OWNSTK
	LD	HL,IEXIT
	PUSH	HL
	PUSH	AF
	LD	A,C
	LD	(IPWORD),DE
	LD	(IXSAVE),IX
	LD	(IYSAVE),IY
	LD	IY,(IPWORD)
	PUSH	AF
	LD	A,E
	LD	(IPBYTE),A
	LD	HL,0
	LD	(IREPLY),HL
	XOR	A
	LD	(DEFFLG),A
	LD	(LF77A),A
	POP	AF
	LD	HL,XPOINT
	EX	(SP),HL
	CP	29H
	RET	NC
	PUSH	HL
	LD	C,E
	LD	HL,FJTAB
	ADD	A,A
	ADD	A,L
	LD	L,A
	JR	NC,IEXENT2
	INC	H
IEXENT2:LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	POP	AF
	PUSH	HL
	LD	HL,(HLSAVE)
	RET
;
;	RETURN MADE HERE AFTER DOS ROUTINES
IEXIT:	LD	SP,(SPSAVE)
	RET
;
;LOOK UP TABLE FOR ITP'S
FJTAB:	DEFW	BWARM
	DEFW	ICONIE
	DEFW	ICONOP
	DEFW	IAUXIN
	DEFW	BPUNO
	DEFW	BLSTO
	DEFW	IDIRIO
	DEFW	IGETIO
	DEFW	ISETIO
	DEFW	IPUTST
	DEFW	IGETLI
	DEFW	ICONST
	DEFW	IGVERS
	DEFW	IRESET
	DEFW	ISELDS
	DEFW	IOPENF
	DEFW	ICLOSF
	DEFW	ISFIRS
	DEFW	ISNEXT
	DEFW	IDELEF
	DEFW	IRDSEQ
	DEFW	IWRSEQ
	DEFW	IMAKEF
	DEFW	IRENAF
	DEFW	IGLONV
	DEFW	IGCDSK
	DEFW	ISETDM
	DEFW	IGALOV
	DEFW	ISETRO
	DEFW	IGRODV
	DEFW	ISETAT
	DEFW	IGDPAD
	DEFW	IGSUSR
	DEFW	IRDRAN
	DEFW	IWRRAN
	DEFW	IFILSZ
	DEFW	ISETRA
	DEFW	IRESDS
	DEFW	BINIT
	DEFW	ISETPW
	DEFW	IWRRAZ       
FJE:
;
;	SORT OUT DISC ERRORS
DSK_ERR:DEC	A
	LD	HL,PTRBD
	JR	Z,ERR_PTR
	DEC	A
	LD	HL,PTRWP
	JR	Z,ERR_PTR
	DEC	A
	LD	HL,PTRNS
	JR	Z,ERR_PTR
	DEC	A
	LD	HL,PTRNR
	JR	Z,ERR_PTR
LEACF:	LD	HL,PTRND
ERR_PTR:LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	JP	(HL)
;
;	DISC NOT READY ERROR MESSAGE
ERR_NR:	LD	B,04H
	JR	PRT_ERR
;
;	DISC NO SECTOR ERROR MESSAGE
ERR_NS:	LD	B,03H
	JR	PRT_ERR
;
;	DISC WRITE PROTECTED ERROR MESSAGE
ERR_WP:	LD	B,02H
	JR	PRT_ERR
;
;	DISC BAD DATA ERROR
ERR_BD:	LD	B,01H
PRT_ERR:CALL	PUT_MSG
	LD	HL,DOIT
D_ERR1:	CALL	PUTSTR
D_ERR2:	CALL	GNCHAR
	CP	03H
	JR	Z,D_ERR3
	AND	5FH
	CP	'N'
	JR	Z,D_ERR3
	CP	'Y'
	JR	NZ,D_ERR2
D_ERR3:	CALL	OPCH
	CP	'Y'
	RET	Z
	XOR	A
	LD	(DEFDRV),A
	RST	00H
;
;	DISC DRIVE LOCKED ERROR MESSAGE
ERR_DL:	LD	B,07H
	CALL	PUT_MSG
	LD	HL,ABORT
	CALL	PUTSTR
	CALL	GNECHO
	RST	00H
;
;	DRIVE SELECT ERROR MESSAGE
ERR_ND:	LD	B,05H
	CALL	PUT_MSG
	LD	HL,NEWDRV
	CALL	PUTSTR
	CALL	GNECHO
	SUB	30H
	LD	(CURDRV),A
	JP	LOGOND
;
;	DISC FILE LOCKED ERROR MESSAGE
ERR_FL:	LD	B,06H
	CALL	PUT_MSG
	LD	HL,UNLCK
	JR	D_ERR1
;
PUT_MSG:PUSH	HL
	CALL	OPCRLF
	LD	A,(CURDRV)
	ADD	A,30H
	LD	(DISK),A
	LD	HL,BADDAT
FNDMSG:	LD	A,(HL)
	INC	HL
	BIT	7,A
	JR	Z,FNDMSG
	DJNZ	FNDMSG
PRTMSG:	RES	7,A
	CALL	OPCH
	LD	A,(HL)
	INC	HL
	BIT	7,A
	JR	Z,PRTMSG
	LD	HL,DRVMSG
	CALL	PUTSTR
	POP	HL
	RET
;
DRVMSG:	DEFB	', Drive '
DISK:	DEFB	' : $'
BADDAT:	DEFB	80H+'B','ad Data'
LEB77:	DEFB	80H+'W','rite Protect'
LEB84:	DEFB	80H+'N','o Sector'
LEB8D:	DEFB	80H+'N','ot Ready'
LEB96:	DEFB	80H+'N','o Drive'
LEB9E:	DEFB	80H+'F','ile Lock'
LEBA7:	DEFB	80H+'D','rive Lock'
LEBB1:	DEFB	80H
;
DOIT:	DEFB	CR,LF,'Try Again(Y/N)?$'
UNLCK:	DEFB	CR,LF,'Unlock(Y/N)?$'
NEWDRV:	DEFB	CR,LF,'Which Drive?$'
ABORT:	DEFB	CR,LF,'Press any key to abort:$'
;
;	GET NEXT CHAR FROM CONSOLE
GNCHAR:	LD	HL,CHSAVE
	LD	A,(HL)
	LD	(HL),00H
	OR	A
	RET	NZ
	JP	BCONI
;	
;	GET A CHAR AND ECHO ON CONSOLE
GNECHO:CALL	GNCHAR
	CALL	CMPCHR
	RET	C
	PUSH	AF
	CALL	CONOP1
	POP	AF
	RET
;
;	TEST IF KNOWN CONTROL CHAR
CMPCHR:CP	CR
	RET	Z
	CP	LF
	RET	Z
	CP	TAB
	RET	Z
	CP	BS
	RET	Z
	CP	' '
	RET
;
;	TEST IF CONSOLE READY
TCIRDY:	LD	A,(CHSAVE)
	OR	A
	JR	NZ,CIRDY
	CALL	BCONS
	OR	A
	RET	Z
	CALL	BCONI
	CP	13H
	JR	NZ,SAVNXC
	CALL	BCONI
	CP	03H
	JP	Z,REBOOT
	XOR	A
	RET
;
SAVNXC:	LD	(CHSAVE),A
CIRDY:	LD	A,01H
	RET
;
;	OUTPUT CR/LF TO CONSOLE
OPCRLF:	LD	A,CR
	CALL	PUTCH
	LD	A,LF
;
;	PUT CHAR ON CONSOLE
PUTCH:	LD	C,A
	LD	A,(FLDEOP)
	OR	A
	LD	A,C
	JR	NZ,UPLPOS
	PUSH	AF
	PUSH	BC
	CALL	TCIRDY
	POP	BC
	POP	AF
	CALL	BCONO
;
;	WORK OUT POSITION OF CURSOR
UPLPOS:	LD	HL,LCUPOS
	CP	7FH
	RET	Z
	INC	(HL)
	CP	' '
	RET	NC
	DEC	(HL)
	RET	Z
	CP	BS
	JR	NZ,TIFLF
	DEC	(HL)
	RET
;
TIFLF:	CP	LF
	RET	NZ
	LD	(HL),0
	RET
;
;	OUTPUT CHAR ALLOWING FOR TABS
OPCH:	PUSH	BC
	PUSH	HL
	CALL	CMPCHR
	JR	NC,CONOP
	PUSH	AF
	LD	A,5EH
	CALL	PUTCH
	POP	AF
	OR	40H
CONOP:	CALL	CONOP1
	POP	HL
	POP	BC
	RET
;
;	OUTPUT CHAR TO CONSOLE
ICONOP:	LD	A,C
CONOP1:	CP	TAB
	JR	NZ,PUTCH
TABOP:	LD	A,' '
	CALL	PUTCH
	LD	A,(LCUPOS)
	AND	07H
	JR	NZ,TABOP
	RET
;
;	REMOVE PREVIOUS CHAR
BSSPBS:	CALL	OPBSP
	LD	C,' '
	CALL	BCONO
OPBSP:	LD	C,BS
	JP	BCONO
;
;	CANCEL INPUT
KILLIN:	LD	A,23H
	CALL	PUTCH
	CALL	OPCRLF
;
;	REPOSITION CURSOR AT START OF OLD LINE
POSCUR:	LD	A,(LCUPOS)
	LD	HL,LSTPOS
	CP	(HL)
	RET	NC
	LD	A,' '
	CALL	PUTCH
	JR	POSCUR
;
;	TYPE STRING TERMINATED BY $
IPUTST:	EX	DE,HL
;
;	OUTPUT STRING TERMINATED BY $
PUTSTR:	LD	A,(HL)
	CP	'$'
	RET	Z
	INC	HL
	PUSH	HL
	CALL	CONOP1
	POP	HL
	JR	PUTSTR
;
;	GET BUFFER LINE FROM CONSOLE WITH EDITING
IGETLI:	LD	A,(LCUPOS)
	LD	(LSTPOS),A
	LD	HL,(IPWORD)
	LD	C,(HL)
	INC	HL
	PUSH	HL
	LD	B,0
GLIREP:	PUSH	BC
	PUSH	HL
GLICH:	CALL	GNCHAR
	POP	HL
	POP	BC
	CP	CR
	JP	Z,GLIFIN
	CP	LF
	JP	Z,GLIFIN
	CP	BS
	JR	NZ,TRYCAN
GLICH1:	LD	A,B
	OR	A
	JR	Z,GLIREP
	DEC	B
	LD	A,(LCUPOS)
	LD	(FLDEOP),A
	PUSH	BC
	CALL	KILLIN
	POP	BC
	POP	HL
	PUSH	HL
	PUSH	BC
PUTLIC:	LD	A,B
	OR	A
	JR	Z,GLIBAK
	INC	HL
	LD	A,(HL)
	DEC	B
	CALL	OPCH
	JR	PUTLIC
;
GLIBAK:	PUSH	HL
	LD	A,(FLDEOP)
	OR	A
LIBAK1:	JR	Z,GLICH
	LD	HL,LCUPOS
	SUB	(HL)
	LD	(FLDEOP),A
GLIBSB:	CALL	BSSPBS
	LD	HL,FLDEOP
	DEC	(HL)
	JR	NZ,GLIBSB
	JR	LIBAK1
;
TRYCAN:	CP	19H
	JR	Z,GLICH1
	CP	18H
	JR	NZ,TRYU
	POP	HL
CLRLIN:	LD	A,(LSTPOS)
	LD	HL,LCUPOS
	CP	(HL)
	JR	NC,IGETLI
	DEC	(HL)
	CALL	BSSPBS
	JR	CLRLIN
;
TRYU:	CP	11H
	JR	C,GLISTO
	CP	15H
	JR	NC,GLISTO
	PUSH	HL
	PUSH	BC
	CALL	CONOP1
	POP	BC
	POP	HL
	JR	GLIREP
;
GLISTO:	INC	HL
	LD	(HL),A
	INC	B
	PUSH	AF
	CALL	OPCH
	POP	AF
	CP	03H
	LD	A,B
	JR	NZ,GLINAB
	CP	01H
	JP	Z,REBOOT
GLINAB:	CP	C
	JP	C,GLIREP
GLIFIN:	POP	HL
	LD	(HL),B
	LD	A,0DH
	JP	PUTCH
;
;	CONSOLE INPUT WITH ECHO
ICONIE:	CALL	GNECHO
	JR	IREPEX
;
;	RS232 INPUT
IAUXIN:	CALL	BPUNI
	JR	IREPEX
;
;	DIRECT CONSOLE I/O
IDIRIO:	LD	A,C
	CP	0FFH
	JR	Z,ICONIQ
	CP	0FEH
	JP	NZ,BCONO
	JP	BCONS
;
ICONIQ:	CALL	BCONS
	OR	A
	JP	Z,NDSKOP
	CALL	BCONI
	JR	IREPEX
;
;	GET IOBYTE
IGETIO:	LD	A,(IOBYTE)
	JR	IREPEX
;
;	SET IOBYTE
ISETIO:	LD	HL,IOBYTE
	LD	(HL),C
	RET
;
;	GET CONSOLE STATUS
ICONST:	CALL	TCIRDY
	JR	IREPEX
;
;	GET VERSION NUMBER
IGVERS:	LD	A,22H
IREPEX:	LD	(IREPLY),A
	RET
;
;	SET PASSWORD
ISETPW:	LD	HL,(IPWORD)
	LD	A,(HL)
	OR	A
	JR	Z,PW3
	PUSH	HL
	LD	B,08H
PW1:	LD	A,(HL)
	CP	21H
	INC	HL
	JR	C,PW4
	DJNZ	PW1
	POP	HL
	LD	DE,PWORD
	PUSH	DE
	LD	C,08H
	LDIR
	POP	HL
PW2:	CALL	PW5
	DEC	C
	JR	NZ,PW2
	LD	A,01H
PW3:	LD	(PSWFLG),A
	XOR	A
	JR	IREPEX
;
PW4:	POP	HL
	LD	A,0FFH
	JR	IREPEX
;
PW5:	PUSH	HL
	PUSH	BC
	LD	B,08H
	OR	A
PW6:	RR	(HL)
	INC	HL
	DJNZ	PW6
	POP	BC
	DEC	HL
	LD	A,(HL)
	RRA
	RRA
	XOR	(HL)
	RRCA
	AND	80H
	POP	HL
	OR	(HL)
	LD	(HL),A
	RET
;
;	SELECT DISC FOR NEXT OPERATION
SELECD:	LD	A,(CURDRV)
	LD	C,A
	CALL	BSELD
	LD	A,H
	OR	L
	RET	Z
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(XLTAD),DE
	INC	HL
	LD	(NOOADB),HL
	INC	HL
	INC	HL
	LD	(LF755),HL
	INC	HL
	INC	HL
	LD	(LF757),HL
	INC	HL
	INC	HL
	LD	DE,DIRBUF
	LD	BC,8
	LDIR
	LD	HL,(DPBAD)
	LD	C,15
	LDIR
	LD	A,0FFH
	OR	A
	RET
;
LEE22:	XOR	A
	LD	HL,(LF755)
	LD	(HL),A
	INC	HL
	LD	(HL),A
	LD	HL,(LF757)
	LD	(HL),A
	INC	HL
	LD	(HL),A
	INC	A
	LD	(LF774),A
;
;	RESTART DIRECTORY ENTRY NUMBER
STRTDI:	LD	HL,-1
	LD	(DIRENO),HL
	RET
;
;	GE THE NEXT DIRECTORY ENTRY IN THE BUFFER
NXTDIE:	LD	HL,(DIRENO)
	INC	HL
	LD	(DIRENO),HL
	EX	DE,HL
	LD	HL,(DPDIR)
	OR	A
	SBC	HL,DE
	JR	NC,NXTDIE1
	CALL	STRTDI
	JR	TSTEDI
;
NXTDIE1:LD	A,(DIRENO)
	AND	03H
	RRCA
	RRCA
	RRCA
	LD	(DIROFF),A
	JR	NZ,TSTEDI
	PUSH	BC
	CALL	CVENTN
	CALL	SETM
	LD	A,(LF774)
	LD	C,A
	CALL	RDSECT
	XOR	A
	LD	(LF774),A
	CALL	RESDMA
	POP	BC
	CALL	SUMDIR
;
;	TEST IF END DIRECTORY REACHED
TSTEDI:	LD	HL,DIRENO
	LD	A,(HL)
	INC	HL
	CP	(HL)
	RET	NZ
	INC	A
	RET
;
LEE7E:	CALL	LEED6
	CALL	LEE87
	CALL	WRSECT
LEE87:	LD	HL,PSWFLG
	INC	(HL)
	DEC	(HL)
	RET	Z
LEE8D:	PUSH	AF
	LD	DE,LF745
	PUSH	DE
	LD	HL,PWORD
	LD	BC,8
	LDIR
	LD	DE,(USRDMA)
	POP	HL
	LD	B,80H
LEEA1:	CALL	PW5
	EX	DE,HL
	XOR	(HL)
	EX	DE,HL
	LD	(DE),A
	INC	DE
	DJNZ	LEEA1
	POP	AF
	RET
;
;	READ A SECTOR
RSECT:	LD	C,0
RDSECT:	CALL	BREAD
	OR	A
	RET	Z
	CALL	DSK_ERR
	JR	Z,RSECT
	RET
;
;	WRITE A SECTOR
WRSECT:	CALL	BWRIT
	OR	A
	RET	Z
	CALL	DSK_ERR
	JR	Z,WRSECT
	RET
;
;	CONVERT DIRECTORY ENTRY NUM TO TRK/SECT
CVENTN:	LD	HL,(DIRENO)
	SRL	H
	RR	L
	SRL	H
	RR	L
	LD	(REQSEC),HL
	LD	(DIRSEC),HL
LEED6:	PUSH	BC
	LD	HL,REQSEC
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	LD	HL,(LF757)
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	HL,(LF755)
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
LEEEA:	LD	A,C
	SUB	E
	LD	A,B
	SBC	D
	JR	NC,LEEFD
	PUSH	HL
	LD	HL,(DPSEC)
	EX	DE,HL
	OR	A
	SBC	HL,DE
	EX	DE,HL
	POP	HL
	DEC	HL
	JR	LEEEA
;
LEEFD:	PUSH	HL
	LD	HL,(DPSEC)
	ADD	HL,DE
	JR	C,LEF0F
	LD	A,C
	SUB	L
	LD	A,B
	SBC	H
	JR	C,LEF0F
	EX	DE,HL
	POP	HL
	INC	HL
	JR	LEEFD
;
LEF0F:	POP	HL
	PUSH	BC
	PUSH	DE
	PUSH	HL
	EX	DE,HL
	LD	HL,(DPSYS)
	ADD	HL,DE
	LD	(REQTRK),HL
	LD	B,H
	LD	C,L
	CALL	BSETT
	POP	DE
	LD	HL,(LF755)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	POP	DE
	LD	HL,(LF757)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	POP	HL
	OR	A
	SBC	HL,DE
	LD	(LF730),HL
	LD	B,H
	LD	C,L
	LD	DE,(XLTAD)
	LD	A,D
	OR	E
	JR	Z,LEF41
	ADD	HL,DE
	LD	C,(HL)
LEF41:	CALL	BSETS
	POP	BC
	RET
;
;	CALCULATE OFFSET IN FCB OF REQD RECORD
CRVTOS:	LD	HL,DPBSH
	LD	C,(HL)
	LD	A,(CURCR)
SRREC:	OR	A
	RRA
	DEC	C
	JR	NZ,SRREC
	LD	B,A
	LD	A,08H
	SUB	(HL)
	LD	C,A
	LD	A,(CUREXT)
LEF5A:	DEC	C
	JR	Z,LEF61
	OR	A
	RLA
	JR	LEF5A
;
LEF61:	ADD	A,B
	LD	B,0
	LD	C,A
	RET
;
;	EXTRACT THE REQD BLOCK NUM FROM THE FCB
GETBLK:	PUSH	IY
	POP	HL
	LD	DE,FBLKS
	ADD	HL,DE
	ADD	HL,BC
	LD	A,(BLKSIZ)
	OR	A
	JR	NZ,BLKWD
	LD	L,(HL)
	LD	H,A
	RET
;
BLKWD:	ADD	HL,BC
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	RET
;
;	GET CURRENT BLOCK NUM FROM FCB
GCURBL:	CALL	CRVTOS
	CALL	GETBLK
	LD	(REQSEC),HL
	LD	A,H
	OR	L
	RET
;
;	CONVERT BLOCK NUM TO INTERNAL SECTOR NUM
CALCSN:	LD	A,(DPBSH)
	LD	HL,(REQSEC)
MKISEC:	ADD	HL,HL
	DEC	A
	JR	NZ,MKISEC
	LD	(BLKSEC),HL
	LD	A,(DPMSK)
	LD	E,A
	LD	A,(CURCR)
	AND	E
	OR	L
	LD	L,A
	LD	(REQSEC),HL
	RET
;
LEFA4:	XOR	A
	LD	(CUREXT),A
	LD	A,(IY+FRC)
	LD	(CURRC),A
	LD	A,(IY+FCR)
	LD	(CURCR),A
	RET
;
;	SHIFT HL RIGHT <A> TIMES
HLSRB:	LD	A,(CURDRV)
	INC	A
HLSR:	DEC	A
	RET	Z
	SRL	H
	RR	L
	JR	HLSR
;
SVECTB:	CALL	SVECTA
	LD	A,C
	OR	(HL)
	LD	(HL),A
	INC	HL
	LD	A,B
	OR	(HL)
	LD	(HL),A
	RET
;
;	SET BIT<CURRENT DRIVE> IN A VECTOR
SVECTA:	LD	BC,1
	LD	A,(CURDRV)
	INC	A
SVECT1:	DEC	A
	RET	Z
	SLA	C
	RL	B
	JR	SVECT1
;
;	TEST IF CURRENT DRIVE IS READ ONLY
TSTROV:	LD	HL,(ROVEC)
	CALL	HLSRB
	BIT	0,L
	RET
;
;	SET DISC READ ONLY
ISETRO:	LD	HL,ROVEC
	CALL	SVECTB
	LD	HL,(DPDIR)
	INC	HL
	EX	DE,HL
	LD	HL,(NOOADB)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	RET
;
;	TEST IF FILE IS READ ONLY
TSTROB:	LD	DE,FTYP
	ADD	HL,DE
	BIT	7,(HL)
	RET	Z
	PUSH	HL
	LD	HL,PTRFL
	CALL	ERR_PTR
	POP	HL
	JP	NZ,REBOOT
	RES	7,(HL)
	RET
;
;	RESET DISC
DOC1:	CALL	TSTROV
	RET	Z
	CALL	SVECTA
	LD	H,B
	LD	L,C
	CALL	RESDSK
	JP	LOGOND
;
;	TEST IF DRIVE IS READ ONLY
CHKWOK:	CALL	TSTROV
	RET	Z
	LD	HL,PTRDL
	CALL	ERR_PTR
	JP	REBOOT
;
;	CALCULATE ADDRESS OF CURRENT DIRECTRY ENTRY
PTOENT:	LD	HL,(DIRBUF)
	LD	A,(DIROFF)
	ADD	A,L
	LD	L,A
	RET	NC
	INC	H
	RET
;
TCBDRV1:CALL	TCBDRV
CLRFS2:	LD	(IY+FS2),0
	RET
;
;	TEST IF DIRECTORY ENTRY OUTSIDE NUM OF ENTRIES ON DISC
TENTNO:	LD	DE,(DIRENO)
	LD	HL,(NOOADB)
	LD	A,E
	SUB	(HL)
	INC	HL
	LD	A,D
	SBC	(HL)
	RET
;
;	INCREASE IF NECESSARY MAX NUM OF ENTRIES ON DISC
UPMAXE:	CALL	TENTNO
	RET	C
	INC	DE
	LD	(HL),D
	DEC	HL
	LD	(HL),E
	RET
;
;	CALCULATE NEW SUM FOR DIRECTORY RECORD
NEWSUM:	LD	C,0FFH
SUMDIR:	LD	HL,(DIRSEC)
	LD	DE,(DPCHK)
	OR	A
	SBC	HL,DE
	RET	NC
	PUSH	BC
	LD	B,128
	LD	HL,(DIRBUF)
	XOR	A
SUMD1:	ADD	A,(HL)
	INC	HL
	DJNZ	SUMD1
	LD	DE,(CSVAD)
	LD	HL,(DIRSEC)
	ADD	HL,DE
	POP	BC
	INC	C
	JR	Z,SETSUM
	CP	(HL)
	RET	Z
	CALL	TENTNO
	RET	NC
	JP	ISETRO
;
SETSUM:	LD	(HL),A
	RET
;
;	RESET ALL OF ENTRY AND WRITE OUT
WRDIRE:	LD	C,00H
	LD	E,20H
UPDENT:	PUSH	DE
	LD	B,00H
	PUSH	IY
	POP	HL
	ADD	HL,BC
	EX	DE,HL
	CALL	PTOENT
	POP	BC
	LD	B,00H
	EX	DE,HL
	LDIR
WRDIBL:	CALL	CVENTN
;
;	WRITE DIRECTORY RECORD AWAY
WRTDIR:	CALL	NEWSUM
	CALL	SETM
	LD	C,01H
	CALL	WRSECT
	JR	RESDMA
;
;	SET DMA ADDRESS
ISETDM:	LD	(USRDMA),DE
RESDMA:	LD	BC,(USRDMA)
	JR	JPSETM
;
SETM:	LD	BC,(DIRBUF)
JPSETM:	JP	BSETM
;
;	GET THE ALLOCATION VECTOR BIT FOR BLOCK <BC>
GALBIT:	LD	A,C
	AND	07H
	INC	A
	LD	E,A
	LD	D,A
	SRL	B
	RR	C
	SRL	B
	RR	C
	SRL	B
	RR	C
	LD	HL,(ALVAD)
	ADD	HL,BC
	LD	A,(HL)
SLALBY:	RLCA
	DEC	E
	JR	NZ,SLALBY
	RET
;
;	SET/RESET ALLOCATION BIT FROM LSB OF <E>
CALBIT:	PUSH	DE
	CALL	GALBIT
	AND	0FEH
	POP	BC
	OR	C
SRALBY:	RRCA
	DEC	D
	JR	NZ,SRALBY
	LD	(HL),A
	RET
;
;	SET ALLOCATION BITS FOR A DIRECTORY ENTRY
SENTAL:	CALL	PTOENT
	LD	DE,FBLKS
	ADD	HL,DE
	PUSH	BC
	LD	C,11H
NXEALB:	POP	DE
	DEC	C
	RET	Z
	PUSH	DE
	LD	A,(BLKSIZ)
	OR	A
	JR	NZ,WDALBN
	PUSH	BC
	LD	C,(HL)
	LD	B,A
	JR	SALBIT
;
WDALBN:	DEC	C
	PUSH	BC
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
SALBIT:	PUSH	HL
	LD	A,C
	OR	B
	JR	Z,FALBN
	LD	HL,(DPSIZ)
	SBC	HL,BC
	CALL	NC,CALBIT
FALBN:	POP	HL
	INC	HL
	POP	BC
	JR	NXEALB
;
;	RESET DISC SYSTEM
IRESET:	XOR	A
	LD	(CURDRV),A
	LD	H,A
	LD	L,A
	LD	(ROVEC),HL
	LD	(LOVEC),HL
	LD	DE,0080H
	CALL	ISETDM
	JR	LOGOND
;
;	SELECT DISC
SELDS:	LD	A,(IPBYTE)
	LD	HL,CURDRV
	CP	(HL)
	RET	Z
;
;	SELECT DISC
ISELDS:	LD	A,(IPBYTE)
	LD	(CURDRV),A
;
;	LOG ON A DISC IF REQUIRED
LOGOND:	LD	HL,(LOVEC)
	CALL	HLSRB
	PUSH	HL
	EX	DE,HL
	CALL	SELECD
	POP	HL
	JP	Z,LEACF
	BIT	0,L
	RET	NZ
	PUSH	AF
	LD	BC,(DPSIZ)
	SRL	B
	RR	C
	SRL	B
	RR	C
	SRL	B
	RR	C
	INC	BC
	LD	HL,(ALVAD)
LOGON1:	LD	(HL),0
	INC	HL
	DEC	BC
	LD	A,B
	OR	C
	JR	NZ,LOGON1
	LD	DE,(DPALL)
	LD	HL,(ALVAD)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	CALL	LEE22
	LD	HL,(NOOADB)
	LD	(HL),03H
	INC	HL
	LD	(HL),0
NDNXTD:	LD	C,0FFH
	CALL	NXTDIE
	JR	Z,SVECT
	CALL	PTOENT
	LD	A,DERAS
	CP	(HL)
	JR	Z,NDNXTD
	LD	A,(CURUSR)
	CP	(HL)
	JR	NZ,NDSETE
	INC	HL
	LD	A,(HL)
	SUB	'$'
	JR	NZ,NDSETE
	DEC	A
	LD	(IREPLY),A
NDSETE:	LD	C,01H
	CALL	SENTAL
	CALL	UPMAXE
	JR	NDNXTD
;
SVECT:	POP	AF
	LD	HL,LOVEC
	JP	SVECTB
;
LF1A5:	SUB	C
	AND	1FH
	RET
;
;	FIND A FILE/EXTENT
FNDFI:	LD	C,0CH
FINDFI:	LD	A,0FFH
	LD	(LF775),A
	LD	HL,LF779
	LD	(HL),C
	LD	(LF738),IY
	CALL	LEE22
GETFIE:	LD	C,0
	CALL	NXTDIE
	JR	Z,FFFAIL
	PUSH	IY
	POP	DE
	LD	A,(DE)
	CP	DERAS
	JR	Z,NORNGC
	PUSH	DE
	CALL	TENTNO
	POP	DE
	JR	NC,FFFAIL
NORNGC:	CALL	PTOENT
	LD	A,(LF779)
	LD	C,A
	LD	B,0
TENTCH:	LD	A,C
	OR	A
	JR	Z,ENTFND
	LD	A,(DE)
	CP	3FH
	JR	Z,FFNXEN
	LD	A,B
	CP	0DH
	JR	Z,FFNXEN
	CP	0CH
	LD	A,(DE)
	JR	Z,EXTTST
	SUB	(HL)
	AND	7FH
	JR	NZ,GETFIE
	JR	FFNXEN
;
;	TEST IS SAME EXTENT
EXTTST:	PUSH	BC
	LD	C,(HL)
	CALL	LF1A5
	POP	BC
	JR	NZ,GETFIE
FFNXEN:	INC	DE
	INC	HL
	INC	B
	DEC	C
	JR	TENTCH
;
;	FOUND MATCHING ENTRY
ENTFND:	LD	A,(DIRENO)
	AND	03H
	LD	(IREPLY),A
	LD	HL,LF775
	LD	A,(HL)
	RLA
	JR	NC,JTSTEDI
	XOR	A
	LD	(HL),A
	JR	JTSTEDI
;
;	FAILED TO FIND ENTRY REQUIRED
FFFAIL:	CALL	STRTDI
	LD	A,H
	LD	(IREPLY),A
JTSTEDI:JP	TSTEDI
;
;	DELETE A SPECIFIED FILE
IDELEF:	CALL	TCBDRV
	CALL	DOC1
	CALL	FNDFI
DELEXT:	JP	Z,RNEXIT
	CALL	PTOENT
	PUSH	HL
	CALL	TSTROB
	POP	HL
	LD	(HL),DERAS
	LD	C,0
	CALL	SENTAL
	CALL	WRTDIR
	CALL	GETFIE
	JR	DELEXT
;
;	FIND A FREE BLOCK FROM THE ALLOCATION VECTOR
FIFREB:	LD	D,B
	LD	E,C
TSCBLN:	LD	A,C
	OR	B
	JR	Z,NXFRAL
	DEC	BC
	PUSH	DE
	PUSH	BC
	CALL	GALBIT
	RRA
	JR	NC,FRALBL
	POP	BC
	POP	DE
NXFRAL:	LD	HL,(DPSIZ)
	LD	A,E
	SUB	L
	LD	A,D
	SBC	H
	JR	NC,TIFULL
	INC	DE
	PUSH	BC
	PUSH	DE
	LD	B,D
	LD	C,E
	CALL	GALBIT
	RRA
	JR	NC,FRALBL
	POP	DE
	POP	BC
	JR	TSCBLN
;
;	FOUND A FREE BLOCK
FRALBL:	RLA
	INC	A
	CALL	SRALBY
	POP	HL
	POP	DE
	RET
;
;	TEST WHETHER DISC IS FULL
TIFULL:	LD	A,C
	OR	B
	JR	NZ,TSCBLN
	LD	H,A
	LD	L,A
	RET
;
RNFILE:	CALL	DOC1
	CALL	FNDFI
	LD	A,(IY+FDRV)
	LD	(IY+10H),A
	RET	Z
RENEXT:	CALL	PTOENT
	CALL	TSTROB
	LD	C,10H
	LD	E,FEXT
	CALL	UPDENT
	CALL	GETFIE
	JR	NZ,RENEXT
	RET
;
;	SET ATTRIBUTES OF FILE
ISETAT:	CALL	TCBDRV
	CALL	FNDFI
STBEXT:	JP	Z,RNEXIT
	LD	C,0
	LD	E,0CH
	CALL	UPDENT
	CALL	GETFIE
	JR	STBEXT
;
;	OPEN REQUESTED FILE
IOPENF:	CALL	TCBDRV1
OPFILE:	LD	C,0FH
	CALL	FINDFI
	RET	Z
OPFEXT:	LD	A,(IY+0CH)
	PUSH	AF
	CALL	PTOENT
	PUSH	IY
	POP	DE
	LD	BC,0020H
	PUSH	HL
	LDIR
	CALL	MAKE1
	POP	IX
	LD	C,(IX+0CH)
	LD	B,(IX+FRC)
	POP	AF
	LD	(IY+0CH),A
	CP	C
	LD	A,B
	JR	Z,FULEXT
	LD	A,0
	JR	NC,FULEXT
	LD	A,128
FULEXT:	LD	(IY+FRC),A
	RET
;
RSTDFE:	LD	A,(HL)
	INC	HL
	OR	(HL)
	DEC	HL
	RET	NZ
	LD	A,(DE)
	LD	(HL),A
	INC	DE
	INC	HL
	LD	A,(DE)
	LD	(HL),A
	DEC	DE
	DEC	HL
	RET
;
;	CLOSE FILE
ICLOSF:	CALL	TCBDRV
;
;	CLOSE FILE
CLFILE:	XOR	A
	LD	(IREPLY),A
	LD	(DIRENO),A
	LD	(DIRENO+1),A
	CALL	TSTROV
	RET	NZ
	LD	A,(IY+FS2)
	AND	80H
	RET	NZ
	LD	C,0FH
	CALL	FINDFI
	RET	Z
	LD	BC,FBLKS
	CALL	PTOENT
	ADD	HL,BC
	EX	DE,HL
	PUSH	IY
	POP	HL
	ADD	HL,BC
;
CLNXTE:	LD	A,(BLKSIZ)
	OR	A
	JR	NZ,CLTSEQ
	LD	A,(HL)
	OR	A
	LD	A,(DE)
	JR	NZ,CLTSCB
	LD	(HL),A
CLTSCB:	OR	A
	JR	NZ,CLTSDN
	LD	A,(HL)
	LD	(DE),A
CLTSDN:	CP	(HL)
	JR	NZ,CLFAIL
	JR	CLUPDE
;
;	CHECK WORD BLOCK NUM
CLTSEQ:	CALL	RSTDFE
	EX	DE,HL
	CALL	RSTDFE
	EX	DE,HL
	LD	A,(DE)
	CP	(HL)
	JR	NZ,CLFAIL
	INC	DE
	INC	HL
	LD	A,(DE)
	CP	(HL)
	JR	NZ,CLFAIL
	DEC	C
CLUPDE:	INC	DE
	INC	HL
	DEC	C
	JR	NZ,CLNXTE
	LD	BC,-32+FEXT
	ADD	HL,BC
	EX	DE,HL
	ADD	HL,BC
	LD	A,(DE)
	CP	(HL)
	JR	C,CLFINI
	LD	(HL),A
	LD	BC,FRC-FEXT
	ADD	HL,BC
	EX	DE,HL
	ADD	HL,BC
	LD	A,(HL)
	LD	(DE),A
CLFINI:	LD	A,0FFH
	LD	(CLFLG),A
	JP	WRDIBL
;
CLFAIL:	LD	HL,IREPLY
	DEC	(HL)
	RET
;
;	MAKE FILE
IMAKEF:	CALL	TCBDRV1
MKFILE:	CALL	DOC1
	PUSH	IY
	POP	HL
	PUSH	HL
	LD	B,(HL)
	PUSH	BC
	LD	(HL),DERAS
	LD	C,01H
	CALL	FINDFI
	POP	BC
	POP	HL
	LD	(HL),B
	RET	Z
	LD	BC,FRC
	ADD	HL,BC
	LD	C,11H
	XOR	A
MKCLRE:	LD	(HL),A
	INC	HL
	DEC	C
	JR	NZ,MKCLRE
	LD	(IY+0DH),A
	CALL	UPMAXE
	CALL	WRDIRE
MAKE1:	SET	7,(IY+FS2)
	RET
;
;	OPEN NEXT EXTENT OF FILE
OPNXEX:	XOR	A
	LD	(CLFLG),A
	CALL	CLFILE
	CALL	TSTEDI
	RET	Z
	LD	A,(IY+0CH)
	INC	A
	AND	1FH
	LD	(IY+0CH),A
	JR	NZ,FNXTEX
	INC	(IY+FS2)
	LD	A,(IY+FS2)
	AND	0FH
	JR	Z,FNEXFL
FNXTEX:	LD	C,0FH
	CALL	FINDFI
	JR	NZ,EXTFND
	LD	A,(LF773)
	INC	A
	JR	Z,FNEXFL
	CALL	MKFILE
	CALL	TSTEDI
	JR	Z,FNEXFL
	JR	FINEXT
;
;	FOUND REQUIRED EXTENT
EXTFND:	CALL	OPFEXT
FINEXT:	CALL	LEFA4
	XOR	A
	JP	IREPEX
;
;	FAILED TO OPEN EXTENT
FNEXFL:	CALL	RDFAIL
	JP	MAKE1
;
;	READ RANDOM RECORD
IRDRAN:	CALL	TCBDRV
	LD	C,0FFH
	XOR	A
	CALL	RANSET
	RET	NZ
	JR	RDSQRA
;
;	READ SEQUENTIAL
IRDSEQ:	CALL	TCBDRV
	LD	A,01H
	LD	(LF776),A
RDSQRA:	LD	A,0FFH
	LD	(LF773),A
	CALL	LEFA4
	LD	HL,CURRC
	CP	(HL)
	JR	C,RDEXSE
	CP	80H
	JR	NZ,RDFAIL
	CALL	OPNXEX
	XOR	A
	LD	(CURCR),A
	LD	A,(IREPLY)
	OR	A
	JR	NZ,RDFAIL
RDEXSE:	CALL	GCURBL
	JR	Z,RDFAIL
	CALL	CALCSN
	CALL	LEED6
	CALL	RSECT
	CALL	LEE87
	JP	FINWR
;
;	FAILED TO READ
RDFAIL:
;	FAILED TO WRITE
MAXWR:	LD	A,01H
	JP	IREPEX
;
;	WRITE RANDOM RECORD
IWRRAN:	CALL	TCBDRV
	XOR	A
	JR	WRRAND
;
;	WRITE RANDOM WITH ZERO FILL
IWRRAZ:	CALL	TCBDRV
	LD	A,02H
WRRAND:	LD	C,0
	CALL	RANSET
	RET	NZ
	JR	LF449
;
;	WRITE SEQUENTIAL
IWRSEQ:	CALL	TCBDRV
	LD	A,01H
	LD	(LF776),A
LF449:	XOR	A
	LD	(LF773),A
	CALL	CHKWOK
	PUSH	IY
	POP	HL
	CALL	TSTROB
	CALL	LEFA4
	CP	80H
	JR	NC,MAXWR
	CALL	GCURBL
	LD	C,0
	JR	NZ,WRREC
	CALL	CRVTOS
	LD	(LASTDN),A
	OR	A
	JR	Z,FINDNW
	DEC	BC
	CALL	GETBLK
	LD	B,H
	LD	C,L
FINDNW:	CALL	FIFREB
	LD	A,H
	OR	L
	JR	NZ,SETNW
	LD	A,02H
	JP	IREPEX
;
SETNW:	LD	(REQSEC),HL
	EX	DE,HL
	PUSH	IY
	POP	HL
	LD	BC,FBLKS
	ADD	HL,BC
	LD	A,(LASTDN)
	LD	C,A
	ADD	HL,BC
	LD	A,(BLKSIZ)
	OR	A
	JR	NZ,LF498
	LD	(HL),E
	JR	LF49C
;
LF498:	ADD	HL,BC
	LD	(HL),E
	INC	HL
	LD	(HL),D
LF49C:	LD	C,02H
WRREC:	LD	A,(IREPLY)
	OR	A
	RET	NZ
	CALL	CALCSN
	PUSH	BC
	LD	A,(LF776)
	CP	02H
	JR	NZ,WROUTS
	CP	C
	JR	NZ,WROUTS
	PUSH	HL
	LD	HL,(DIRBUF)
	LD	B,80H
LF4B7:	LD	(HL),A
	INC	HL
	DJNZ	LF4B7
	CALL	SETM
	LD	HL,(BLKSEC)
	LD	C,02H
WRZERO:	LD	(REQSEC),HL
	PUSH	HL
	CALL	LEE7E
	POP	HL
	LD	C,0
	LD	A,(DPMSK)
	LD	B,A
	AND	L
	CP	B
	INC	HL
	JR	NZ,WRZERO
	POP	HL
	LD	(REQSEC),HL
	CALL	RESDMA
 	POP	BC
 	PUSH	BC
WROUTS: CALL	LEE7E
 	POP	BC
 	LD	A,(CURCR)
 	LD	HL,CURRC
	CP	(HL)
	JR	C,TSETWR
	LD	(HL),A
	INC	(HL)
	LD	C,02H
TSETWR:	RES	7,(IY+FS2)
	CP	7FH
	JR	NZ,FINWR
	LD	A,(LF776)
	CP	01H
	JR	NZ,LF515
	CALL	FINWR
	CALL	OPNXEX
	LD	HL,IREPLY
	LD	A,(HL)
	OR	A
	JR	NZ,LF510
	DEC	A
	LD	(CURCR),A
LF510:	LD	(HL),0
FINWR:	LD	A,(LF776)
LF515:	CP	02H
	JR	NZ,LF51A
	XOR	A
LF51A:	LD	C,A
	LD	A,(CURCR)
	ADD	A,C
	LD	(IY+FCR),A
	LD	A,(CURRC)
	LD	(IY+FRC),A
	RET
;
RANSET:	LD	(LF776),A
	PUSH	BC
	LD	A,(IY+21H)
	LD	B,A
	AND	7FH
	PUSH	AF
	LD	A,B
	RLA
	LD	A,(IY+22H)
	LD	B,A
	RLA
	AND	1FH
	LD	C,A
	LD	A,B
	RRA
	RRA
	RRA
	RRA
	AND	0FH
	LD	B,A
	POP	AF
	LD	L,(IY+23H)
	INC	L
	DEC	L
	LD	L,06H
	JR	NZ,RAFAIL
	LD	(IY+FCR),A
	LD	A,C
	SUB	(IY+0CH)
	JR	NZ,RAXTOK
	LD	A,B
	SUB	(IY+FS2)
	AND	7FH
	JR	Z,RAOPOK
RAXTOK:	PUSH	BC
	CALL	CLFILE
	POP	BC
	LD	L,03H
	LD	A,(IREPLY)
	INC	A
	JR	Z,RAEXTF
	LD	(IY+0CH),C
	LD	(IY+FS2),B
	CALL	OPFILE
	LD	A,(IREPLY)
	INC	A
	JR	NZ,RAOPOK
	POP	BC
	PUSH	BC
	LD	L,04H
	INC	C
	JR	Z,RAEXTF
	CALL	MKFILE
	LD	L,05H
	LD	A,(IREPLY)
	INC	A
	JR	Z,RAEXTF
RAOPOK:	POP	BC
	XOR	A
	JP	IREPEX
;
;	FAILED RANDOM SET
RAEXTF:	DEFB	0FDH,36H,0EH,0C0H
;LD	(IY+FS2),0C0H	;OMMITTED - ASSEMBLER ERROR
RAFAIL:	POP	BC
	LD	A,L
	LD	(IREPLY),A
	OR	A
	JP	MAKE1
;
;	CALCULATE RANDOM RECORD FROM EXT/RC/S2
CALCRA:	EX	DE,HL
	ADD	HL,DE
	LD	C,(HL)
	LD	B,0
	LD	HL,FEXT
	ADD	HL,DE
	LD	A,(HL)
	RRCA
	AND	80H
	ADD	A,C
	LD	C,A
	LD	A,0
	ADC	B
	LD	B,A
	LD	A,(HL)
	RRCA
	AND	0FH
	ADD	A,B
	LD	B,A
	LD	HL,FS2
	ADD	HL,DE
	LD	A,(HL)
	ADD	A,A
	ADD	A,A
	ADD	A,A
	ADD	A,A
	PUSH	AF
	ADD	A,B
	LD	B,A
	PUSH	AF
	POP	HL
	LD	A,L
	POP	HL
	OR	L
	AND	01H
	PUSH	IY
	POP	HL
	LD	DE,FRRC
	ADD	HL,DE
	RET
;
;	FIND SIZE OF FILE
IFILSZ:	CALL	TCBDRV
	CALL	FNDFI
	PUSH	IY
	POP	HL
	LD	DE,FRRC
	ADD	HL,DE
	LD	(HL),0
	INC	HL
	LD	(HL),0
	INC	HL
	LD	(HL),0
NXTSIZ:	RET	Z
	CALL	PTOENT
	LD	DE,FRC
	CALL	CALCRA
	LD	E,A
	LD	A,C
	SUB	(HL)
	INC	HL
	LD	A,B
	SBC	(HL)
	INC	HL
	LD	A,E
	SBC	(HL)
	JR	C,UPSIZ
	LD	(HL),E
	DEC	HL
	LD	(HL),B
	DEC	HL
	LD	(HL),C
UPSIZ:	CALL	GETFIE
	JR	NXTSIZ
;
;	SET RANDOM RECORD
ISETRA:	CALL	TCBDRV
	PUSH	IY
	POP	HL
	LD	DE,FCR
	CALL	CALCRA
	LD	(HL),C
	INC	HL
	LD	(HL),B
	INC	HL
	LD	(HL),A
	RET
;
;	SET UP DRIVE
TCBDRV:	LD	A,0FFH
	LD	(LF77A),A
	PUSH	IY
	POP	HL
	LD	A,(HL)
	AND	1FH
	DEC	A
	LD	(IPBYTE),A
	CP	1EH
	JR	NC,SCBUSR
	LD	A,(CURDRV)
	LD	(LF77B),A
	LD	A,(HL)
	LD	(DEFFLG),A
	AND	0E0H
	LD	(HL),A
	PUSH	HL
	CALL	SELDS
	POP	HL
SCBUSR:	LD	A,(CURUSR)
	OR	(HL)
	LD	(HL),A
	RET
;
;	SEARCH FOR FIRST DIRECTORY ENTRY
ISFIRS:	LD	C,0
	LD	A,(DE)
	CP	'?'
	JR	Z,ANYUSR
	LD	A,(IY+0CH)
	CP	'?'
	CALL	NZ,CLRFS2
	CALL	TCBDRV
	LD	C,0FH
ANYUSR:	CALL	FINDFI
	JR	MOVDIR
;
;	SEARCH FOR NEXT DIRECTRY ENTRY
ISNEXT:	LD	IY,(LF738)
	CALL	TCBDRV
	CALL	GETFIE
;
;	MOVE DIRECTORY ENTRY TO USER DMA BUFFER
MOVDIR:	LD	HL,(DIRBUF)
	LD	DE,(USRDMA)
	LD	BC,0080H
	LDIR
	RET
;
;	RENAME FILE
IRENAF:	CALL	TCBDRV
	CALL	RNFILE
RNEXIT:	LD	A,(LF775)
	JP	IREPEX
;
;	GET LOGON VECTOR
IGLONV:	LD	HL,(LOVEC)
	JR	IWDREP
;
;	GET CURRENT DISC
IGCDSK:	LD	A,(CURDRV)
	JP	IREPEX
;
;	GET ALLOCATION VECTOR
IGALOV:	LD	HL,(ALVAD)
	JR	IWDREP
;
;	GET READ ONLY VECTOR
IGRODV:	LD	HL,(ROVEC)
	JR	IWDREP
;
;	GET DISC PARAMETER AREA ADDRESS
IGDPAD:	LD	HL,(DPBAD)
IWDREP:	LD	(IREPLY),HL
	RET
;
;	GET/SET USER CODE
IGSUSR:	LD	A,(IPBYTE)
	CP	0FFH
	JR	NZ,STUSER
	LD	A,(CURUSR)
	JP	IREPEX
;
STUSER:	AND	1FH
	LD	(CURUSR),A
	RET
;
;	RESET DISC
IRESDS:	LD	HL,(IPWORD)
RESDSK:	LD	A,L
	CPL
	LD	E,A
	LD	A,H
	CPL
	LD	HL,(LOVEC)
	AND	H
	LD	D,A
	LD	A,L
	AND	E
	LD	E,A
	LD	HL,(ROVEC)
	EX	DE,HL
	LD	(LOVEC),HL
	LD	A,L
	AND	E
	LD	L,A
	LD	A,H
	AND	D
	LD	H,A
	LD	(ROVEC),HL
	RET
;
XPOINT:	LD	A,(LF77A)
	OR	A
	JR	Z,NDSKOP
	LD	(IY+FDRV),0
	LD	A,(DEFFLG)
	OR	A
	JR	Z,NDSKOP
	LD	(IY+FDRV),A
	LD	A,(LF77B)
	LD	(IPBYTE),A
	CALL	SELDS
NDSKOP:	LD	IX,(IXSAVE)
	LD	IY,(IYSAVE)
	LD	HL,(IREPLY)
	LD	A,L
	LD	B,H
	RET
;
	DEFS	48
OWNSTK	EQU	$
CURUSR:	DEFB	0
CURDRV:	DEFB	0
REQTRK:	DEFW	0
LF730:	DEFW	0
LSTPOS:	DEFB	0
LCUPOS:	DEFB	0
FLDEOP:	DEFB	0
