;**********************************************************************
;*******		EINSTEIN XDOS 2.02 BIOS			*******
;*******	R H0HNE				26-JAN-87	*******
;******* DEC-2006   MINOR CORRECTIONS                           *******
;**********************************************************************
;LE100	EQU	0E100H		;START ADDRESS OF LOAD
LE200	EQU	0E200H
LE203	EQU	0E203H
;LE206	EQU	0E206H
LF982	EQU	0F982H
;
;
LBIOS	EQU	0F800H
	ORG	LBIOS
;
BCOLD:	JP	BICOLD		;JUMP TO COLD START   
BWARM:	JP	BIWARM		;JUMP TO WARM START   
BCONS:	JP	BICONS		;CONSOLE STATUS       
BCONI:	JP	BICONI		;CONSOLE INPUT        
BCONO:	JP	BICONO		;CONSOLE OUTPUT       
BLSTO:	JP	BILSTO		;PRINTER OUTPUT       
BPUNO:	JP	BIPUNO		;SERIAL OUTPUT        
BPUNI:	JP	BIPUNI		;SERIAL INPUT         
BHOME:	JP	BIHOME		;RESET DRIVE TO 0,0,0 
BSELD:	JP	BISELD		;SELECT DRIVE         
BSETT:	JP	BISETT		;SET TRACK            
BSETS:	JP	BISETS		;SET SECTOR           
BSETM:	JP	BISETM		;SET BUFFER           
BREAD:	JP	BIREAD		;READ 128-BYTE SECTOR 
BWRIT:	JP	BIWRIT		;WRITE 128-BYTE SECTOR
BLSTS:	JP	LF878
;
BINIT:	DEFB	MCAL,ZINIT	;INITIALISE SYSTEM
	RET
;
LF833:	POP	HL		;GET ADDRESS AFTER CALL
	LD	A,(IOBYTE)	;GET IOBYTE
	JR	LF841
;
LF839:	POP	HL		;GET ADDRESS AFTER CALL
	LD	A,(IOBYTE)	;GET IOBYTE
LF83D:	RRCA			;CALCULATE OFFSET
	RRCA
	DJNZ	LF83D
LF841:	AND	03H		;LIMIT TO 3
	ADD	A,L		;ADD OFFSET TO ADDRESS
	LD	L,A		;AMMEND PTR
	LD	L,(HL)		;GET LOW ORDER ADDRESS OF JUMP
	LD	A,C		;GET INPUT PARAMETER
	JP	(HL)

;	
;	IOBYTE DEFINITION
;	Bits	Ref to	Values	00	01	10	11
;	6&7	CON:		AUX:	CRT:	BAT:	UC1:
;	4&5	RDR:		AUX:	PTR:	UR1:	UR2:
;	2&3	PUN:		AUX:	PTP:	UP1:	UP2:
;	0&1	LST:		AUX:	CRT:	LPT:	UL1:
;
BICONO:	CALL	LF833		;REDIRECT ACCORDING TO BITS 0&1
	DEFB	0A5H,09DH,06FH,0BBH
;
BICONI:	CALL	LF833		;REDIRECT ACCORDING TO BITS 0&1
	DEFB	0A9H,09AH,015H,0B8H
;
BICONS:	CALL	LF833		;REDIRECT ACCORDING TO BITS 0&1
	DEFB	098H,081H,098H,0BEH
;
BIPUNI:	LD	B,01H
	CALL	LF839		;REDIRECT ACCORDING TO BITS 2&3
	DEFB	0A9H,09AH,0B2H,0B5H
;
BIPUNO:	LD	B,02H
	CALL	LF839		;REDIRECT ACCORDING TO BITS 4&5
	DEFB	0A5H,09DH,0ACH,0AFH
;
BATOUT	EQU	$
BATST	EQU	BATOUT
BILSTO:	LD	B,03H
	CALL	LF839		;REDIRECT ACCORDING TO BITS 6&7
	DEFB	0A5H,09DH,0A1H,0ACH
;
LF878:	LD	B,03H
	CALL	LF839		;REDIRECT ACCORDING TO BITS 6&7
	DEFB	98H,95H,98H,98H
;
CRTST:	LD	A,(PCFLGS)
	BIT	COL80,A
	JR	Z,CRTST1	;J IF NOT 80 COL
	LD	A,0AH
	OUT	(RG6845),A
	LD	A,60H
	OUT	(DT6845),A
	DEFB	MCAL,ZSCURS 
CRTST1:	DEFB	MCAL,ZRSCAN 
	RET	Z
	LD	A,0FFH
	RET
;
AUXST:	XOR	A		;SET STATUS OF RS232
	RET
;
CRTIN	EQU	$
PTP:	DEFB	MCAL,ZKEYIN	;GET KEY VALUE
	RET
;
CRTOUT:	LD	A,C
	DEFB	MCAL,ZOUTC 	;SCREEN O/P
	RET
;
LPT:	LD	A,C
	DEFB	MCAL,ZPOUT	;PRINTER O/P 
	RET
;
AUXOUT:	LD	A,C                          
	DEFB	MCAL,ZSLOUT	;SERIAL O/P
	RET
;
AUXIN:	DEFB	MCAL,ZSRLIN	;SERIAL INPUT
	RET
;
UL1	EQU	$
UP1:	JP	AUXOUT
UP2:	JP	AUXOUT
UR1:	JP	AUXIN
UR2:	JP	AUXIN
UC1IN:	JP	CRTIN
UC1OUT:	JP	CRTOUT
UC1ST:	JP	CRTST
;
BISELD:	DEFB	MCAL,ZSLDSC	;SELECT DRIVE 
	RET
;
BIHOME:	LD	C,00H
	DEFB	MCAL,ZSETRK	;SET TRACK
BISETS:	DEFB	MCAL,ZSETSC	;SET SECTOR
	RET
;
BISETT:	DEFB	MCAL,ZSETRK	;SET TRACK
	RET
;
BISETM:	DEFB	MCAL,ZSETBF	;SET BUFFER
	RET
;
BIREAD:	DEFB	MCAL,ZRD128	;READ A RECORD
	RET

BIWRIT:	DEFB	MCAL,ZWR128	;WRITE A RECORD
	RET
;
BICOLD:	LD	SP,TPA		;SET SP UNDER TPA
	LD	DE,0000H
	LD	(LFB86),DE	;CLEAR HOST ACTIVE FLAG
	LD	HL,LF95E	;SET UP INITAIL PARAMETERS
	LD	BC,0008H
	LDIR
	LD	HL,LF982
	LD	A,(DTYPE)	;GET DRIVE TYPES
	LD	B,04H
COLD1:	RRA
	LD	DE,PSS40	;PT TO SINGLE 40 TRACK
	JR	NC,COLD2	;J IF B0 NOT SET
	LD	DE,PDS40	;PT TO DOUBLE 40 TRACK
COLD2:	BIT	3,A		;DOUBLE SIDED?
	JR	Z,COLD4		;J IF NOT
	PUSH	AF
	LD	A,1EH		;ADJUST PTR FOR 80 TRACK
	ADD	A,E
	LD	E,A
	JR	NC,COLD3
	INC	D
COLD3:	POP	AF
COLD4:	LD	(HL),E
	INC	HL
	LD	(HL),D
	DEC	HL
	LD	DE,0010H
	ADD	HL,DE
	DJNZ	COLD1
	CALL	LF9F4
	XOR	A
	LD	HL,LE200
WARM2:	LD	C,A
	PUSH	HL
	LD	HL,LE206
	LD	A,(WIDTH)	;GET SCREEN WIDTH
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	LD	(HL),A
	DEC	HL
	LD	A,22H
	CP	(HL)
	JR	NZ,LF966
	LD	HL,LF978
	LD	(DBPPTR),HL
	LD	HL,RAMSEC	;SET HSTDMA
	LD	(HSTDMA),HL
	LD	HL,0000H	;CLEAR BREAK VECTOR
	LD	(BRKVCT),HL
	RET
;
BIWARM:	LD	SP,TPA
	LD	HL,LE100	;REINSTALL CCP & DOS
	LD	DE,LBIOS
	XOR	A
	LD	BC,0000H
	DEFB	MCAL,ZRBLK 
	LD	HL,DEFDRV	;CHECK FOR VALID DISC AND USER=0
	LD	A,(HL)
	CP	04H
	JR	C,WARM1
	XOR	A		;SET TO USER=0,DISC=0
	LD	(HL),A
WARM1:	LD	HL,LE203	;PT TO
	JR	WARM2
;
;LOAD 0000 TO 0007
LF95E:	JP	BWARM		;DEFB	0C3H,003H,0F8H
	DEFB	81H,00H		;SET INITIAL IOBYTE TO 81H
	JP	LDOS		;DEFB	0C3H,000H,0EAH
;
LF966:	DEFB	MCAL,ZPRM	;DEFM
	DEFB	'BOOT ERROR',CR,LF
	DEFB	87H		;BEEP
	OUT	(24H),A		;SELECT ROM
	RST	00H		;AND REBOOT
;
;DISK PARAMETER HEADER FOR DISK 00
LF978:	DEFB	000H,000H,000H,000H
LF97C:	DEFB	000H,000H,000H,000H
LF980:	DEFB	000H,0FDH,0B8H,0F9H
LF984:	DEFB	080H,0FDH,0C0H,0FDH
;
;DISK PARAMETER HEADER FOR DISK 01
LF988:	DEFB	000H,000H,000H,000H
LF98C:	DEFB	000H,000H,000H,000H
LF990:	DEFB	000H,0FDH,0B8H,0F9H
LF994:	DEFB	090H,0FDH,01FH,0FAH
;
;DISK PARAMETER HEADER FOR DISK 02
LF998:	DEFB	000H,000H,000H,000H
LF99C:	DEFB	000H,000H,000H,000H
LF9A0:	DEFB	000H,0FDH,0B8H,0F9H
LF9A4:	DEFB	0A0H,0FDH,051H,0FAH
;
;DISK PARAMETER HEADER FOR DISK 03
LF9A8:	DEFB	000H,000H,000H,000H
LF9AC:	DEFB	000H,000H,000H,000H
LF9B0:	DEFB	000H,0FDH,0B8H,0F9H
LF9B4:	DEFB	0B0H,0FDH,083H,0FAH
;
;DISK PARAMETER BLOCK TABLE
;	SINGLE SIDED 40 TRACK
PSS40:	DEFB	028H,000H,004H,00FH
	DEFB	001H,05EH,000H,03FH
	DEFB	000H,080H,000H,010H
	DEFB	000H,002H,000H
;	DOUBLE SIDED 40 TRACK
PDS40:	DEFB	050H,000H,004H,00FH
	DEFB	001H,0C2H,000H,07FH
	DEFB	000H,0C0H,000H,010H
	DEFB	000H,001H,000H
;	SINGLE SIDED 80 TRACK
LF9D6:	DEFB	028H,000H,004H,00FH
	DEFB	001H,0C2H,000H,07FH
	DEFB	000H,0C0H,000H,010H
	DEFB	000H,002H,000H
;	DOUBLE SIDED 80 TRACK
LF9E5:	DEFB	050H,000H,004H,00FH
	DEFB	001H,08AH,001H,07FH
	DEFB	000H,0C0H,000H,010H
	DEFB	000H,001H,000H
;
LF9F4:	DEFB	MCAL,ZLOGO 
	DEFB	MCAL,ZPRM	;DEFM
	DEFB	CR,LF,'XtalDOS'
	DEFB	' 2.02        (C) '
	DC	'Xtal 1983-86'
	RET
;
;DEFT
LFA1F:	DEFB	080H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H,000H,000H
	DEFB	000H,000H
LFAFD:	DEFB	04CH,04BH,07CH
